---
// /dash —— 量化工作台（实时版）
// 零 Python / 零预生成 JSON：全部行情走 serverless 代理（/api/stock、/api/indices、
// /api/stock-minute、/api/stock-search），前端实时拉取并前端聚合周/月/年周期与量化指标。
// 自选清单存浏览器 localStorage（默认种子见 WatchList 的 SEED）。
import ChartPanel from '@/components/dash/ChartPanel.astro'
import MarketStrip from '@/components/dash/MarketStrip.astro'
import PipelineBar from '@/components/dash/PipelineBar.astro'
import SidePanels from '@/components/dash/SidePanels.astro'
import WatchList from '@/components/dash/WatchList.astro'
import DashLayout from '@/layouts/DashLayout.astro'

const title = '量化工作台'
const desc = '实时量化复盘工作台：指数行情带、自选异动、六周期K线（分时/五日/日/周/月/年）与 52周位置、量比、波动率、估值画像。数据实时来自腾讯行情（serverless 代理），零服务器、零预生成。'
---

<DashLayout meta={{ title, description: desc }}>
  <div class='qd-head'>
    <h1 class='qd-title'>{title}</h1>
    <span class='qd-tag'>实时复盘 · 腾讯行情（serverless 代理）</span>
  </div>

  <MarketStrip />

  <div class='qd-grid'>
    <WatchList />
    <ChartPanel initialCode='600519' />
    <SidePanels />
  </div>

  <PipelineBar />

  <p class='qd-note'>
    数据链路：浏览器 → <code>/api/stock</code>（腾讯行情 serverless 代理）→ 实时报价 + 250 日 K线；
    周/月/年周期与 52 周位置、量能、波动率等量化指标均由前端基于日线真实计算。
    分时/五日走 <code>/api/stock-minute</code>，指数走 <code>/api/indices</code>，搜索走 <code>/api/stock-search</code>。
    自选清单存于本机浏览器（localStorage），可随时搜索加删。K线为未复权价。
    指标口径与研究文章见 <a href='/quant-column'>量化专栏</a>。
  </p>
</DashLayout>

<style is:global>
  /* 本站浅色主题本身就是深色底（app.css :root 即暗色），红涨绿跌直接用提亮档保证 ≥4.5:1 */
  :root {
    --qk-up: #ef5f5f;
    --qk-down: #2fb87e;
    --qk-gold: hsl(var(--primary, 45 68% 51%));
  }
  html.dark {
    --qk-up: #f16a6a;
    --qk-down: #3fba85;
  }
  .qd-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin: 2px 2px 12px;
  }
  .qd-title {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    color: hsl(var(--foreground));
  }
  .qd-tag {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }
  .qd-grid {
    display: grid;
    /* 两侧栏随视口平滑伸缩，中间图表列吃掉全部剩余宽度 */
    grid-template-columns: clamp(216px, 16vw, 272px) minmax(0, 1fr) clamp(264px, 20vw, 344px);
    gap: 16px;
    align-items: start;
  }
  @media (max-width: 1024px) {
    .qd-grid { grid-template-columns: 200px minmax(0, 1fr) 256px; gap: 12px; }
  }
  @media (max-width: 900px) {
    .qd-grid { grid-template-columns: 1fr; gap: 12px; }
  }
  .qd-note {
    margin-top: 14px;
    max-width: 46em; /* 中文一行 ≈40 字，避免超宽屏一行拉太长 */
    font-size: 12px;
    color: color-mix(in srgb, hsl(var(--muted-foreground)) 48%, hsl(var(--foreground)));
    line-height: 1.9;
  }
  .qd-note code {
    background: hsl(var(--muted));
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 12px;
  }
  .qd-note a { color: var(--qk-gold); }
  /* 键盘导航必须看得见焦点 */
  .qd-grid :focus-visible,
  .qd-pipe :focus-visible,
  .qd-keys :focus-visible {
    outline: 2px solid var(--qk-gold);
    outline-offset: 2px;
    border-radius: 6px;
  }
</style>
