---
// /dash —— 量化工作台（设计稿 docs/quant-dash-design.md 定稿版）
// 构建期读取发布产物（public/data/…）预渲染首屏；交互期走 /api/stock-minute。
// 加自选：platform/codes.txt -> qplat daily -> git push。
import { existsSync, readFileSync } from 'node:fs'
import path from 'node:path'

import ChartPanel from '@/components/dash/ChartPanel.astro'
import MarketStrip from '@/components/dash/MarketStrip.astro'
import PipelineBar from '@/components/dash/PipelineBar.astro'
import SidePanels from '@/components/dash/SidePanels.astro'
import WatchList from '@/components/dash/WatchList.astro'
import DashLayout from '@/layouts/DashLayout.astro'

const pub = (rel: string) => {
  const p = path.join(process.cwd(), 'public', 'data', rel)
  if (!existsSync(p)) return null
  try {
    return JSON.parse(readFileSync(p, 'utf8'))
  } catch {
    return null
  }
}

const idx = pub('index/daily.json')
const wl = pub('watchlist.json')
const items: any[] = wl?.items ?? []
const activeCode = items.length ? items[0].code : '600519'
const initialPayload = pub(`kline/${activeCode}.json`)

const title = '量化工作台'
const desc = '每日复盘工作台：指数行情带、自选异动、六周期K线（分时/五日/日/周/月/年）与 52周位置、量比、波动率、估值分位画像。数据来自本地量化数据湖（baostock），零服务器运行。'
---

<DashLayout meta={{ title, description: desc }}>
  <div class='qd-head'>
    <h1 class='qd-title'>{title}</h1>
    <span class='qd-tag'>每日复盘 · 本地量化数据湖（baostock）</span>
  </div>

  <MarketStrip items={idx?.items ?? []} updatedAt={idx?.updatedAt} />

  <div class='qd-grid'>
    <WatchList items={items} active={activeCode} />
    <ChartPanel initialCode={activeCode} />
    <SidePanels payload={initialPayload} />
  </div>

  <PipelineBar />

  <p class='qd-note'>
    数据链路：<code>baostock</code> 日线（每日 17:10 本地入库）→ 发布 <code>public/data/*.json</code>
    → 本页面静态渲染；分时/五日走 Vercel Serverless 代理腾讯分钟行情。K线为未复权价。
    指标口径与研究文章见 <a href='/quant-column'>量化专栏</a>。
  </p>
</DashLayout>

<style is:global>
  :root {
    --qk-up: #e64545;
    --qk-down: #1aa16a;
    --qk-gold: hsl(var(--primary, 45 68% 51%));
  }
  html.dark {
    --qk-up: #f16a6a;
    --qk-down: #3fba85;
  }
  .qd-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin: 2px 2px 12px;
  }
  .qd-title {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    color: hsl(var(--foreground));
  }
  .qd-tag {
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }
  .qd-grid {
    display: grid;
    /* 两侧栏随视口平滑伸缩，中间图表列吃掉全部剩余宽度 */
    grid-template-columns: clamp(216px, 16vw, 272px) minmax(0, 1fr) clamp(264px, 20vw, 344px);
    gap: 16px;
    align-items: start;
  }
  @media (max-width: 1024px) {
    .qd-grid { grid-template-columns: 200px minmax(0, 1fr) 256px; gap: 12px; }
  }
  @media (max-width: 900px) {
    .qd-grid { grid-template-columns: 1fr; gap: 12px; }
  }
  .qd-note {
    margin-top: 14px;
    font-size: 12px;
    color: hsl(var(--muted-foreground));
    line-height: 1.9;
  }
  .qd-note code {
    background: hsl(var(--muted));
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 11.5px;
  }
  .qd-note a { color: var(--qk-gold); }
</style>
