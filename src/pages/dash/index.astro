---
// /dash —— 阶段零量化看板首页。
// 构建期扫描 public/data/kline/*.json（platform CLI 发布产物），逐个渲染 K线。
// 加自选：往 platform/codes.txt 添代码 → 跑 daily → git push，页面自动收录。
import { existsSync, readFileSync, readdirSync, statSync } from 'node:fs'
import path from 'node:path'

import KLine from '@/components/dash/KLine.astro'
import PageLayout from '@/layouts/CommonPage.astro'

interface KItem {
  code: string
  name: string | null
  from: string
  to: string
  count: number
  publishedAt: string
  kb: number
}

const kdir = path.join(process.cwd(), 'public', 'data', 'kline')
const items: KItem[] = []
if (existsSync(kdir)) {
  for (const f of readdirSync(kdir).filter((f) => /^\d{6}\.json$/.test(f))) {
    try {
      const d = JSON.parse(readFileSync(path.join(kdir, f), 'utf8'))
      items.push({
        code: d.code ?? f.replace('.json', ''),
        name: d.name ?? null,
        from: d.from,
        to: d.to,
        count: d.count ?? (d.kline?.length ?? 0),
        publishedAt: d.publishedAt ?? '',
        kb: Math.round((statSync(path.join(kdir, f)).size / 1024) * 10) / 10
      })
    } catch {
      /* 坏 JSON 跳过，不拖垮整站构建 */
    }
  }
}

const title = '量化看板'
const desc = '阶段零：本地量化数据湖（baostock 日线入库 → 静态 JSON 发布）驱动的 K线/因子/回测看板。'
---

<PageLayout title={title} meta={{ title, description: desc }}>
  <div class='qd-hero'>
    <h1>量化看板</h1>
    <p>
      数据链路：<code>baostock</code> →（platform CLI 每日采集）→ Parquet 数据湖 →（DuckDB
      聚合发布）→ <code>public/data/*.json</code> → 本页静态渲染。 零服务器、零月费。
    </p>
  </div>

  {
    items.length === 0 ? (
      <div class='qd-empty'>
        还没有已发布的数据。在 <code>platform/</code> 下运行：
        <pre>
          <code>{`.venv/bin/python -m cli.qplat ingest-daily --code 600519
.venv/bin/python -m cli.qplat publish-kline --code 600519`}</code>
        </pre>
        然后重新构建即可看到图表。
      </div>
    ) : (
      items.map((it) => (
        <section>
          <KLine code={it.code} name={it.name ?? undefined} height={460} />
          <details class='qd-meta'>
            <summary>
              {it.code} 数据状态：{it.count} 根（{it.from} ~ {it.to}），{it.kb} KB，发布
              {it.publishedAt ? ` ${it.publishedAt.slice(0, 19).replace('T', ' ')}` : '于构建前'}
            </summary>
            <p>
              把 {it.code} 加入每日自动更新：编辑 <code>platform/codes.txt</code>，运行{' '}
              <code>.venv/bin/python -m cli.qplat daily</code>。
            </p>
          </details>
        </section>
      ))
    )
  }

  <div class='qd-plan'>
    <h2>路线图</h2>
    <ul>
      <li class='qd-done'>M0 · 数据管道 + K线看板（本页）</li>
      <li>M1 · 因子看板（IC / 分层 / 衰减）</li>
      <li>M2 · 策略回测引擎（聚宽风格 initialize/handle_bar）</li>
      <li>M3 · 模拟实盘（每日日报）</li>
      <li>M4 · 用户系统 + 上云</li>
    </ul>
    <p>
      规划书：<code>docs/quant-platform-plan.md</code> · 组件：<code
      >src/components/dash/KLine.astro</code
      >
    </p>
  </div>
</PageLayout>

<style is:global>
  .qd-hero h1 {
    margin: 0 0 6px;
  }
  .qd-hero p {
    opacity: 0.75;
    font-size: 14px;
    margin: 0 0 20px;
  }
  .qd-hero code,
  .qd-empty code,
  .qd-meta code,
  .qd-plan code {
    background: rgba(128, 128, 128, 0.14);
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 12.5px;
  }
  .qd-empty {
    border: 1px dashed rgba(128, 128, 128, 0.4);
    border-radius: 10px;
    padding: 18px;
    font-size: 14px;
  }
  .qd-empty pre {
    overflow: auto;
    background: rgba(128, 128, 128, 0.1);
    padding: 10px;
    border-radius: 8px;
    font-size: 12.5px;
  }
  .qd-meta {
    margin: -12px 0 22px;
    font-size: 12.5px;
    opacity: 0.7;
  }
  .qd-meta summary {
    cursor: pointer;
  }
  .qd-plan {
    margin-top: 30px;
    font-size: 14px;
  }
  .qd-plan h2 {
    font-size: 16px;
  }
  .qd-plan ul {
    padding-left: 20px;
    line-height: 2;
  }
  .qd-plan .qd-done {
    text-decoration: line-through;
    opacity: 0.55;
  }
</style>
