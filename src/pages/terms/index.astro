---
import { Button, CardList } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import { dict, getLocale } from '@/i18n'
import { integ, terms } from '@/site-config'

const locale = getLocale(Astro.url.pathname)
const d = dict(locale)

const meta = {
  title: d.terms.title,
  description: d.terms.intro
}
---

<PageLayout {meta}>
  <Button title={d.common.back} href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>{d.terms.title}</h1>
    </div>

    <div id='content' class={cn('animate mt-8 max-w-none md:min-w-[45ch]', integ.typography.class)}>
      <h2 class='text-xl font-medium'>{d.terms.intro}</h2>
      <CardList {...terms[locale]} />
    </div>
  </main>
</PageLayout>
