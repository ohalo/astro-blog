---
import CommonPage from '@/layouts/CommonPage.astro'

const title = '回撤恢复计算器：亏 X% 要涨多少才回本（含固定年化年限表与蒙特卡洛恢复时间分布）'
const description =
  '免费在线回撤恢复计算器：亏损与回本不对称——亏 50% 要涨 100%。先给固定年化下的恢复年限墙（8%/12%/20%），再用 2000 条蒙特卡洛月度路径给出恢复时间 P25/P50/P75/P95 与 N 年未回本概率，固定种子可复现。附公式推导与三个常见误区。'
---

<CommonPage title="回撤恢复计算器" meta={{ title, description }}>
  <div class="dd-tool">
    <p class="answer">
      亏损和回本是两道不等价的算术：亏 <strong>10%</strong> 只要涨 11.1% 就能回本，亏
      <strong>50%</strong> 却要涨 <strong>100%</strong>，亏 90% 要涨 900%。这个计算器分两层：先把「固定年化下的恢复年限墙」摆出来，
      再用蒙特卡洛给一条<strong>带波动的真实路径</strong>——恢复的中位数和尾部，分开回答。
    </p>

    <!-- 卡 1：亏损不对称墙 -->
    <section class="card" aria-label="恢复墙">
      <div class="card-head">
        <h2>亏损不对称墙</h2>
        <span class="tag">No. 1 · 固定年化</span>
      </div>

      <div class="inputs">
        <div class="field slider-field">
          <span>当前回撤</span>
          <input id="dd-range" type="range" min="5" max="90" step="1" value="30" aria-label="当前回撤滑杆" />
          <input id="dd-num" type="number" min="5" max="90" step="1" value="30" aria-label="当前回撤百分比" />
          <span class="unit">%</span>
          <span class="ends">−5% … −90%</span>
        </div>
      </div>

      <div class="verdict">
        <span class="big" id="dd-big">+42.9%</span>
        <span class="txt">这是回本所需涨幅<i id="dd-big-note">若一路按 12% 年化、无波动地复利，约 3.1 年回到本金</i></span>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">回撤</th>
              <th scope="col">需要涨幅（条长 = √涨幅）</th>
              <th scope="col">年化 8%</th>
              <th scope="col">年化 12%</th>
              <th scope="col">年化 20%</th>
            </tr>
          </thead>
          <tbody id="dd-rows">
            <tr data-d="10"><td>−10%</td><td class="bar-cell"><span class="bar" style="width:11%"></span><b>+11.1%</b></td><td>1.4 年</td><td>0.9 年</td><td>0.6 年</td></tr>
            <tr data-d="20"><td>−20%</td><td class="bar-cell"><span class="bar" style="width:16%"></span><b>+25.0%</b></td><td>2.9 年</td><td>2.0 年</td><td>1.2 年</td></tr>
            <tr data-d="30" class="cur"><td>−30%</td><td class="bar-cell"><span class="bar" style="width:21%"></span><b>+42.9%</b></td><td>4.6 年</td><td>3.1 年</td><td>2.0 年</td></tr>
            <tr data-d="40"><td>−40%</td><td class="bar-cell"><span class="bar" style="width:26%"></span><b>+66.7%</b></td><td>6.6 年</td><td>4.5 年</td><td>2.8 年</td></tr>
            <tr data-d="50"><td>−50%</td><td class="bar-cell"><span class="bar" style="width:32%"></span><b>+100.0%</b></td><td>9.0 年</td><td>6.1 年</td><td>3.8 年</td></tr>
            <tr data-d="60"><td>−60%</td><td class="bar-cell"><span class="bar" style="width:39%"></span><b>+150.0%</b></td><td>11.9 年</td><td>8.1 年</td><td>5.0 年</td></tr>
            <tr data-d="70"><td>−70%</td><td class="bar-cell"><span class="bar" style="width:48%"></span><b>+233.3%</b></td><td>15.6 年</td><td>10.6 年</td><td>6.6 年</td></tr>
            <tr data-d="80"><td>−80%</td><td class="bar-cell"><span class="bar" style="width:63%"></span><b>+400.0%</b></td><td>20.9 年</td><td>14.2 年</td><td>8.8 年</td></tr>
            <tr data-d="90"><td>−90%</td><td class="bar-cell"><span class="bar" style="width:95%"></span><b>+900.0%</b></td><td>29.9 年</td><td>20.3 年</td><td>12.6 年</td></tr>
          </tbody>
        </table>
      </div>
      <p class="tbl-note">表假设：按 <code>(1−d)(1+g)ᵗ ≥ 1</code> 一路恒定复利、零波动——真实路径永远比它毛糙，这就是下面第二层存在的理由。年化 20% 一列只作参照：它已经接近顶级基金的长期水平。</p>
    </section>

    <!-- 卡 2：蒙特卡洛 -->
    <section class="card" aria-label="蒙特卡洛恢复时间分布">
      <div class="card-head">
        <h2>如果路径不是一条直线</h2>
        <span class="tag">No. 2 · 蒙特卡洛</span>
      </div>

      <div class="inputs">
        <label class="field">
          <span>年化期望收益 μ</span>
          <input id="dd-mu" type="number" min="-10" max="60" step="1" value="12" />
          <span class="unit">%</span>
        </label>
        <label class="field">
          <span>年化波动 σ</span>
          <input id="dd-sig" type="number" min="0" max="80" step="1" value="20" />
          <span class="unit">%</span>
        </label>
        <label class="field">
          <span>当前回撤</span>
          <input id="dd-num2" type="number" min="5" max="90" step="1" value="30" />
          <span class="unit">%</span>
        </label>
      </div>

      <div class="mc-readout">
        <div class="stat"><b id="st-p50">2.5 年</b><i>中位恢复 P50</i></div>
        <div class="stat"><b id="st-p75">4.7 年</b><i>P75 恢复</i></div>
        <div class="stat gold"><b id="st-p95">10.8 年</b><i>P95 恢复</i></div>
        <div class="stat bad"><b id="st-not10">7.1%</b><i>10 年内未回本</i></div>
      </div>

      <div class="dist">
        <div class="lab"><span>恢复时间分布 · <b id="dist-n">2000 条月度路径 × 20 年上限</b></span><span>单位：年</span></div>
        <div class="band">
          <span class="seg core" id="seg-core"></span>
          <span class="seg mid" id="seg-mid"></span>
          <span class="seg tail" id="seg-tail"></span>
        </div>
        <div class="plabels">
          <span class="peak up" id="lb-p50" style="left:12.5%">P50 2.5</span>
          <span class="up" id="lb-p95" style="left:54%">P95 10.8</span>
          <span class="down" id="lb-p25" style="left:7%">P25 1.4</span>
          <span class="down" id="lb-p75" style="left:23.5%">P75 4.7</span>
        </div>
        <div class="ticks"><span>0</span><span>5</span><span>10</span><span>15</span><span>20</span></div>
        <div class="dist-cap"><span class="swatch"></span><span id="dist-cap">斜纹段是 P95 之后的尾部：10 年内未回本 <b>7.1%</b>，20 年仍未回本 <b>0.9%</b></span></div>
      </div>

      <p class="mc-verdict" id="mc-verdict">
        <b>中位数其实比固定年化的 3.1 年还快</b>——运气好的路径提前碰到本金额，算「已恢复」。
        波动抬高的几乎全是尾部：每 20 条路径就有 1 条要等 10 年以上。
        <b>波动率改变的不是平均值，是尾部的价格。</b>
      </p>

      <div class="mc-foot">
        <button class="btn" id="dd-resample" type="button">重新抽样（换一条路径集）</button>
        <span class="seed" id="dd-seed">mulberry32 · seed 42 · 结果可复现</span>
      </div>
      <p class="tbl-note">分位数在「最终恢复」的路径集合上统计（条件分位）；20 年内没回本的路径不进分位，单列为未恢复概率。固定种子：同参数同种子永远同一结果。</p>
    </section>

    <!-- 说明区 -->
    <div class="prose">
      <h2 id="algo">两个算法在说什么</h2>
      <p>回本所需涨幅只有一个式子：<code>(1−d)(1+R) = 1</code>，解出 <code>R = d ÷ (1−d)</code>。
        它在 d → 1 处是凸的——越靠近底部，每多亏 10% 要多付的回本涨幅越陡：−10% 只需垫 1.1 个百分点，
        −80% 到 −90% 一档直接从 400% 跳到 900%。</p>
      <p>蒙特卡洛部分把年化拆成月度：每月按 <code>μ/12 与 σ/√12</code> 生成对数正态冲击（几何漂移
        <code>μ − σ²/2</code>），数「<b>曾经</b>触到本金线」的第一时间——因为恢复的意义就是中途某刻回过本。
        换 μ、σ 时留意：σ 进几何漂移要打对折。</p>

      <h2 id="traps">三个会骗你的地方</h2>
      <details open>
        <summary>「跌了 40%，三年就回本」的自救计划</summary>
        <p>它默认你能立刻把年化调回历史最好水平，且路径零波动。把上面 σ 拖到 30%，P95 会告诉你另一份时间表。恢复期里还要扣掉生活费与机会成本。</p>
      </details>
      <details>
        <summary>加倍补仓摊成本，中位恢复确实变快——代价写在另一个字段里</summary>
        <p>马丁格尔式的加仓把 P50 缩短，同时把「20 年未回本」的概率推向两位数：你在用尾部概率买时间。计算器不直接模拟加仓路径，方向可以从波动率一栏试出来。</p>
      </details>
      <details>
        <summary>深回撤后重仓博回来</summary>
        <p>回撤 −50% 时要涨 100%，重仓一搏的诱惑正是爆仓概率最高的时刻。先按新本金用凯利公式重新算一遍仓位，多数时候答案是「压一档」。</p>
      </details>

      <h2 id="more">延伸阅读</h2>
      <ul class="rel">
        <li><a href="/blog/2026-06-01-quant-risk-management">《量化交易的风险管理：止损、仓位控制与最大回撤》</a>——把「控制回撤」拆成止损、仓位、分散三件能做的事</li>
        <li><a href="/blog/2026-06-04-kelly-criterion-position-sizing">《凯利公式与仓位管理：用数学优化你的每次下注》</a>——控制「下一次亏多少」，凯利计算器即将在本工具箱上线</li>
        <li><a href="/blog/fractional-kelly-drawdown">《分数 Kelly 与回撤约束：在增长率和最大回撤之间讨价还价》</a>——为什么多数人应该用分数凯利</li>
        <li><a href="/tools">量化工具箱首页</a>——已上线与在计划的全部工具</li>
      </ul>
    </div>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebApplication',
          name: '回撤恢复计算器',
          url: 'https://blog.halo26812.eu.org/tools/drawdown',
          applicationCategory: 'FinanceApplication',
          inLanguage: 'zh-CN',
          isAccessibleForFree: true,
          offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
          description
        },
        {
          '@type': 'FAQPage',
          mainEntity: [
            {
              '@type': 'Question',
              name: '亏 50% 需要涨多少才能回本？',
              acceptedAnswer: { '@type': 'Answer', text: '需要涨 100%。回本所需涨幅公式为 R = d ÷ (1−d)：亏 30% 需涨 42.9%，亏 50% 需涨 100%，亏 90% 需涨 900%。亏损越深，回本所需的涨幅以凸函数速度上升。' }
            },
            {
              '@type': 'Question',
              name: '为什么波动率会拉长恢复时间？',
              acceptedAnswer: { '@type': 'Answer', text: '几何增长率是 μ − σ²/2，波动对复利是双重损耗：波动不仅降低中位恢复速度，还把恢复时间分布的右尾拖长——多数路径中位数附近恢复，少数路径要等极久甚至等不到。蒙特卡洛分位数（P50/P75/P95 与未恢复概率）就是把这条尾量化出来。' }
            },
            {
              '@type': 'Question',
              name: '深回撤后加倍补仓摊成本可取吗？',
              acceptedAnswer: { '@type': 'Answer', text: '马丁格尔式加仓能缩短中位恢复时间，但同时把小概率的极端亏损放大成大概率事件——用尾部概率买时间。更稳的做法是按新本金重新计算仓位（如分数凯利），接受更长的恢复时间而不是借用爆仓风险。' }
            }
          ]
        }
      ]
    })} />
  </div>

  <script>
    // —— 回撤恢复计算器（纯前端、固定种子可复现；实现与设计稿 2026-11-20 一致）——
    const mulberry32 = (seed: number) => {
      let a = seed >>> 0
      return () => {
        a = (a + 0x6d2b79f5) | 0
        let t = Math.imul(a ^ (a >>> 15), 1 | a)
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296
      }
    }
    const gauss = (rnd: () => number) => {
      let u = 0
      let v = 0
      while (u === 0) u = rnd()
      while (v === 0) v = rnd()
      return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v)
    }

    const $ = (id: string) => document.getElementById(id) as HTMLElement
    const num = (id: string, lo: number, hi: number, def: number) => {
      const el = document.getElementById(id) as HTMLInputElement | null
      const x = el ? Number.parseFloat(el.value) : NaN
      return Number.isFinite(x) ? Math.min(hi, Math.max(lo, x)) : def
    }
    const clamp = (x: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, x))
    const pct1 = (x: number) => `${(x * 100).toFixed(1)}%`
    const yr = (x: number) => `${x.toFixed(1)} 年`

    const N = 2000
    const T = 20
    let seed = 42

    // 月度 GBM：从 (1-d) 出发，首次触回 1.0 的月份（曾经碰到即算恢复）
    function recoveryTimes(d: number, mu: number, sig: number, sd: number) {
      const rnd = mulberry32(sd)
      const steps = T * 12
      const nu = mu / 100 - 0.5 * (sig / 100) ** 2
      const s = (sig / 100) / Math.sqrt(12)
      const times: number[] = []
      for (let i = 0; i < N; i++) {
        let y = Math.log(1 - d / 100)
        for (let t = 1; t <= steps; t++) {
          y += nu / 12 + s * gauss(rnd)
          if (y >= 0) {
            times.push(t / 12)
            break
          }
        }
      }
      times.sort((a, b) => a - b)
      return times
    }

    function renderWall(d: number) {
      const need = d / (100 - d)
      $('dd-big').textContent = `+${(need * 100).toFixed(1)}%`
      const t12 = Math.log(1 / (1 - d / 100)) / Math.log(1.12)
      $('dd-big-note').textContent = `若一路按 12% 年化、无波动地复利，约 ${t12.toFixed(1)} 年回到本金`
      const near = clamp(Math.round(d / 10) * 10, 10, 90)
      document.querySelectorAll('#dd-rows tr').forEach((tr) => {
        tr.classList.toggle('cur', Number(tr.getAttribute('data-d')) === near)
      })
    }

    function renderMC(d: number, mu: number, sig: number) {
      const times = recoveryTimes(d, mu, sig, seed)
      const c = times.length
      const unrec = (N - c) / N
      const q = (p: number) => (c === 0 ? NaN : times[Math.min(c - 1, Math.floor(p * c))])
      const p25 = q(0.25)
      const p50 = q(0.5)
      const p75 = q(0.75)
      const p95 = q(0.95)
      const not10 = c === 0 ? 1 : (times.filter((t) => t > 10).length + (N - c)) / N
      const fmt = (x: number) => (Number.isFinite(x) ? (x >= 20 ? '≥20 年' : yr(x)) : '—')

      $('st-p50').textContent = fmt(p50)
      $('st-p75').textContent = fmt(p75)
      $('st-p95').textContent = fmt(p95)
      $('st-not10').textContent = pct1(not10)
      $('dist-n').textContent = `${N} 条月度路径 × ${T} 年上限 · 已恢复 ${((c / N) * 100).toFixed(0)}%`
      $('dist-cap').innerHTML = `斜纹段是 P95 之后的尾部：10 年内未回本 <b>${pct1(not10)}</b>，20 年仍未回本 <b>${pct1(unrec)}</b>`

      // 分布条：0–20 年线性，P95 触顶（截尾）时尾段收成红线
      const pos = (x: number) => (Number.isFinite(x) ? (clamp(x, 0, T) / T) * 100 : 100)
      const core = $('seg-core')
      const mid = $('seg-mid')
      const tail = $('seg-tail')
      core.style.left = `${pos(p25)}%`
      core.style.width = `${Math.max(1.5, pos(p75) - pos(p25))}%`
      mid.style.left = `${pos(p75)}%`
      mid.style.width = `${Math.max(0, pos(p95) - pos(p75))}%`
      tail.style.left = `${pos(p95)}%`
      tail.style.width = `${Math.max(0, 100 - pos(p95))}%`

      const label = (id: string, x: number, tag: string) => {
        const el = $(id)
        el.textContent = Number.isFinite(x) ? `${tag} ${x >= T ? '≥20' : x.toFixed(1)}` : `${tag} —`
        el.style.left = `${clamp(pos(x), 4, 92)}%`
      }
      label('lb-p25', p25, 'P25')
      label('lb-p50', p50, 'P50')
      label('lb-p75', p75, 'P75')
      label('lb-p95', p95, 'P95')

      const fixed12 = Math.log(1 / (1 - d / 100)) / Math.log(1.12)
      const v = $('mc-verdict')
      if (unrec > 0.15) {
        const med = Number.isFinite(p50) ? `中位 ${fmt(p50)}看着还能忍，但 ` : '20 年内没有任何路径回本——'
        v.innerHTML = `<b>${med}P95 已经 ${fmt(p95)}，${pct1(unrec)} 的路径二十年都没回本。</b>
          深回撤 × 高波动叠加时，问题从「几年恢复」变成「能不能一直留在牌桌上」——
          <b>风控是前置约束，不是事后安慰。</b>`
      } else if (p95 > fixed12 * 2) {
        v.innerHTML = `<b>中位数比固定年化的 ${fixed12.toFixed(1)} 年还${p50 <= fixed12 ? '快' : '慢'}</b>——运气好的路径提前碰到本金额，算「已恢复」。
          波动抬高的几乎全是尾部：每 20 条路径就有 1 条要等 ${p95.toFixed(0)} 年以上。
          <b>波动率改变的不是平均值，是尾部的价格。</b>`
      } else {
        v.innerHTML = `μ 高 σ 低时分布收得很紧：P25–P75 都在 ${fmt(p25)}–${fmt(p75)} 之间，尾部几乎不拖。
          <b>恢复问题的难度由 σ 决定，不由回撤深度单独决定。</b>`
      }
      $('dd-seed').textContent = `mulberry32 · seed ${seed} · 结果可复现`
    }

    let timer = 0
    const rerun = (mc = true) => {
      const d = num('dd-num', 5, 90, 30)
      renderWall(d)
      if (mc) {
        window.clearTimeout(timer)
        timer = window.setTimeout(() => {
          renderMC(num('dd-num', 5, 90, 30), num('dd-mu', -10, 60, 12), num('dd-sig', 0, 80, 20))
        }, 120)
      }
    }

    const range = document.getElementById('dd-range') as HTMLInputElement
    const ddNum = document.getElementById('dd-num') as HTMLInputElement
    const ddNum2 = document.getElementById('dd-num2') as HTMLInputElement
    const onD = (src: HTMLInputElement) => {
      const d = clamp(Math.round(Number(src.value) || 30), 5, 90)
      if (src !== range) range.value = String(d)
      if (src !== ddNum) ddNum.value = String(d)
      ddNum2.value = String(d)
      rerun()
    }
    range.addEventListener('input', () => onD(range))
    ddNum.addEventListener('input', () => onD(ddNum))
    ddNum2.addEventListener('input', () => onD(ddNum2))
    for (const id of ['dd-mu', 'dd-sig']) {
      document.getElementById(id)!.addEventListener('input', () => rerun())
    }
    document.getElementById('dd-resample')!.addEventListener('click', () => {
      seed = seed % 100000 + 1
      rerun()
    })

    rerun()
  </script>

  <style>
    .dd-tool {
      --dd-gold: hsl(var(--primary));
      --dd-red: hsl(4 70% 68%);
    }
    .dd-tool .answer {
      line-height: 1.8;
    }
    .dd-tool .answer strong {
      color: var(--dd-gold);
    }
    .dd-tool .card {
