---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { dict, getLocale, localePath } from '@/i18n'

const locale = getLocale(Astro.url.pathname)
const d = dict(locale)
---

<PageLayout meta={{ title: d.notFound.title, description: d.notFound.desc }} {locale}>
  <div class='flex flex-col items-center justify-center py-20 text-center'>
    <h1 class='text-6xl font-medium text-primary'>404</h1>
    <p class='mt-3 text-muted-foreground'>{d.notFound.desc}</p>
    <p class='text-lg'>{d.notFound.body}</p>
    <Button
      title={d.notFound.backHome}
      href={localePath(locale, '/')}
      variant='ahead'
      class='mt-5'
    />
  </div>
</PageLayout>
