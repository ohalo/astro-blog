---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import { dict, getLocale, localePath } from '@/i18n'

const locale = getLocale(Astro.url.pathname)
const d = dict(locale)

const meta = {
  description: d.blog.searchDesc,
  title: d.blog.searchTitle
}
---

<PageLayout {meta} {locale} noindex={true}>
  <Button title={d.common.back} href={localePath(locale, '/blog')} variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>{d.blog.searchTitle}</h1>
    </div>

    <div id='content' class='animate'>
      <p class='my-4'>
        Search currently indexes Chinese articles only. This page does not return English results;
        use the <a href='/search'>Chinese search page</a> to search the full archive.
      </p>
    </div>
  </main>
</PageLayout>
