---
import QuantColumnContent from '@/components/pages/QuantColumnContent.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import { dict, getLocale } from '@/i18n'

const locale = getLocale(Astro.url.pathname)
const d = dict(locale)
---

<PageLayout
  meta={{
    title: d.quant.title,
    description: d.quant.subtitle
  }}
  {locale}
  frame='blackgold'
>
  <QuantColumnContent {locale} />
</PageLayout>
