---
import QuantColumnContent from '@/components/pages/QuantColumnContent.astro'
import PageLayout from '@/layouts/CommonPage.astro'
import { dict, getLocale } from '@/i18n'

const locale = getLocale(Astro.url.pathname)
const d = dict(locale)
---

<PageLayout
  title={d.quant.title}
  meta={{
    title: d.quant.title,
    description: d.quant.subtitle
  }}
>
  <QuantColumnContent {locale} />
</PageLayout>
