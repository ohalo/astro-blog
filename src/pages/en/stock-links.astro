---
import StockLinksContent from '@/components/pages/StockLinksContent.astro'
import PageLayout from '@/layouts/CommonPage.astro'
import { dict, getLocale } from '@/i18n'

const locale = getLocale(Astro.url.pathname)
const d = dict(locale)
---

<PageLayout
  title={d.links.title}
  meta={{
    title: d.links.title,
    description: d.links.intro.replace(/\{(\w+)\}/g, '$1')
  }}
>
  <StockLinksContent {locale} />
</PageLayout>
