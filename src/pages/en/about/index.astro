---
import AboutContent from '@/components/pages/AboutContent.astro'
import PageLayout from '@/layouts/CommonPage.astro'
import { dict, getLocale } from '@/i18n'

const locale = getLocale(Astro.url.pathname)
const d = dict(locale)
---

<PageLayout title={d.about.title} comment>
  <AboutContent {locale} />
</PageLayout>
