---
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, groupCollectionsByYear, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts)
const allPostsByYear = groupCollectionsByYear(allPostsByDate)

const meta = {
  description: '按日期浏览所有文章',
  title: '归档'
}

const total = allPosts.length
const yearCount = allPostsByYear.length
const latest = allPostsByDate[0]?.data?.publishDate
const latestStr = latest
  ? new Date(latest).toISOString().slice(0, 10).replaceAll('-', '.')
  : '—'
const years = allPostsByYear.map(([year]) => String(year))
---

<PageLayout {meta}>
  <main>
    <div id='content' class='animate' aria-label='Blog post list'>
      <div class='hg-arc-stats'>
        <div class='hg-arc-stat'>
          <div class='hg-arc-stat-n'>{total.toLocaleString('en-US')}</div>
          <div class='hg-arc-stat-l'>篇研究文章</div>
        </div>
        <div class='hg-arc-stat'>
          <div class='hg-arc-stat-n'>{yearCount}</div>
          <div class='hg-arc-stat-l'>个年份跨度</div>
        </div>
        <div class='hg-arc-stat'>
          <div class='hg-arc-stat-n'>{latestStr}</div>
          <div class='hg-arc-stat-l'>最近更新</div>
        </div>
        <div class='hg-arc-stats-note'>全部文章按发布时间倒序排列</div>
      </div>

      <nav class='hg-arc-years' aria-label='按年份跳转'>
        {years.map((year, i) => (
          <a href={`#year-${year}`} class:list={['hg-arc-year', i === 0 && 'is-active']}>
            {year}
          </a>
        ))}
      </nav>

      {allPosts.length === 0 && <p>暂无文章。</p>}

      {
        allPostsByYear.map(([year, posts]) => (
          <section class='hg-arc-group' id={`year-${year}`}>
            <div class='hg-arc-group-head'>
              <h2>{year}</h2>
              <span class='hg-arc-count'>{posts.length} 篇文章</span>
            </div>
            <ul class='flex flex-col text-start'>
              {posts.map((p) => (
                <PostPreview post={p} class='border-0 bg-transparent py-2' />
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </main>
</PageLayout>
