---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

import { MediumZoom } from 'astro-pure/advanced'
import { ArticleBottom, Copyright, TOC } from 'astro-pure/components/pages'
import config from 'virtual:config'
import QuantLab from '@/components/lab/QuantLab.astro'
import QuantLabMC from '@/components/lab/QuantLabMC.astro'
import LearningPathHint from '@/components/pages/LearningPathHint.astro'
import PillarNav from '@/components/pages/PillarNav.astro'
import GlossaryTooltip from '@/components/pages/GlossaryTooltip.astro'
import ReadingProgress from '@/components/pages/ReadingProgress.astro'
import SeriesNav from '@/components/pages/SeriesNav.astro'
import { Comment, PageInfo } from '@/components/waline'
import { getLocale, localePath } from '@/i18n'
import type { Locale } from '@/i18n'
import PageLayout from '@/layouts/ContentLayout.astro'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
  hasLab?: boolean
  hasLabMc?: boolean
}

const {
  post: { id, data },
  posts,
  headings,
  remarkPluginFrontmatter,
  hasLab,
  hasLabMc
} = Astro.props

const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate,
  draft: isDraft,
  comment: enableComment,
  tags,
  difficulty
} = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()

const dateLabel = (value: Date | string) => {
  const dt = new Date(value)
  return `${dt.getFullYear()}.${String(dt.getMonth() + 1).padStart(2, '0')}.${String(dt.getDate()).padStart(2, '0')}`
}
const locale: Locale = getLocale(Astro.url.pathname)
const en = locale === 'en'
const levelLabel: Record<string, string> = en
  ? { beginner: 'Beginner', intermediate: 'Intermediate', advanced: 'Advanced' }
  : { beginner: '入门', intermediate: '进阶', advanced: '高阶' }
const isQuant =
  tags?.some((tag) => ['量化', 'quant', '交易', '投资'].some((k) => tag.toLowerCase().includes(k))) ??
  false
const columnName = isQuant ? (en ? 'Quant Column' : '量化专栏') : en ? 'Blog' : '博客'
const columnHref = isQuant ? '/quant-column' : '/blog'
const levelName = difficulty ? levelLabel[difficulty] : en ? 'Research note' : '研究笔记'
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  back={columnHref}
  frame='blackgold'
>
  {!!headings.length && <TOC {headings} slot='sidebar' />}

  <div slot='header' class='hg-article__head'>
    <div class='hg-crumb'>
      <a href={localePath(locale, '/')}>{en ? 'Home' : '首页'}</a>
      <i>/</i>
      <a href={localePath(locale, columnHref)}>{columnName}</a>
      <i>/</i>
      <b>{levelName}</b>
    </div>

    <h1 class='hg-article__title'>
      {isDraft && <span style='color:#e57373'>(Draft) </span>}
      {title}
    </h1>

    <p class='hg-article__lead'>{description}</p>

    <div class='hg-article__meta'>
      <span class='hg-mono'>{dateLabel(publishDate)}</span>
      {difficulty && <b>{levelLabel[difficulty]}</b>}
      {remarkPluginFrontmatter.minutesRead && (
        <span>{en ? 'Read' : '阅读'} {remarkPluginFrontmatter.minutesRead}</span>
      )}
      {!!tags?.length && <span>{tags.slice(0, 3).join(' / ')}</span>}
      {!isDraft && enableComment && <PageInfo comment />}
    </div>

    <div class='hg-article__rule'></div>
  </div>

  <slot />

  <Fragment slot='bottom'>
    {/* Copyright */}
    <Copyright {data} />
    {/* 所属学习路径 */}
    <LearningPathHint slug={id} class='mt-3 sm:mt-6' />
    {/* 文章系列导航（tag 自动聚合，设计稿 docs/designs/2026-11-19-series-nav） */}
    <SeriesNav post={Astro.props.post} {posts} class='mt-3 sm:mt-6' />
    {/* 策展互链：把 pillar 文章按主题串起来，缓解批量内容的孤儿页问题 */}
    <PillarNav post={Astro.props.post} {posts} class='mt-3 sm:mt-6' />
    {/* Article recommend */}
    <ArticleBottom collections={posts} {id} class='mt-3 sm:mt-6' />
    {
      /* Comment */
      !isDraft && enableComment && <Comment class='mt-3 sm:mt-6' />
    }
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}
{/* 文章内参数实验：仅正文含 <quant-lab> 的文章打包实验脚本，其他文章零开销 */}
{hasLab && <QuantLab />}
{/* 蒙特卡洛定价实验（内核 src/lib/mcbs.ts，数值核对 scripts/test-mcbs.ts） */}
{hasLabMc && <QuantLabMC />}
{/* 阅读进度条 + 术语悬浮卡（术语表见 src/data/glossary.ts，加词条零改动） */}
<ReadingProgress />
<GlossaryTooltip />
