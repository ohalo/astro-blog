      wan: '万手',
      klineTitle: 'K线（近60日，含估值区间）',
      upLegend: '涨',
      downLegend: '跌',
      klineNA: 'K线数据暂不可用（上游数据源受限，请稍后重试）',
      flowNA: '今日资金流数据暂不可用（指数、停牌或新股无此项）',
      retry: '重试',
      watchTitle: '自选列表',
      watchHint: '点击代码直接查看 · × 移除',
      watchEmpty: '暂无自选，查询后点「加入自选」添加',
      watchAdd: '添加',
      addWatch: '＋ 加入自选',
      added: '已加入',
      valTitle: '内在价值估值（情景区间）',
      valSub: '基于 stock-intrinsic-value-calc 方法：至少两法交叉验证，给出悲观/中性/乐观而非单一目标价。假设可编辑并按代码保存。',
      methodLabel: '估值方法',
      mPE: 'PE 法',
      mPB: 'PB 法',
      mDCF: 'DCF 法',
      mAll: '综合',
      eps: 'EPS（元）',
      bvps: '每股净资产（元）',
      peLow: '合理PE下限',
      peHigh: '合理PE上限',
      pbLow: '合理PB下限',
      pbHigh: '合理PB上限',
      fairLow: '悲观估值',
      fairMid: '中性估值',
      fairHigh: '乐观估值',
      upside: '相对现价',
