  /* ---------- 根据 DOM 输入重算估值（不重建输入框，保持焦点） ---------- */
  let curData: any = null
  let curCode = ''
  let curVal: {
    a: Assump
    fund: Fundamentals
    zone: Zone | null
    change: Change
    anchor: AnchorKind
  } | null = null
  let curAsOf = ''
  function recompute() {
    if (!curData || !curVal) return
    let a = readAssumpFromDom()
    // 自动锚定：倍数由 ROE 推导（依旧不含当日股价）
    if (a.autoAnchor) {
      a = applyAnchor({ ...a, eps: r2(curVal.fund.eps), bvps: r2(curVal.fund.bvps) }, curVal.fund)
    }
    const { zone, pe, pb, dcf } = computeZone(curData, a)
    const price = curData.price

    const set = (id: string, v: string) => {
      const el = document.getElementById(id)
      if (el) el.textContent = v
    }
    if (pe) {
      set('sq_pe_low', fmt(pe.low))
      set('sq_pe_mid', fmt(pe.mid))
      set('sq_pe_high', fmt(pe.high))
      set('sq_pe_up', pct(pe.mid, price))
    } else {
      set('sq_pe_low', '—'); set('sq_pe_mid', '—'); set('sq_pe_high', '—'); set('sq_pe_up', '—')
    }
    if (pb) {
      set('sq_pb_low', fmt(pb.low))
      set('sq_pb_mid', fmt(pb.mid))
      set('sq_pb_high', fmt(pb.high))
      set('sq_pb_up', pct(pb.mid, price))
    } else {
      set('sq_pb_low', '—'); set('sq_pb_mid', '—'); set('sq_pb_high', '—'); set('sq_pb_up', '—')
    }
    // PEG
    if (curData.peTTM && curData.peTTM > 0 && a.growth > 0) {
      try {
        const r = pegCheck(curData.peTTM, a.growth)
        set('sq_peg', r.peg.toFixed(2))
        set('sq_peg_v', r.verdict)
      } catch {
        set('sq_peg', '—'); set('sq_peg_v', '')
      }
    } else {
      set('sq_peg', '—'); set('sq_peg_v', '')
    }
    // DCF
    if (dcf) {
      set('sq_dcf_low', fmt(dcf.low))
      set('sq_dcf_mid', fmt(dcf.mid))
      set('sq_dcf_high', fmt(dcf.high))
    } else {
      set('sq_dcf_low', L.dcfNA); set('sq_dcf_mid', '—'); set('sq_dcf_high', '—')
    }
    // 综合区间 + 结论
    if (zone) {
      set('sq_z_low', fmt(zone.low))
      set('sq_z_mid', fmt(zone.mid))
      set('sq_z_high', fmt(zone.high))
      const band = bandOf(zone, price)
      const v = document.getElementById('sq_verdict')!
      v.className = 'sq-val-verdict ' + (band === 'undervalued' ? 'sq-v-under' : band === 'overvalued' ? 'sq-v-over' : 'sq-v-fair')
      v.textContent = band === 'undervalued' ? L.verdictUnder : band === 'overvalued' ? L.verdictOver : L.verdictFair
    } else {
      set('sq_z_low', '—'); set('sq_z_mid', '—'); set('sq_z_high', '—')
      const v = document.getElementById('sq_verdict')!
      v.className = 'sq-val-verdict sq-v-fair'
      v.textContent = L.dcfNA
    }
    // 重绘图表（含区间）
    const chart = document.getElementById('sq-chart')
    if (chart) chart.innerHTML = candleSVG(curData.kline, L, zone, price)
    // 保存假设 + 刷新快照（快照只含基本面与区间，刻意不含股价）
    const edited = JSON.stringify(a) !== JSON.stringify(curVal.a)
    const snapZone = zone ? { low: zone.low, mid: zone.mid, high: zone.high } : null
    saveVal(
      curCode,
      a,
      snapZone
        ? {
            fund: curVal.fund,
            zone: snapZone,
            asOf: curAsOf || todayStr(),
            anchor: anchorKindOf(a, curVal.fund)
          }
        : null
    )
    // 用户改了假设 → 变化说明切为「人为调整」，区别于基本面变动
    if (edited && curVal.change.type !== 'edited') {
      curVal = { ...curVal, change: { type: 'edited' } }
      const chg = document.querySelector('.sq-change')
      if (chg) {
        chg.className = 'sq-change sq-chg-edit'
        chg.innerHTML = L.changeEdited
      }
      const brief = document.querySelector('.sq-brief-flag')
      if (brief) brief.innerHTML = L.changeEdited
    }
    const note = document.getElementById('sq_save_note')
    if (note) note.textContent = L.saveNote
  }

  /* ---------- 主渲染 ---------- */
  /** 常驻可见的一行摘要：区间 + 是否变化 + 当前判定（面板可折叠，但这一行始终可见） */
  function briefHTML(v: any, d: any, L: any): string {
    const z = v.zone
    const anchorText =
      v.anchor === 'roe'
        ? L.anchorRoe
        : v.anchor === 'peg'
          ? L.anchorPeg
          : v.anchor === 'manual'
            ? L.anchorManual
            : L.anchorNone
    if (!z) return `<span class='sq-brief-na'>${anchorText}</span>`
    const band = bandOf(z, d.price)
    const bandTxt =
      band === 'undervalued' ? L.undervalued : band === 'overvalued' ? L.overvalued : L.fair
    const flagTxt =
      v.change.type === 'fundamentals'
        ? `<b class='sq-brief-warn'>基本面已变，区间已调整</b>`
        : v.change.type === 'unchanged'
          ? '区间未变（基本面未更新）'
          : v.change.type === 'edited'
            ? '假设已改'
            : '首次锚定'
    return `区间 ${fmt(z.low)} – ${fmt(z.high)}（${anchorText}）　·　<span class='sq-brief-flag'>${flagTxt}</span>　·　现价 ${fmt(d.price)} → <b>${bandTxt}</b>`
  }

  function render(d: any, L: any, v: ReturnType<typeof resolveValuation>): string {
    const up = d.change >= 0
    const dirCls = up ? 'up' : 'down'
    const sign = up ? '+' : ''
    const grid = [
      [L.open, fmt(d.open), ''],
      [L.prevClose, fmt(d.prevClose), ''],
      [L.high, fmt(d.high), 'up'],
      [L.low, fmt(d.low), 'down'],
      [L.limitUp, fmt(d.limitUp), 'up'],
      [L.limitDown, fmt(d.limitDown), 'down'],
      [L.volume, toWanShou(d.volume) + ' ' + L.wan, ''],
      [L.amount, toYi(d.amount) + ' ' + L.yi, ''],
      [L.turnover, fmt(d.turnover) + '%', ''],
      [L.amplitude, fmt(d.amplitude) + '%', ''],
      [L.volRatio, fmt(d.volumeRatio), ''],
      [L.pe, d.peTTM == null ? L.none : fmt(d.peTTM), ''],
      [L.pb, fmt(d.pb), ''],
      [L.totalCap, toYi(d.totalCap) + ' ' + L.yi, ''],
      [L.floatCap, toYi(d.floatCap) + ' ' + L.yi, ''],
      ['', '', '']
    ]
      .filter((r) => r[0])
      .map(
        (r) =>
          `<div class='sq-cell'><div class='k'>${r[0]}</div><div class='v ${r[2]}'>${r[1]}</div></div>`
      )
      .join('')

    const basic = [
      [L.totalShares, fmt(d.totalShares / 1e8) + ' ' + L.shares],
      [L.totalCap, toYi(d.totalCap) + ' ' + L.yi],
      [L.floatCap, toYi(d.floatCap) + ' ' + L.yi],
      [L.w52h, d.week52High ? fmt(d.week52High) : L.none],
      [L.w52l, d.week52Low ? fmt(d.week52Low) : L.none],
      [L.industry, d.industry || L.none]
    ]
      .map((r) => `<div class='sq-kv'><span class='k'>${r[0]}</span><span class='v'>${esc(r[1])}</span></div>`)
      .join('')

    return `
      <div class='sq-hero'>
        <div class='sq-hero-top'>
          <span class='sq-name'>${esc(d.name)}</span>
          <span class='sq-code'>${esc(d.code)}</span>
          <span class='sq-tag'>${d.market === 'sh' ? '沪A' : d.market === 'bj' ? '京A' : '深A'}</span>
          <button class='sq-addwatch' id='sq-addwatch' type='button'>${L.addWatch}</button>
        </div>
        <div class='sq-price-row'>
          <span class='sq-price ${dirCls}'>${fmt(d.price)}</span>
          <span class='sq-chg ${dirCls}'>${sign}${fmt(d.change)}　${sign}${fmt(d.changePct)}%</span>
          <span class='sq-time'>${esc(d.time)}</span>
        </div>
        <div class='sq-kline-head'>
          <span>${L.klineTitle}</span>
          <span class='sq-legend'>
            <i class='dot up'></i>${L.upLegend}
            <i class='dot down'></i>${L.downLegend}
            <i class='zdot' style='background:#4f9dde'></i>${L.fairLow}
            <i class='zdot' style='background:var(--gold-bright)'></i>${L.fairMid}
            <i class='zdot' style='background:#e07b53'></i>${L.fairHigh}
          </span>
        </div>
        <div id='sq-chart'>${candleSVG(d.kline, L, v.zone, d.price) || `<div class='sq-empty sq-empty-kline'>${L.klineNA}</div>`}</div>
        <div class='sq-anchor-brief'>${briefHTML(v, d, L)}</div>
        <div class='sq-grid'>${grid}</div>
      </div>
      ${valuationHTML(d, v.a, L, v.fund, v.change, v.anchor, curAsOf || todayStr())}
      <div class='sq-cols'>
        <div class='sq-card'><h3>${L.basic}</h3>${basic}</div>
        <div class='sq-card'><h3>${L.flow}</h3>${flowBars(d.fundFlow, L)}</div>
      </div>
      <div class='sq-foot'>
        数据来源：腾讯财经（行情 / K线）+ 新浪财经（资金流）· 经服务端代理 ·
        ${L.foot2}
      </div>
    `
  }

  /* ---------- 查询 ---------- */
  async function query() {
    const root = document.querySelector('.stock-quote') as HTMLElement
    L = LABELS[(root?.dataset.locale as 'zh' | 'en') || 'zh']
    const code = (document.getElementById('sq-code') as HTMLInputElement).value.trim()
    const market = (document.getElementById('sq-market') as HTMLSelectElement).value
    const status = document.getElementById('sq-status')!
    const result = document.getElementById('sq-result')!
    const btn = document.getElementById('sq-btn') as HTMLButtonElement
    if (!/^\d{4,6}$/.test(code)) {
      status.hidden = false
      status.className = 'sq-status err'
      status.textContent = L.error
      return
    }
    btn.disabled = true
    status.hidden = false
    status.className = 'sq-status'
    status.textContent = L.loading
    result.innerHTML = ''
    try {
      const res = await fetch(`/api/stock?code=${code}&market=${market}`)
      const data = await res.json()
      if (!res.ok || data.error) throw new Error(data.error || 'error')
      curData = data
      curCode = data.code
      // 解析估值：推导基本面 → 载入/初始化假设 → 自动锚定 → 与上次快照对比
      const v = resolveValuation(data)
      curVal = v
      curAsOf = todayStr()
      // 首次或基本面变化时落盘快照
      if (v.change.type === 'init' || v.change.type === 'fundamentals') {
        saveVal(
          data.code,
          v.a,
          v.zone
            ? {
                fund: v.fund,
                zone: { low: v.zone.low, mid: v.zone.mid, high: v.zone.high },
                asOf: curAsOf,
                anchor: v.anchor
              }
            : null
        )
      }
      result.innerHTML = render(data, L, v)
      // 同步隐藏的 method 选择器为当前假设所用方法
      const sel = document.getElementById('sq_method') as HTMLSelectElement | null
      if (sel) sel.value = v.a.method
      // 初始区间：用保存/默认假设计算后重绘图表 + 填充估值数值
      recompute()
      renderWatch(data.code)
      wireResult()
    } catch (e: any) {
      status.hidden = false
      status.className = 'sq-status err'
      status.textContent = L.error
    } finally {
      btn.disabled = false
      status.hidden = true
    }
  }

  /* 结果区域事件绑定（每次重渲染后调用） */
  function wireResult() {
    const addBtn = document.getElementById('sq-addwatch')
    addBtn?.addEventListener('click', () => {
      if (!curData) return
      const list = loadWatch()
      if (!list.find((w) => w.code === curData.code)) {
        list.unshift({ code: curData.code, name: curData.name, market: curData.market })
        saveWatch(list)
        renderWatch(curData.code)
      }
    })
    // 方法切换
    document.querySelectorAll('.sq-method button').forEach((b) => {
      b.addEventListener('click', () => {
        const m = (b as HTMLElement).dataset.m || 'all'
        const sel = document.getElementById('sq_method') as HTMLSelectElement | null
        if (sel) sel.value = m
        document.querySelectorAll('.sq-method button').forEach((x) => x.classList.remove('active'))
        b.classList.add('active')
        recompute()
      })
    })
    // 估值输入实时重算
    const ids = [
      'sq_i_eps', 'sq_i_bvps', 'sq_i_peLow', 'sq_i_peHigh', 'sq_i_pbLow', 'sq_i_pbHigh',
      'sq_i_growth', 'sq_i_coe', 'sq_i_gPerp', 'sq_i_fcff', 'sq_i_wacc', 'sq_i_g', 'sq_i_netDebt'
    ]
    ids.forEach((id) => {
      const el = document.getElementById(id)
      el?.addEventListener('input', recompute)
    })
    // 自动锚定开关用 change 事件（checkbox）
    document.getElementById('sq_i_auto')?.addEventListener('change', recompute)
    // 重置默认
    document.getElementById('sq_reset_val')?.addEventListener('click', () => {
      if (!curData || !curVal) return
      const a = defaultAssump(curData, curVal.fund)
      const anchor = anchorKindOf(a, curVal.fund)
      // 重置：清掉快照，按默认假设重新锚定
      saveVal(curCode, a, null)
      curVal = { ...curVal, a, anchor, change: { type: 'init' } }
      // 整块替换（含 details 外壳），以重置所有输入框
      const valBox = document.querySelector('.sq-val-details')
      if (valBox) {
        valBox.outerHTML = valuationHTML(
          curData, a, L, curVal.fund, curVal.change, anchor, curAsOf || todayStr()
        )
      }
      recompute()
      wireResult()
    })
  }

  /* ---------- 启动 ---------- */
  // 注入隐藏的 method 选择器（供 recompute 读取）
  function ensureMethodSelect() {
    if (!document.getElementById('sq_method')) {
      const s = document.createElement('select')
      s.id = 'sq_method'
      s.style.display = 'none'
      s.innerHTML = "<option value='pe'>pe</option><option value='pb'>pb</option><option value='dcf'>dcf</option><option value='all'>all</option>"
      document.querySelector('.stock-quote')?.appendChild(s)
    }
  }

  renderWatch()
  ensureMethodSelect()

  // 自选点击 / 移除 / 添加
  document.getElementById('sq-watchlist')?.addEventListener('click', (e) => {
    const t = e.target as HTMLElement
    if (t.dataset.x) {
      const code = t.dataset.x
      const list = loadWatch().filter((w) => w.code !== code)
      saveWatch(list)
      renderWatch()
      return
    }
    const chip = t.closest('.sq-chip') as HTMLElement
    if (chip?.dataset.code) {
      ;(document.getElementById('sq-code') as HTMLInputElement).value = chip.dataset.code
      const m = chip.dataset.market
      if (m) (document.getElementById('sq-market') as HTMLSelectElement).value = m
      query()
    }
  })
  document.getElementById('sq-watch-add-btn')?.addEventListener('click', () => {
    const inp = document.getElementById('sq-watch-add') as HTMLInputElement
    const code = inp.value.trim()
    if (!/^\d{4,6}$/.test(code)) return
    const list = loadWatch()
    if (!list.find((w) => w.code === code)) {
      list.unshift({ code, name: code, market: 'auto' })
      saveWatch(list)
      renderWatch()
    }
    inp.value = ''
  })
  document.getElementById('sq-watch-add')?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') (document.getElementById('sq-watch-add-btn') as HTMLButtonElement).click()
  })

  const form = document.getElementById('sq-form')
  form?.addEventListener('submit', (e) => {
    e.preventDefault()
    query()
  })
  query()
</script>
