---
import StockQuote from '@/components/stock/StockQuote.astro'
import PageLayout from '@/layouts/CommonPage.astro'
import { dict, getLocale } from '@/i18n'

const locale = getLocale(Astro.url.pathname)
const d = dict(locale)
const title = '股票查询'
const desc = '输入股票代码，实时查询行情、K线、资金流向与内在价值估值区间。'
---

<PageLayout title={title} meta={{ title, description: desc }}>
  <StockQuote locale='zh' />
</PageLayout>
