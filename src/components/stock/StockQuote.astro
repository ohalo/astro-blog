---
interface Props {
  locale?: 'zh' | 'en'
}
const { locale = 'zh' } = Astro.props
---

<div class='stock-quote' data-locale={locale}>
  <form class='sq-search' id='sq-form'>
    <input
      id='sq-code'
      class='sq-input'
      inputmode='numeric'
      placeholder='000002 / 600519'
      autocomplete='off'
      value='000002'
    />
    <select id='sq-market' class='sq-select'>
      <option value='auto'>自动</option>
      <option value='sh'>沪市 A</option>
      <option value='sz'>深市 A</option>
      <option value='bj'>京市 A</option>
    </select>
    <button type='submit' class='sq-btn' id='sq-btn'>查询</button>
  </form>

  <div id='sq-status' class='sq-status' hidden></div>
  <div id='sq-result'></div>
</div>

<style is:global>
  .stock-quote {
    --ink-1: #131210;
    --ink-2: #0b0a09;
    --gold: #d4ac37;
    --gold-bright: #ebc657;
    --cream: #f0eade;
    --muted: #9a948a;
    --up: #e24b4a; /* 涨 = 红 */
    --down: #3fa66a; /* 跌 = 绿 */
    --line: rgba(212, 172, 55, 0.22);
    max-width: 920px;
    margin: 0 auto;
    color: var(--cream);
    font-family:
      -apple-system, 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
  }
  .sq-search {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    background: var(--ink-1);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 22px;
  }
  .sq-input,
  .sq-select {
    background: #1b1916;
    color: var(--cream);
    border: 1px solid var(--line);
    border-radius: 9px;
    padding: 10px 12px;
    font-size: 14px;
    outline: none;
  }
  .sq-input {
    flex: 1;
    min-width: 160px;
  }
  .sq-select {
    width: 120px;
  }
  .sq-btn {
    background: linear-gradient(180deg, var(--gold-bright), var(--gold));
    color: #1a160c;
    border: none;
    border-radius: 9px;
    padding: 10px 22px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .sq-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .sq-status {
    text-align: center;
    color: var(--muted);
    padding: 24px;
    font-size: 14px;
  }
  .sq-status.err {
    color: var(--down);
  }

  /* hero */
  .sq-hero {
    background: var(--ink-1);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 22px 24px;
    margin-bottom: 18px;
  }
  .sq-hero-top {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .sq-name {
    font-size: 22px;
    font-weight: 600;
  }
  .sq-code {
    color: var(--muted);
    font-size: 13px;
  }
  .sq-tag {
    font-size: 11px;
    color: var(--gold);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 1px 7px;
  }
  .sq-price-row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .sq-price {
    font-size: 40px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .sq-chg {
    font-size: 16px;
    font-variant-numeric: tabular-nums;
  }
  .sq-time {
    margin-left: auto;
    color: var(--muted);
    font-size: 12px;
  }
  .up {
    color: var(--up);
  }
  .down {
    color: var(--down);
  }

  .sq-kline-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 14px;
    font-size: 12px;
    color: var(--muted);
  }
  .sq-legend {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .sq-legend .dot {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    display: inline-block;
    margin: 0 2px 0 8px;
  }
  .sq-legend .dot.up {
    background: var(--up);
  }
  .sq-legend .dot.down {
    background: var(--down);
  }
  .sq-kline {
    margin-top: 6px;
    width: 100%;
    height: auto;
    display: block;
  }
  /* K线 SVG 颜色（用 class 而非 presentation 上的 var()，确保 CSS 变量生效） */
  .sq-grid-line {
    stroke: var(--line);
    stroke-width: 1;
  }
  .sq-axis-txt {
    fill: var(--muted);
    font-size: 10px;
    font-family:
      -apple-system, 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
  }
  .sq-c-up {
    fill: var(--up);
  }
  .sq-c-down {
    fill: var(--down);
  }
  .sq-w-up {
    stroke: var(--up);
    stroke-width: 1;
  }
  .sq-w-down {
    stroke: var(--down);
    stroke-width: 1;
  }

  .sq-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 18px;
  }
  .sq-cell {
    background: #17150f;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
  }
  .sq-cell .k {
    font-size: 12px;
    color: var(--muted);
  }
  .sq-cell .v {
    font-size: 15px;
    margin-top: 2px;
    font-variant-numeric: tabular-nums;
  }

  .sq-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 18px;
  }
  .sq-card {
    background: var(--ink-1);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px 20px;
  }
  .sq-card h3 {
    font-size: 14px;
    color: var(--gold);
    font-weight: 600;
    margin: 0 0 14px;
    letter-spacing: 0.04em;
  }
  .sq-kv {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    padding: 6px 0;
    border-bottom: 1px dashed var(--line);
  }
  .sq-kv:last-child {
    border-bottom: none;
  }
  .sq-kv .k {
    color: var(--muted);
  }
  .sq-kv .v {
    font-variant-numeric: tabular-nums;
  }

  .sq-empty {
    margin-top: 8px;
    padding: 18px 16px;
    color: var(--muted);
    font-size: 13px;
    text-align: center;
    background: #17150f;
    border: 1px dashed var(--line);
    border-radius: 10px;
  }
  .sq-empty-kline {
    padding: 54px 16px;
  }
  .sq-flow {
    margin-top: 6px;
  }
  .sq-bar-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 9px 0;
    font-size: 13px;
  }
  .sq-bar-row .lbl {
    width: 56px;
    color: var(--muted);
  }
  .sq-bar-track {
    flex: 1;
    height: 10px;
    background: #17150f;
    border-radius: 6px;
    overflow: hidden;
  }
  .sq-bar-fill {
    height: 100%;
    border-radius: 6px;
  }
  .sq-bar-val {
    width: 84px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .sq-foot {
    margin-top: 22px;
    color: var(--muted);
    font-size: 11px;
    text-align: center;
  }
  @media (max-width: 680px) {
    .sq-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .sq-cols {
      grid-template-columns: 1fr;
    }
    .sq-price {
      font-size: 32px;
    }
  }
</style>

<script>
  const LABELS = {
    zh: {
      search: '查询',
      placeholder: '输入股票代码，如 000002 / 600519',
      loading: '查询中…',
      error: '查询失败，请检查代码或稍后重试',
      open: '今开',
      prevClose: '昨收',
      high: '最高',
      low: '最低',
      limitUp: '涨停',
      limitDown: '跌停',
      volume: '成交量',
      amount: '成交额',
      turnover: '换手率',
      amplitude: '振幅',
      volRatio: '量比',
      pe: '市盈率(TTM)',
      pb: '市净率',
      totalCap: '总市值',
      floatCap: '流通市值',
      basic: '基本资料',
      totalShares: '总股本',
      w52h: '52周最高',
      w52l: '52周最低',
      industry: '所属行业',
      none: '暂无',
      flow: '资金流向（今日）',
      main: '主力净流入',
      huge: '超大单',
      big: '大单',
      mid: '中单',
      small: '小单',
      shares: '亿股',
      yi: '亿',
      wan: '万手',
      klineTitle: 'K线（近60日）',
      upLegend: '涨',
      downLegend: '跌',
      klineNA: 'K线数据暂不可用（上游数据源受限，请稍后重试）',
      flowNA: '今日资金流数据暂不可用（指数、停牌或新股无此项）',
      retry: '重试'
    },
    en: {
      search: 'Search',
      placeholder: 'Enter code, e.g. 000002 / 600519',
      loading: 'Loading…',
      error: 'Query failed, check the code or retry',
      open: 'Open',
      prevClose: 'Prev Close',
      high: 'High',
      low: 'Low',
      limitUp: 'Limit Up',
      limitDown: 'Limit Down',
      volume: 'Volume',
      amount: 'Turnover',
      turnover: 'Turnover %',
      amplitude: 'Amplitude',
      volRatio: 'Vol Ratio',
      pe: 'P/E (TTM)',
      pb: 'P/B',
      totalCap: 'Total Cap',
      floatCap: 'Float Cap',
      basic: 'Basics',
      totalShares: 'Total Shares',
      w52h: '52W High',
      w52l: '52W Low',
      industry: 'Industry',
      none: 'N/A',
      flow: 'Fund Flow (Today)',
      main: 'Main Net Inflow',
      huge: 'Huge',
      big: 'Big',
      mid: 'Mid',
      small: 'Small',
      shares: 'B sh',
      yi: 'B',
      wan: 'W lots',
      klineTitle: 'Candlestick (60d)',
      upLegend: 'Up',
      downLegend: 'Down',
      klineNA: 'Candlestick data unavailable (upstream source limited, retry later)',
      flowNA: 'Fund flow unavailable today (index, halted or newly listed)',
      retry: 'Retry'
    }
  }

  function fmt(n: number, d = 2): string {
    if (n == null || isNaN(n)) return '—'
    return n.toLocaleString('zh-CN', { minimumFractionDigits: d, maximumFractionDigits: d })
  }
  function toYi(yuan: number): string {
    return fmt(yuan / 1e8, 2)
  }
  function toWanShou(shares: number): string {
    return fmt(shares / 1e4, 1)
  }
  function esc(s: string): string {
    return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] || c))
  }
  function candleSVG(kl: any[], L: any): string {
    if (!kl || kl.length < 2) return ''
    const W = 900,
      Lm = 52,
      Rm = 12,
      T = 12
    const priceH = 150,
      gap = 22,
      volH = 46,
      B = 26
    const H = T + priceH + gap + volH + B
    const plotL = Lm,
      plotR = W - Rm,
      plotW = plotR - plotL
    const priceTop = T,
      priceBot = T + priceH
    const volTop = priceBot + gap,
      volBot = volTop + volH

    let minP = Math.min(...kl.map((d) => d.l))
    let maxP = Math.max(...kl.map((d) => d.h))
    const pad = (maxP - minP) * 0.08 || maxP * 0.05 || 1
    minP -= pad
    maxP += pad
    const span = maxP - minP || 1
    const yOf = (p: number) => priceTop + (1 - (p - minP) / span) * priceH

    const n = kl.length
    const slot = plotW / n
    const cw = Math.max(2, Math.min(slot * 0.62, 14))
    const vMax = Math.max(...kl.map((d) => d.v)) || 1

    // Y 轴网格 + 价格刻度
    let yaxis = ''
    const ticks = 5
    for (let i = 0; i < ticks; i++) {
      const p = minP + (span * i) / (ticks - 1)
      const y = yOf(p)
      yaxis += `<line class='sq-grid-line' x1='${plotL}' y1='${y.toFixed(1)}' x2='${plotR}' y2='${y.toFixed(1)}'/>
        <text class='sq-axis-txt' x='${plotL - 6}' y='${(y + 3.5).toFixed(1)}' text-anchor='end'>${fmt(p)}</text>`
    }

    // 蜡烛 + 成交量柱
    let candles = '',
      vols = ''
    kl.forEach((d, i) => {
      const cx = plotL + (i + 0.5) * slot
      const up = d.c >= d.o
      const wCls = up ? 'sq-w-up' : 'sq-w-down'
      const bCls = up ? 'sq-c-up' : 'sq-c-down'
      const yO = yOf(d.o),
        yC = yOf(d.c),
        yH = yOf(d.h),
        yL = yOf(d.l)
      const top = Math.min(yO, yC)
      const bh = Math.max(Math.abs(yC - yO), 1)
      candles += `<line class='${wCls}' x1='${cx.toFixed(1)}' y1='${yH.toFixed(1)}' x2='${cx.toFixed(1)}' y2='${yL.toFixed(1)}'/>
        <rect class='${bCls}' x='${(cx - cw / 2).toFixed(1)}' y='${top.toFixed(1)}' width='${cw.toFixed(1)}' height='${bh.toFixed(1)}'/>`
      const vh = (d.v / vMax) * volH
      vols += `<rect class='${bCls}' x='${(cx - cw / 2).toFixed(1)}' y='${(volBot - vh).toFixed(1)}' width='${cw.toFixed(1)}' height='${vh.toFixed(1)}' opacity='0.55'/>`
    })

    // X 轴日期刻度
    let xlabels = ''
    const xticks = Math.min(6, n)
    for (let i = 0; i < xticks; i++) {
      const idx = Math.round((i * (n - 1)) / (xticks - 1))
      const d = kl[idx]
      const cx = plotL + (idx + 0.5) * slot
      const mmdd = String(d.t).slice(5)
      const anchor = i === 0 ? 'start' : i === xticks - 1 ? 'end' : 'middle'
      const tx = i === 0 ? plotL : i === xticks - 1 ? plotR : cx
      xlabels += `<text class='sq-axis-txt' x='${tx.toFixed(1)}' y='${(volBot + 16).toFixed(1)}' text-anchor='${anchor}'>${mmdd}</text>`
    }

    return `<svg class='sq-kline' viewBox='0 0 ${W} ${H}' preserveAspectRatio='xMidYMid meet'>
      ${yaxis}
      ${candles}
      ${vols}
      ${xlabels}
      <text class='sq-axis-txt' x='${plotL}' y='${priceTop - 2}'>${L.klineTitle}</text>
      <text class='sq-axis-txt' x='${plotR}' y='${(volTop - 7).toFixed(1)}' text-anchor='end'>VOL</text>
    </svg>`
  }
  function flowBars(ff: any, L: any): string {
    if (!ff) return `<div class='sq-empty'>${L.flowNA}</div>`
    const rows = [
      { lbl: L.huge, v: ff.huge },
      { lbl: L.big, v: ff.big },
      { lbl: L.mid, v: ff.mid },
      { lbl: L.small, v: ff.small }
    ]
    const max = Math.max(...rows.map((r) => Math.abs(r.v)), 1)
    const color = (v: number) => (v >= 0 ? 'var(--up)' : 'var(--down)')
    const sign = (v: number) => (v >= 0 ? '+' : '')
    const bars = rows
      .map((r) => {
        const w = (Math.abs(r.v) / max) * 100
        return `<div class='sq-bar-row'>
          <span class='lbl'>${r.lbl}</span>
          <div class='sq-bar-track'><div class='sq-bar-fill' style='width:${w.toFixed(1)}%;background:${color(r.v)}'></div></div>
          <span class='sq-bar-val ${r.v >= 0 ? 'up' : 'down'}'>${sign(r.v)}${toYi(r.v)}亿</span>
        </div>`
      })
      .join('')
    const mainCls = ff.main >= 0 ? 'up' : 'down'
    return `<div class='sq-flow'>${bars}
      <div class='sq-kv' style='margin-top:10px'><span class='k'>${L.main}</span><span class='v ${mainCls}'>${sign(ff.main)}${toYi(ff.main)}亿</span></div>
    </div>`
  }

  async function query() {
    const root = document.querySelector('.stock-quote') as HTMLElement
    const L = LABELS[(root?.dataset.locale as 'zh' | 'en') || 'zh']
    const code = (document.getElementById('sq-code') as HTMLInputElement).value.trim()
    const market = (document.getElementById('sq-market') as HTMLSelectElement).value
    const status = document.getElementById('sq-status')!
    const result = document.getElementById('sq-result')!
    const btn = document.getElementById('sq-btn') as HTMLButtonElement
    if (!/^\d{4,6}$/.test(code)) {
      status.hidden = false
      status.className = 'sq-status err'
      status.textContent = L.error
      return
    }
    btn.disabled = true
    status.hidden = false
    status.className = 'sq-status'
    status.textContent = L.loading
    result.innerHTML = ''
    try {
      const res = await fetch(`/api/stock?code=${code}&market=${market}`)
      const data = await res.json()
      if (!res.ok || data.error) throw new Error(data.error || 'error')
      result.innerHTML = render(data, L)
    } catch (e: any) {
      status.hidden = false
      status.className = 'sq-status err'
      status.textContent = L.error
    } finally {
      btn.disabled = false
      status.hidden = true
    }
  }

  function render(d: any, L: any): string {
    const up = d.change >= 0
    const dirCls = up ? 'up' : 'down'
    const sign = up ? '+' : ''
    const trendUp = d.kline.length > 1 ? d.kline[d.kline.length - 1].c >= d.kline[0].c : up
    const grid = [
      [L.open, fmt(d.open), ''],
      [L.prevClose, fmt(d.prevClose), ''],
      [L.high, fmt(d.high), 'up'],
      [L.low, fmt(d.low), 'down'],
      [L.limitUp, fmt(d.limitUp), 'up'],
      [L.limitDown, fmt(d.limitDown), 'down'],
      [L.volume, toWanShou(d.volume) + ' ' + L.wan, ''],
      [L.amount, toYi(d.amount) + ' ' + L.yi, ''],
      [L.turnover, fmt(d.turnover) + '%', ''],
      [L.amplitude, fmt(d.amplitude) + '%', ''],
      [L.volRatio, fmt(d.volumeRatio), ''],
      [L.pe, d.peTTM == null ? L.none : fmt(d.peTTM), ''],
      [L.pb, fmt(d.pb), ''],
      [L.totalCap, toYi(d.totalCap) + ' ' + L.yi, ''],
      [L.floatCap, toYi(d.floatCap) + ' ' + L.yi, ''],
      ['', '', '']
    ]
      .filter((r) => r[0])
      .map(
        (r) =>
          `<div class='sq-cell'><div class='k'>${r[0]}</div><div class='v ${r[2]}'>${r[1]}</div></div>`
      )
      .join('')

    const basic = [
      [L.totalShares, fmt(d.totalShares / 1e8) + ' ' + L.shares],
      [L.totalCap, toYi(d.totalCap) + ' ' + L.yi],
      [L.floatCap, toYi(d.floatCap) + ' ' + L.yi],
      [L.w52h, d.week52High ? fmt(d.week52High) : L.none],
      [L.w52l, d.week52Low ? fmt(d.week52Low) : L.none],
      [L.industry, d.industry || L.none]
    ]
      .map((r) => `<div class='sq-kv'><span class='k'>${r[0]}</span><span class='v'>${esc(r[1])}</span></div>`)
      .join('')

    return `
      <div class='sq-hero'>
        <div class='sq-hero-top'>
          <span class='sq-name'>${esc(d.name)}</span>
          <span class='sq-code'>${esc(d.code)}</span>
          <span class='sq-tag'>${d.market === 'sh' ? '沪A' : d.market === 'bj' ? '京A' : '深A'}</span>
        </div>
        <div class='sq-price-row'>
          <span class='sq-price ${dirCls}'>${fmt(d.price)}</span>
          <span class='sq-chg ${dirCls}'>${sign}${fmt(d.change)}　${sign}${fmt(d.changePct)}%</span>
          <span class='sq-time'>${esc(d.time)}</span>
        </div>
        <div class='sq-kline-head'>
          <span>${L.klineTitle}</span>
          <span class='sq-legend'><i class='dot up'></i>${L.upLegend}　<i class='dot down'></i>${L.downLegend}</span>
        </div>
        ${candleSVG(d.kline, L) || `<div class='sq-empty sq-empty-kline'>${L.klineNA}</div>`}
        <div class='sq-grid'>${grid}</div>
      </div>

      <div class='sq-cols'>
        <div class='sq-card'><h3>${L.basic}</h3>${basic}</div>
        <div class='sq-card'><h3>${L.flow}</h3>${flowBars(d.fundFlow, L)}</div>
      </div>
      <div class='sq-foot'>
        数据来源：腾讯财经（行情 / K线）+ 新浪财经（资金流）· 经服务端代理 ·
        仅供参考，投资有风险
      </div>
    `
  }

  const form = document.getElementById('sq-form')
  form?.addEventListener('submit', (e) => {
    e.preventDefault()
    query()
  })
  // 默认加载一次
  query()
</script>
