  // 当前语言标签（模块级，供 recompute / wireResult 闭包使用）
  let L: any = LABELS.zh

  const WL_KEY = 'sq_watchlist_v1'
  const A_KEY = 'sq_assump_v1'

  function fmt(n: number, d = 2): string {
    if (n == null || isNaN(n)) return '—'
    return n.toLocaleString('zh-CN', { minimumFractionDigits: d, maximumFractionDigits: d })
  }
  function toYi(yuan: number): string {
    return fmt(yuan / 1e8, 2)
  }
  function toWanShou(shares: number): string {
    return fmt(shares / 1e4, 1)
  }
  function esc(s: string): string {
    return String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] || c))
  }
  function r2(n: number): number {
    return Math.round(n * 100) / 100
  }
  function pct(x: number, cur: number): string {
    if (!cur) return '—'
    const p = (x / cur - 1) * 100
    return (p >= 0 ? '+' : '') + p.toFixed(1) + '%'
  }
  function parseNum(v: string): number {
    const n = parseFloat(v)
    return isNaN(n) ? 0 : n
  }
  function parseFcff(s: string): number[] {
    return String(s)
      .split(/[\s,]+/)
      .map((x) => parseFloat(x))
      .filter((x) => !isNaN(x) && x !== 0)
  }

  /* ---------- 自选列表 localStorage ---------- */
  function loadWatch(): { code: string; name: string; market: string }[] {
    try {
      return JSON.parse(localStorage.getItem(WL_KEY) || '[]')
    } catch {
      return []
    }
  }
  function saveWatch(list: { code: string; name: string; market: string }[]) {
    localStorage.setItem(WL_KEY, JSON.stringify(list))
  }
  function renderWatch(activeCode = '') {
    const box = document.getElementById('sq-watchlist')
    if (!box) return
    const list = loadWatch()
    if (!list.length) {
      box.innerHTML = `<div class='sq-watch-empty'>${L.watchEmpty}</div>`
      return
    }
    box.innerHTML = list
      .map(
        (w) =>
          `<span class='sq-chip ${w.code === activeCode ? 'active' : ''}' data-code='${esc(w.code)}' data-market='${esc(w.market)}'>
            <span class='nm'>${esc(w.name || w.code)}</span>
            <span class='cd'>${esc(w.code)}</span>
            <span class='x' data-x='${esc(w.code)}'>×</span>
          </span>`
      )
      .join('')
  }

  /* ---------- 估值假设 localStorage ---------- */
  interface Assump {
    eps: number
    bvps: number
    peLow: number
    peHigh: number
    pbLow: number
    pbHigh: number
    growth: number
    fcff: string
    wacc: number
    g: number
    netDebt: number
    method: string
  }
  function loadAssump(code: string): Assump | null {
    try {
      const all = JSON.parse(localStorage.getItem(A_KEY) || '{}')
      return all[code] || null
    } catch {
      return null
    }
  }
  function saveAssump(code: string, a: Assump) {
    try {
      const all = JSON.parse(localStorage.getItem(A_KEY) || '{}')
      all[code] = a
      localStorage.setItem(A_KEY, JSON.stringify(all))
    } catch {
      /* ignore */
    }
  }
  function defaultAssump(d: any): Assump {
    const pe = d.peTTM && d.peTTM > 0 ? d.peTTM : 0
    const pb = d.pb && d.pb > 0 ? d.pb : 0
    return {
      eps: pe > 0 ? r2(d.price / pe) : 0,
      bvps: pb > 0 ? r2(d.price / pb) : 0,
      peLow: pe > 0 ? r2(pe * 0.8) : 0,
      peHigh: pe > 0 ? r2(pe * 1.2) : 0,
      pbLow: pb > 0 ? r2(pb * 0.8) : 0,
      pbHigh: pb > 0 ? r2(pb * 1.2) : 0,
      growth: 12,
      fcff: '',
      wacc: 0.1,
      g: 0.025,
      netDebt: 0,
      method: 'all'
    }
  }

  /* ---------- 估值计算（与技能脚本一致） ---------- */
  function readAssumpFromDom(): Assump {
    const g = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value ?? ''
    return {
      eps: parseNum(g('sq_i_eps')),
      bvps: parseNum(g('sq_i_bvps')),
      peLow: parseNum(g('sq_i_peLow')),
      peHigh: parseNum(g('sq_i_peHigh')),
      pbLow: parseNum(g('sq_i_pbLow')),
      pbHigh: parseNum(g('sq_i_pbHigh')),
      growth: parseNum(g('sq_i_growth')),
      fcff: g('sq_i_fcff'),
      wacc: parseNum(g('sq_i_wacc')),
      g: parseNum(g('sq_i_g')),
      netDebt: parseNum(g('sq_i_netDebt')),
      method: (document.getElementById('sq_method') as HTMLSelectElement)?.value || 'all'
    }
  }

  function computeZone(d: any, a: Assump): { zone: Zone | null; pe: PeScenario | null; pb: PbScenario | null; dcf: { low: number; mid: number; high: number } | null } {
    const zones: Zone[] = []
    let pe: PeScenario | null = null
    let pb: PbScenario | null = null
    let dcf: { low: number; mid: number; high: number } | null = null
    if (a.eps > 0 && a.peLow > 0 && a.peHigh > 0 && d.totalShares > 0) {
      try {
        pe = peScenario(d.totalShares, a.eps * d.totalShares, a.peLow, a.peHigh)
        zones.push({ low: pe.low, mid: pe.mid, high: pe.high })
      } catch {
        pe = null
      }
    }
    if (a.bvps > 0 && a.pbLow > 0 && a.pbHigh > 0) {
      try {
        pb = pbScenario(a.bvps, a.pbLow, a.pbHigh)
        zones.push({ low: pb.low, mid: pb.mid, high: pb.high })
      } catch {
        pb = null
      }
    }
    const fcff = parseFcff(a.fcff)
    if (fcff.length && a.wacc > 0 && a.g < a.wacc && d.totalShares > 0) {
      try {
        dcf = dcfTrio(d.totalShares, fcff, a.wacc, a.g, a.netDebt)
        zones.push({ low: dcf.low, mid: dcf.mid, high: dcf.high })
      } catch {
        dcf = null
      }
    }
    let zone: Zone | null = null
    if (a.method === 'pe' && pe) zone = { low: pe.low, mid: pe.mid, high: pe.high }
    else if (a.method === 'pb' && pb) zone = { low: pb.low, mid: pb.mid, high: pb.high }
    else if (a.method === 'dcf' && dcf) zone = { low: dcf.low, mid: dcf.mid, high: dcf.high }
    else if (zones.length) zone = combineZones(zones)
    return { zone, pe, pb, dcf }
  }

  /* ---------- K线 + 估值区间 SVG ---------- */
  function candleSVG(kl: any[], L: any, zone: Zone | null, price: number): string {
    if (!kl || kl.length < 2) return ''
    const W = 900,
      Lm = 58,
      Rm = 12,
      T = 12
    const priceH = 150,
      gap = 22,
      volH = 46,
      B = 26
    const H = T + priceH + gap + volH + B
    const plotL = Lm,
      plotR = W - Rm,
      plotW = plotR - plotL
    const priceTop = T,
      priceBot = T + priceH
    const volTop = priceBot + gap,
      volBot = volTop + volH

    // y 轴范围纳入估值区间与现价
    let pAll: number[] = []
    kl.forEach((d) => {
      pAll.push(d.l, d.h)
    })
    if (zone) pAll.push(zone.low, zone.mid, zone.high)
    if (price) pAll.push(price)
    let minP = Math.min(...pAll)
    let maxP = Math.max(...pAll)
    const pad = (maxP - minP) * 0.08 || maxP * 0.05 || 1
    minP -= pad
    maxP += pad
    const span = maxP - minP || 1
    const yOf = (p: number) => priceTop + (1 - (p - minP) / span) * priceH

    const n = kl.length
    const slot = plotW / n
    const cw = Math.max(2, Math.min(slot * 0.62, 14))
    const vMax = Math.max(...kl.map((d) => d.v)) || 1

    // Y 轴网格 + 价格刻度
    let yaxis = ''
    const ticks = 5
    for (let i = 0; i < ticks; i++) {
      const p = minP + (span * i) / (ticks - 1)
      const y = yOf(p)
      yaxis += `<line class='sq-grid-line' x1='${plotL}' y1='${y.toFixed(1)}' x2='${plotR}' y2='${y.toFixed(1)}'/>
        <text class='sq-axis-txt' x='${plotL - 6}' y='${(y + 3.5).toFixed(1)}' text-anchor='end'>${fmt(p)}</text>`
    }

    // 估值区间色带 + 参考线（在蜡烛下方，作为背景）
    let bands = ''
    if (zone) {
      const yH = yOf(zone.high)
      const yL = yOf(zone.low)
      const yM = yOf(zone.mid)
      bands += `<rect x='${plotL}' y='${priceTop}' width='${plotW}' height='${Math.max(0, yH - priceTop).toFixed(1)}' fill='rgba(226,75,74,0.07)'/>`
      bands += `<rect x='${plotL}' y='${Math.min(yH, yL).toFixed(1)}' width='${plotW}' height='${Math.abs(yH - yL).toFixed(1)}' fill='rgba(212,172,55,0.10)'/>`
      bands += `<rect x='${plotL}' y='${yL.toFixed(1)}' width='${plotW}' height='${Math.max(0, priceBot - yL).toFixed(1)}' fill='rgba(63,166,106,0.07)'/>`
      const zline = (y: number, cls: string, label: string) =>
        `<line class='${cls}' x1='${plotL}' y1='${y.toFixed(1)}' x2='${plotR}' y2='${y.toFixed(1)}'/>
         <text class='sq-z-label' x='${plotR - 2}' y='${(y - 2.5).toFixed(1)}' text-anchor='end'>${label} ${fmt(y === yL ? zone.low : y === yM ? zone.mid : zone.high)}</text>`
      bands += zline(yH, 'sq-z-high', L.fairHigh)
      bands += zline(yM, 'sq-z-mid', L.fairMid)
      bands += zline(yL, 'sq-z-low', L.fairLow)
    }

    // 蜡烛 + 成交量柱
    let candles = '',
      vols = ''
    kl.forEach((d, i) => {
      const cx = plotL + (i + 0.5) * slot
      const up = d.c >= d.o
      const wCls = up ? 'sq-w-up' : 'sq-w-down'
      const bCls = up ? 'sq-c-up' : 'sq-c-down'
      const yO = yOf(d.o),
        yC = yOf(d.c),
        yH = yOf(d.h),
        yL = yOf(d.l)
      const top = Math.min(yO, yC)
      const bh = Math.max(Math.abs(yC - yO), 1)
      candles += `<line class='${wCls}' x1='${cx.toFixed(1)}' y1='${yH.toFixed(1)}' x2='${cx.toFixed(1)}' y2='${yL.toFixed(1)}'/>
        <rect class='${bCls}' x='${(cx - cw / 2).toFixed(1)}' y='${top.toFixed(1)}' width='${cw.toFixed(1)}' height='${bh.toFixed(1)}'/>`
      const vh = (d.v / vMax) * volH
      vols += `<rect class='${bCls}' x='${(cx - cw / 2).toFixed(1)}' y='${(volBot - vh).toFixed(1)}' width='${cw.toFixed(1)}' height='${vh.toFixed(1)}' opacity='0.55'/>`
    })

    // X 轴日期刻度
    let xlabels = ''
    const xticks = Math.min(6, n)
    for (let i = 0; i < xticks; i++) {
      const idx = Math.round((i * (n - 1)) / (xticks - 1))
      const d = kl[idx]
      const cx = plotL + (idx + 0.5) * slot
      const mmdd = String(d.t).slice(5)
      const anchor = i === 0 ? 'start' : i === xticks - 1 ? 'end' : 'middle'
      const tx = i === 0 ? plotL : i === xticks - 1 ? plotR : cx
      xlabels += `<text class='sq-axis-txt' x='${tx.toFixed(1)}' y='${(volBot + 16).toFixed(1)}' text-anchor='${anchor}'>${mmdd}</text>`
    }

    // 现价标记
    let curMark = ''
    if (price) {
      const y = yOf(price)
      curMark = `<line class='sq-z-cur' x1='${plotL}' y1='${y.toFixed(1)}' x2='${plotR}' y2='${y.toFixed(1)}'/>
        <text class='sq-z-label' x='${plotL}' y='${(y - 2.5).toFixed(1)}' text-anchor='start'>${L.curPrice ?? '现价'} ${fmt(price)}</text>`
    }

    return `<svg class='sq-kline' viewBox='0 0 ${W} ${H}' preserveAspectRatio='xMidYMid meet'>
      ${yaxis}
      ${bands}
      ${candles}
      ${vols}
      ${xlabels}
      ${curMark}
      <text class='sq-axis-txt' x='${plotL}' y='${priceTop - 2}'>${L.klineTitle}</text>
      <text class='sq-axis-txt' x='${plotR}' y='${(volTop - 7).toFixed(1)}' text-anchor='end'>VOL</text>
    </svg>`
  }

  /* ---------- 资金流向条 ---------- */
  function flowBars(ff: any, L: any): string {
    if (!ff) return `<div class='sq-empty'>${L.flowNA}</div>`
    const rows = [
      { lbl: L.huge, v: ff.huge },
      { lbl: L.big, v: ff.big },
      { lbl: L.mid, v: ff.mid },
      { lbl: L.small, v: ff.small }
    ]
    const max = Math.max(...rows.map((r) => Math.abs(r.v)), 1)
    const color = (v: number) => (v >= 0 ? 'var(--up)' : 'var(--down)')
    const sign = (v: number) => (v >= 0 ? '+' : '')
    const bars = rows
      .map((r) => {
        const w = (Math.abs(r.v) / max) * 100
        return `<div class='sq-bar-row'>
          <span class='lbl'>${r.lbl}</span>
          <div class='sq-bar-track'><div class='sq-bar-fill' style='width:${w.toFixed(1)}%;background:${color(r.v)}'></div></div>
          <span class='sq-bar-val ${r.v >= 0 ? 'up' : 'down'}'>${sign(r.v)}${toYi(r.v)}亿</span>
        </div>`
      })
      .join('')
    const mainCls = ff.main >= 0 ? 'up' : 'down'
    return `<div class='sq-flow'>${bars}
      <div class='sq-kv' style='margin-top:10px'><span class='k'>${L.main}</span><span class='v ${mainCls}'>${sign(ff.main)}${toYi(ff.main)}亿</span></div>
    </div>`
  }

