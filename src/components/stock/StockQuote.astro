---
interface Props {
  locale?: 'zh' | 'en'
}
const { locale = 'zh' } = Astro.props
---

<div class='stock-quote' data-locale={locale}>
    <form class='sq-search' id='sq-form'>
      <input
        id='sq-code'
        class='sq-input'
        inputmode='numeric'
        placeholder='000002 / 600519'
        autocomplete='off'
        value='000002'
      />
      <select id='sq-market' class='sq-select'>
        <option value='auto'>自动</option>
        <option value='sh'>沪市 A</option>
        <option value='sz'>深市 A</option>
        <option value='bj'>京市 A</option>
      </select>
      <button type='submit' class='sq-btn' id='sq-btn'>查询</button>
    </form>

    <div id='sq-status' class='sq-status' hidden></div>
    <div id='sq-result'></div>
  </div>

<style is:global>
  .stock-quote {
    --ink-1: #131210;
    --ink-2: #0b0a09;
    --gold: #d4ac37;
    --gold-bright: #ebc657;
    --cream: #f0eade;
    --muted: #9a948a;
    --up: #e24b4a; /* 涨 = 红 */
    --down: #3fa66a; /* 跌 = 绿 */
    --line: rgba(212, 172, 55, 0.22);
    max-width: 920px;
    margin: 0 auto;
    color: var(--cream);
    font-family:
      -apple-system, 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
  }
  .sq-search {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    background: var(--ink-1);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 18px;
  }
  .sq-input,
  .sq-select {
    background: #1b1916;
    color: var(--cream);
    border: 1px solid var(--line);
    border-radius: 9px;
    padding: 10px 12px;
    font-size: 14px;
    outline: none;
  }
  .sq-input {
    flex: 1;
    min-width: 160px;
  }
  .sq-select {
    width: 120px;
  }
  .sq-btn {
    background: linear-gradient(180deg, var(--gold-bright), var(--gold));
    color: #1a160c;
    border: none;
    border-radius: 9px;
    padding: 10px 22px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .sq-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* 自选列表 */
  .sq-watch {
    background: var(--ink-1);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 18px;
  }
  .sq-watch-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .sq-watch-title {
    color: var(--gold);
    font-size: 14px;
    font-weight: 600;
  }
  .sq-watch-hint {
    color: var(--muted);
    font-size: 11px;
  }
  .sq-watch-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sq-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #1b1916;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 10px 6px 14px;
    cursor: pointer;
    font-size: 13px;
    transition: border-color 0.15s, background 0.15s;
  }
  .sq-chip:hover {
    border-color: var(--gold);
    background: #211e16;
  }
  .sq-chip .nm {
    color: var(--cream);
  }
  .sq-chip .cd {
    color: var(--muted);
    font-size: 11px;
  }
  .sq-chip.active {
    border-color: var(--gold-bright);
    background: #2a2517;
  }
  .sq-chip .x {
    color: var(--muted);
    font-size: 14px;
    line-height: 1;
    padding: 0 2px;
    border-radius: 50%;
  }
  .sq-chip .x:hover {
    color: var(--up);
  }
  .sq-watch-empty {
    color: var(--muted);
    font-size: 12px;
    padding: 4px 2px 10px;
  }
  .sq-watch-add {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }
  .sq-watch-add .sq-input {
    min-width: 140px;
    flex: 0 1 220px;
  }
  .sq-watch-add .sq-btn {
    padding: 10px 16px;
  }

  .sq-status {
    text-align: center;
    color: var(--muted);
    padding: 24px;
    font-size: 14px;
  }
  .sq-status.err {
    color: var(--down);
  }

  /* hero */
  .sq-hero {
    background: var(--ink-1);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 22px 24px;
    margin-bottom: 18px;
  }
  .sq-hero-top {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .sq-name {
    font-size: 22px;
    font-weight: 600;
  }
  .sq-code {
    color: var(--muted);
    font-size: 13px;
  }
  .sq-tag {
    font-size: 11px;
    color: var(--gold);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 1px 7px;
  }
  .sq-addwatch {
    margin-left: auto;
    background: transparent;
    color: var(--gold);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    cursor: pointer;
  }
  .sq-addwatch:hover {
    border-color: var(--gold);
  }
  .sq-price-row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .sq-price {
    font-size: 40px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .sq-chg {
    font-size: 16px;
    font-variant-numeric: tabular-nums;
  }
  .sq-time {
    margin-left: auto;
    color: var(--muted);
    font-size: 12px;
  }
  .up {
    color: var(--up);
  }
  .down {
    color: var(--down);
  }

  .sq-kline-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 14px;
    font-size: 12px;
    color: var(--muted);
    flex-wrap: wrap;
    gap: 8px;
  }
  .sq-legend {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }
  .sq-legend .dot {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    display: inline-block;
    margin: 0 2px 0 8px;
  }
  .sq-legend .dot.up {
    background: var(--up);
  }
  .sq-legend .dot.down {
    background: var(--down);
  }
  .sq-legend .zdot {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    display: inline-block;
    margin: 0 2px 0 8px;
  }
  .sq-kline {
    margin-top: 6px;
    width: 100%;
    height: auto;
    display: block;
  }
  .sq-grid-line {
    stroke: var(--line);
    stroke-width: 1;
  }
  .sq-axis-txt {
    fill: var(--muted);
    font-size: 10px;
    font-family:
      -apple-system, 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
  }
  .sq-c-up {
    fill: var(--up);
  }
  .sq-c-down {
    fill: var(--down);
  }
  .sq-w-up {
    stroke: var(--up);
    stroke-width: 1;
  }
  .sq-w-down {
    stroke: var(--down);
    stroke-width: 1;
  }
  /* 估值区间线 */
  .sq-z-low {
    stroke: #4f9dde;
    stroke-width: 1.4;
    stroke-dasharray: 5 3;
  }
  .sq-z-mid {
    stroke: var(--gold-bright);
    stroke-width: 1.4;
    stroke-dasharray: 5 3;
  }
  .sq-z-high {
    stroke: #e07b53;
    stroke-width: 1.4;
    stroke-dasharray: 5 3;
  }
  .sq-z-cur {
    stroke: #ffffff;
    stroke-width: 1.2;
    stroke-dasharray: 2 2;
    opacity: 0.85;
  }
  .sq-z-label {
    fill: #cfc9bd;
    font-size: 9px;
    font-family:
      -apple-system, 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
  }

  .sq-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 18px;
  }
  .sq-cell {
    background: #17150f;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
  }
  .sq-cell .k {
    font-size: 12px;
    color: var(--muted);
  }
  .sq-cell .v {
    font-size: 15px;
    margin-top: 2px;
    font-variant-numeric: tabular-nums;
  }

  /* 估值面板（可折叠，默认收起） */
  .sq-val-details {
    background: var(--ink-1);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 16px 20px;
    margin-bottom: 18px;
  }
  .sq-val-summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    color: var(--gold);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .sq-val-summary::-webkit-details-marker {
    display: none;
  }
  .sq-val-summary small {
    color: var(--muted);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0;
  }
  .sq-val-summary::after {
    content: '▸';
    color: var(--muted);
    transition: transform 0.15s;
    flex: none;
  }
  .sq-val-details[open] .sq-val-summary::after {
    transform: rotate(90deg);
  }
  .sq-val-details[open] .sq-val-summary {
    margin-bottom: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .sq-val {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    margin-bottom: 0;
  }
  /* 锚定与变化说明 */
  .sq-anchor {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 14px;
    background: rgba(212, 172, 55, 0.04);
  }
  .sq-anchor-row {
    display: flex;
    gap: 10px;
    justify-content: space-between;
    align-items: baseline;
    font-size: 12px;
    padding: 3px 0;
  }
  .sq-anchor-row .k {
    color: var(--muted);
    flex: none;
  }
  .sq-anchor-row .v {
    text-align: right;
    color: var(--cream);
  }
  .sq-anchor-in {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 8px 0 4px;
  }
  .sq-val-chk {
    align-items: center;
  }
  .sq-val-chk input[type='checkbox'] {
    width: auto;
    accent-color: var(--gold);
  }
  .sq-change {
    margin-top: 8px;
    padding: 9px 11px;
    border-radius: 9px;
    font-size: 12px;
    line-height: 1.65;
    background: rgba(63, 166, 106, 0.1);
    border: 1px solid rgba(63, 166, 106, 0.3);
    color: #cfeee0;
  }
  .sq-chg-warn {
    background: rgba(226, 75, 74, 0.12);
    border-color: rgba(226, 75, 74, 0.38);
    color: #f6cfcf;
  }
  .sq-chg-edit {
    background: rgba(212, 172, 55, 0.1);
    border-color: var(--line);
    color: var(--cream);
  }
  .sq-chg-diffs {
    margin-top: 5px;
    font-weight: 600;
  }
  .sq-chg-rng {
    margin-top: 4px;
    color: var(--muted);
  }
  /* 常驻一行摘要 */
  .sq-anchor-brief {
    margin: 10px 0 14px;
    padding: 9px 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    font-size: 12px;
    color: var(--muted);
    background: var(--ink-1);
    line-height: 1.7;
  }
  .sq-anchor-brief b {
    color: var(--cream);
  }
  .sq-brief-warn {
    color: var(--up);
  }
  .sq-brief-na {
    color: var(--muted);
  }
  .sq-val h3 {
    font-size: 14px;
    color: var(--gold);
    font-weight: 600;
    margin: 0 0 4px;
    letter-spacing: 0.04em;
  }
  .sq-val .sq-val-sub {
    color: var(--muted);
    font-size: 11px;
    margin-bottom: 14px;
  }
  .sq-method {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .sq-method button {
    background: #1b1916;
    border: 1px solid var(--line);
    color: var(--cream);
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 13px;
    cursor: pointer;
  }
  .sq-method button.active {
    background: var(--gold);
    color: #1a160c;
    border-color: var(--gold);
    font-weight: 600;
  }
  .sq-val-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .sq-val-block {
    background: #17150f;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 16px;
  }
  .sq-val-block h4 {
    font-size: 13px;
    margin: 0 0 10px;
    color: var(--cream);
  }
  .sq-val-in {
    display: grid;
    grid-template-columns: 1fr 96px;
    gap: 6px 10px;
    align-items: center;
    margin-bottom: 8px;
  }
  .sq-val-in label {
    font-size: 12px;
    color: var(--muted);
  }
  .sq-val-in input {
    background: #1b1916;
    color: var(--cream);
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 6px 8px;
    font-size: 13px;
    width: 100%;
    outline: none;
    font-variant-numeric: tabular-nums;
  }
  .sq-val-out {
    margin-top: 6px;
    border-top: 1px dashed var(--line);
    padding-top: 8px;
  }
  .sq-val-out .row {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    padding: 3px 0;
  }
  .sq-val-out .row .k {
    color: var(--muted);
  }
  .sq-val-out .row .v {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .sq-val-zone {
    grid-column: 1 / -1;
    background: #17150f;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 16px;
  }
  .sq-val-zone .zrow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    padding: 4px 0;
  }
  .sq-val-zone .zrow .lbl {
    color: var(--muted);
  }
  .sq-val-zone .zrow .num {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .sq-val-verdict {
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 9px;
    font-size: 13px;
    line-height: 1.5;
  }
  .sq-v-under {
    background: rgba(63, 166, 106, 0.14);
    color: #8fe0b0;
  }
  .sq-v-fair {
    background: rgba(212, 172, 55, 0.14);
    color: var(--gold-bright);
  }
  .sq-v-over {
    background: rgba(226, 75, 74, 0.14);
    color: #f0a09f;
  }
  .sq-val-actions {
    margin-top: 12px;
    display: flex;
    gap: 10px;
  }
  .sq-val-actions button {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--muted);
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    cursor: pointer;
  }
  .sq-val-actions button:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  details.sq-dcf {
    grid-column: 1 / -1;
    margin-top: 4px;
  }
  details.sq-dcf summary {
    cursor: pointer;
    color: var(--gold);
    font-size: 13px;
    padding: 6px 0;
  }
  .sq-dcf .sq-val-sub {
    margin: 6px 0 10px;
  }
  .sq-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 18px;
  }
  .sq-card {
    background: var(--ink-1);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px 20px;
  }
  .sq-card h3 {
    font-size: 14px;
    color: var(--gold);
    font-weight: 600;
    margin: 0 0 14px;
    letter-spacing: 0.04em;
  }
  .sq-kv {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    padding: 6px 0;
    border-bottom: 1px dashed var(--line);
  }
  .sq-kv:last-child {
    border-bottom: none;
  }
  .sq-kv .k {
    color: var(--muted);
  }
  .sq-kv .v {
    font-variant-numeric: tabular-nums;
  }

  .sq-empty {
    margin-top: 8px;
    padding: 18px 16px;
    color: var(--muted);
    font-size: 13px;
    text-align: center;
    background: #17150f;
    border: 1px dashed var(--line);
    border-radius: 10px;
  }
  .sq-empty-kline {
    padding: 54px 16px;
  }
  .sq-flow {
    margin-top: 6px;
  }
  .sq-bar-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 9px 0;
    font-size: 13px;
  }
  .sq-bar-row .lbl {
    width: 56px;
    color: var(--muted);
  }
  .sq-bar-track {
    flex: 1;
    height: 10px;
    background: #17150f;
    border-radius: 6px;
    overflow: hidden;
  }
  .sq-bar-fill {
    height: 100%;
    border-radius: 6px;
  }
  .sq-bar-val {
    width: 84px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .sq-foot {
    margin-top: 22px;
    color: var(--muted);
    font-size: 11px;
    text-align: center;
    line-height: 1.6;
  }
  @media (max-width: 680px) {
    .sq-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .sq-cols {
      grid-template-columns: 1fr;
    }
    .sq-val-grid {
      grid-template-columns: 1fr;
    }
    .sq-price {
      font-size: 32px;
    }
  }
</style>

<script>
  import {
    peScenario,
    pbScenario,
    pegCheck,
    dcfTrio,
    combineZones,
    bandOf,
    deriveFundamentals,
    deriveBands,
    relChange,
    type PeScenario,
    type PbScenario,
    type Zone,
    type Fundamentals,
    type AnchorKind
  } from '../../lib/valuation'

  const LABELS = {
    zh: {
      search: '查询',
