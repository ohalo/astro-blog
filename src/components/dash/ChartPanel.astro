---
/**
 * ChartPanel —— ③主图工作台：六周期(分时/五日/日/周/月/年) + MA 多选 + 区间快捷 + 侧栏联动。
 * 实时版：日/周/月/年 K线来自 /api/stock 的 250 日日线（周/月/年前端聚合）；
 * 分时/五日走 /api/stock-minute 实时代理；量化指标前端基于日线实时计算。
 * 切换股票：监听文档 dash:select 事件（WatchList 派发），并刷新右侧 SidePanels。
 */
interface Props {
  initialCode?: string
}
const { initialCode = '600519' } = Astro.props
---

<div class='qd-card qd-panel' id='qk-panel' data-init={initialCode}>
  <div class='qd-phead'>
    <svg class='qd-pico' viewBox='0 0 24 24' width='18' height='18' aria-hidden='true'><path fill='currentColor' d='M3 3h2v18H3zm0 15h18v2H3zm15.5-7.4-3.1-3.1-3.6 3.6-2.4-2.4-3 3 1.4 1.4 1.6-1.6 2.4 2.4 3.6-3.6 1.7 1.7z'/></svg>
    <span class='nm' id='h-name'>--</span>
    <span class='cd num' id='h-code'></span>
    <span class='bigpx num' id='h-price'></span>
    <span class='bigchg num' id='h-chg'></span>
    <span class='qd-badge' id='h-badge'></span>
    <span class='qd-pdate num' id='h-date'></span>
  </div>
  <div class='qd-toolbar'>
    <span class='seg' id='seg-period'>
      <button data-p='min1'>分时</button><button data-p='min5'>五日</button>
      <button data-p='d' class='on'>日K</button><button data-p='w'>周K</button>
      <button data-p='m'>月K</button><button data-p='y'>年K</button>
    </span>
    <span id='ma-chips'></span>
    <span class='seg qd-range' id='seg-range'>
      <button data-r='21'>1月</button><button data-r='63'>3月</button><button data-r='126'>6月</button>
      <button data-r='250' class='on'>1年</button><button data-r='750'>3年</button><button data-r='0'>全部</button>
    </span>
  </div>
  <div id='kchart' role='img' aria-label='K线图表：价格、均线与成交量'><div class='qd-loading'>加载 K线…</div></div>
  <div class='qd-pfoot'><span id='fn-l'></span><span id='fn-r'></span></div>
  <div class='qd-keys'>
    <span><kbd>1</kbd>–<kbd>6</kbd> 周期</span>
    <span><kbd>←</kbd><kbd>→</kbd> 切股</span>
    <span><kbd>/</kbd> 搜索</span>
    <button class='qd-keys-toggle' id='qk-keys-toggle' title='隐藏快捷键提示' aria-label='隐藏快捷键提示'>×</button>
  </div>
</div>

<script>
  import * as echarts from 'echarts/core'
  import { BarChart, CandlestickChart, LineChart } from 'echarts/charts'
  import { AxisPointerComponent, DataZoomComponent, GridComponent, TooltipComponent } from 'echarts/components'
  import { CanvasRenderer } from 'echarts/renderers'
  echarts.use([CandlestickChart, BarChart, LineChart, GridComponent, TooltipComponent, DataZoomComponent, AxisPointerComponent, CanvasRenderer])

  interface Bar { t: string; o: number; h: number; l: number; c: number; v: number }
  interface Quote {
    code: string; name: string; market: string; price: number; prevClose: number; open: number
    high: number; low: number; change: number; changePct: number; volume: number; amount: number
    turnover: number; pb: number; peTTM: number | null; volumeRatio: number
    week52High: number | null; week52Low: number | null; time: string; kline: Bar[]
  }
  interface Payload {
    code: string; name: string; market: string
    meta: { price: number; prevClose: number; open: number; high: number; low: number; chg?: number | null; chgPct?: number | null; volume: number; amount: number; turn: number; pe: number | null; pb: number | null }
    stats: { hi52: number | null; lo52: number | null; avgVol5: number | null; volRatio: number | null; vol20Ann: number | null; mom20: number | null; ddFromHi52: number | null; pePct: null; rsi: number | null; atrPct: number | null; mdd: number | null; sharpe: number | null; ma5: number | null; ma10: number | null; ma20: number | null; maBull: boolean | null }
    kline: Bar[] // 日线（已含 ohlcv），周/月/年由前端聚合
  }
  interface MinuteResp { code: string; period: string; prevClose: number | null; date: string | null; pts: { t: string; p: number; v: number }[]; error?: string }

  /* ---------- 把 /api/stock 实时报价 + 日线 折算成 /dash 内部 Payload ---------- */
  function toPayload(q: Quote): Payload {
    // 只保留收盘价有效的K线，且以它们为准计算 n（避免过滤后索引错位导致 NaN）
    const bars = q.kline.filter((k) => Number.isFinite(k.c) && k.c > 0)
    const closes = bars.map((k) => k.c)
    const n = bars.length
    const w52 = bars.slice(-Math.min(242, n))
    const hi52 = w52.length ? Math.max(...w52.map((k) => k.h)) : (q.week52High ?? null)
    const lo52 = w52.length ? Math.min(...w52.map((k) => k.l)) : (q.week52Low ?? null)
    const avgVol5 = n >= 6 ? bars.slice(-6, -1).reduce((a, k) => a + k.v, 0) / 5 : null
    const last = bars[n - 1], prev = bars[n - 2]
    const volRatio = last && avgVol5 ? last.v / avgVol5 : (q.volumeRatio || null)
    const rets: number[] = []
    for (let i = Math.max(1, n - 21); i < n; i++) {
      const a = Math.log(closes[i]), b = Math.log(closes[i - 1]); rets.push(a - b)
    }
    const mu = rets.length ? rets.reduce((a, b) => a + b, 0) / rets.length : 0
    const vol20Ann = rets.length > 5 ? Math.sqrt(rets.reduce((a, b) => a + (b - mu) ** 2, 0) / (rets.length - 1)) * Math.sqrt(242) : null
    const mom20 = n > 21 ? closes[n - 1] / closes[n - 21] - 1 : null
    const dd = hi52 ? closes[n - 1] / Math.max(hi52, 1e-9) - 1 : null
    // q.time 形如 'YYYYMMDDHHMMSS'，折算交易日；缺失时回退到末根 K线日期
    const tradeDate = q.time && q.time.length >= 8 ? `${q.time.slice(0, 4)}-${q.time.slice(4, 6)}-${q.time.slice(6, 8)}` : (bars[n - 1]?.t ?? null)

    /* ---------- 进阶指标：RSI(14) / ATR(14) / 最大回撤 / 夏普 / 均线多头排列 ---------- */
    // RSI(14)：Wilder 平滑
    let rsi: number | null = null
    if (n >= 15) {
      let gain = 0, loss = 0
      for (let i = n - 14; i < n; i++) { const d = closes[i] - closes[i - 1]; if (d >= 0) gain += d; else loss -= d }
      gain /= 14; loss /= 14
      for (let i = n - 14; i < n; i++) {
        const d = closes[i] - closes[i - 1]
        gain = (gain * 13 + Math.max(d, 0)) / 14
        loss = (loss * 13 + Math.max(-d, 0)) / 14
      }
      rsi = loss === 0 ? 100 : +(100 - 100 / (1 + gain / loss)).toFixed(1)
    }
    // ATR(14)：真实波幅均值（占价格百分比）
    let atrPct: number | null = null
    if (n >= 15) {
      const trs: number[] = []
      for (let i = 1; i < n; i++) {
        const k = bars[i], pk = bars[i - 1].c
        trs.push(Math.max(k.h - k.l, Math.abs(k.h - pk), Math.abs(k.l - pk)))
      }
      const tr = trs.slice(-14).reduce((a, b) => a + b, 0) / 14
      atrPct = closes[n - 1] ? +((tr / closes[n - 1]) * 100).toFixed(2) : null
    }
    // 区间最大回撤（近 250 日）
    let mdd: number | null = null
    if (n >= 20) {
      let peak = -Infinity, worst = 0
      for (const c of closes) { if (c > peak) peak = c; const dd = c / peak - 1; if (dd < worst) worst = dd }
      mdd = +(worst * 100).toFixed(1)
    }
    // 夏普比率（近 60 日，无风险利率按 0 计）
    let sharpe: number | null = null
    if (n >= 31) {
      const from = Math.max(1, n - 60)
      const win: number[] = []
      for (let i = from; i < n; i++) {
        const prevC = closes[i - 1]
        if (Number.isFinite(prevC) && prevC > 0) win.push(closes[i] / prevC - 1)
      }
      if (win.length >= 20) {
        const mm = win.reduce((a, b) => a + b, 0) / win.length
        const sd = Math.sqrt(win.reduce((a, b) => a + (b - mm) ** 2, 0) / (win.length - 1))
        if (sd > 0) sharpe = +((mm / sd) * Math.sqrt(242)).toFixed(2)
      }
    }
    // 均线多头排列：MA5 > MA10 > MA20
    const maOf = (d: number) => (n >= d ? +(closes.slice(-d).reduce((a, b) => a + b, 0) / d).toFixed(3) : null)
    const ma5 = maOf(5), ma10 = maOf(10), ma20 = maOf(20)
    const maBull = ma5 != null && ma10 != null && ma20 != null ? ma5 > ma10 && ma10 > ma20 : null

    return {
      code: q.code, name: q.name, market: q.market, tradeDate,
      meta: {
        price: q.price, prevClose: q.prevClose, open: q.open, high: q.high, low: q.low,
        chg: q.change, chgPct: q.changePct,
        volume: q.volume, amount: q.amount, turn: q.turnover, pe: q.peTTM, pb: q.pb
      },
      stats: {
        hi52, lo52, avgVol5: avgVol5 ? Math.round(avgVol5) : null, volRatio,
        vol20Ann: vol20Ann == null ? null : +vol20Ann.toFixed(4),
        mom20: mom20 == null ? null : +mom20.toFixed(4),
        ddFromHi52: dd == null ? null : +dd.toFixed(4),
        pePct: null,
        rsi, atrPct, mdd, sharpe, ma5, ma10, ma20, maBull
      },
      kline: bars
    }
  }

  /* ---------- 周/月/年 聚合（与发布器口径一致：周=周一, 月=月末, 年=年末） ---------- */
  function agg(bars: Bar[], keyFn: (t: string) => string): Bar[] {
    const out: Bar[] = []; let cur: Bar | null = null; let key = ''
    for (const b of bars) {
      const k = keyFn(b.t)
      if (k !== key) { key = k; cur = { t: b.t, o: b.o, h: b.h, l: b.l, c: b.c, v: b.v }; out.push(cur) }
      else if (cur) { cur.h = Math.max(cur.h, b.h); cur.l = Math.min(cur.l, b.l); cur.c = b.c; cur.v += b.v; cur.t = b.t }
    }
    return out
  }
  const weekKey = (t: string) => { const d = new Date(t + 'T00:00:00'); d.setDate(d.getDate() - ((d.getDay() + 6) % 7)); return d.toISOString().slice(0, 10) }
  function periodsFor(p: Payload) {
    return {
      d: p.kline,
      w: agg(p.kline, weekKey),
      m: agg(p.kline, (t) => t.slice(0, 7)),
      y: agg(p.kline, (t) => t.slice(0, 4))
    }
  }

  const panel = document.getElementById('qk-panel')!
  const MA_OPTS: Record<string, number[]> = { d: [5, 10, 20, 60], w: [5, 10, 20, 30], m: [5, 12, 24], y: [3, 5] }
  const MA_DEF: Record<string, number[]> = { d: [20, 60], w: [20, 30], m: [12, 24], y: [3, 5] }
  const MA_COLS = ['hsl(45 72% 55%)', 'hsl(212 80% 62%)', 'hsl(262 70% 68%)', 'hsl(188 80% 55%)']

  const f2 = (n: number | null | undefined, d = 2) => (n == null || isNaN(n as number) ? '--' : (n as number).toLocaleString('zh-CN', { minimumFractionDigits: d, maximumFractionDigits: d }))
  const pct = (n: number | null | undefined, d = 2) => (n == null || isNaN(n as number) ? '--' : `${((n as number) * 100).toFixed(d)}%`)
  const volHand = (h?: number | null) => (h == null ? '--' : h >= 1e4 ? `${(h / 1e4).toFixed(2)} 亿手` : `${Math.round(h).toLocaleString('zh-CN')} 万手`)
  const cssv = (n: string) => getComputedStyle(document.documentElement).getPropertyValue(n).trim()
  const C = () => ({
    up: cssv('--qk-up') || '#f16a6a', down: cssv('--qk-down') || '#3fba85', gold: cssv('--qk-gold') || 'hsl(45 68% 51%)',
    text: cssv('--muted-foreground') ? `hsl(${cssv('--muted-foreground')})` : '#9aa3b2',
    border: cssv('--border') ? `hsl(${cssv('--border')})` : '#2b2f38',
    card: cssv('--card') ? `hsl(${cssv('--card')})` : '#171a20'
  })

  const state = { code: (window as any).__qkActive || panel.dataset.init || '600519', period: 'd', ma: [...MA_DEF.d], range: 250 }
  let payload: Payload | null = null
  let chart: echarts.ECharts | null = null
  let minuteCache: { key: string; at: number; data: MinuteResp } | null = null

  const $ = (id: string) => document.getElementById(id)!
  async function fetchJSON(url: string): Promise<any> {
    const r = await fetch(url, { signal: AbortSignal.timeout(8000) })
    if (!r.ok) throw new Error(String(r.status))
    return r.json()
  }

  /* ---------- 头部与右侧 SidePanels（与 SidePanels.astro 的 id 契约一致） ---------- */
  function renderHead() {
    if (!payload) return
    const m = payload.meta
    $('h-name').textContent = payload.name ?? payload.code
    $('h-code').textContent = `${payload.code}`
    $('h-date').textContent = `交易日 ${payload.tradeDate}`
    const k = m.price == null ? '--' : f2(m.price)
    $('h-price').textContent = k
    $('h-price').className = `bigpx num ${m.chg! > 0 ? 'up' : m.chg! < 0 ? 'down' : 'flat'}`
    $('h-chg').innerHTML = m.chg == null ? '' : `${m.chg >= 0 ? '+' : ''}${f2(m.chg)}&nbsp;${m.chgPct! >= 0 ? '+' : ''}${f2(m.chgPct)}%`
    $('h-chg').className = `bigchg num ${m.chg! > 0 ? 'up' : m.chg! < 0 ? 'down' : 'flat'}`
  }
  const kv = (rows: [string, string, string?][]) =>
    rows.map(([k, v, c]) => `<span class="k">${k}</span><span class="v num ${c ?? ''}">${v}</span>`).join(' ')

  function renderSide() {
    if (!payload) return
    const { meta: m, stats: s } = payload
    $('ka-price').innerHTML = kv([['昨收', f2(m.prevClose)], ['今开', f2(m.open)], ['最高', f2(m.high), 'up'], ['最低', f2(m.low), 'down'],
      ['成交量', volHand(m.volume)], ['成交额', m.amount == null ? '--' : m.amount >= 1e8 ? `${(m.amount / 1e8).toFixed(2)} 亿元` : `${(m.amount / 1e4).toFixed(0)} 万元`], ['换手率', m.turn == null ? '--' : `${m.turn.toFixed(2)}%`]])
    const pos = s.hi52 != null && s.lo52 != null && m.price != null ? Math.min(100, Math.max(0, ((m.price - s.lo52) / ((s.hi52 as number) - (s.lo52 as number) || 1)) * 100)) : null
    // 结论前置：基于价/量/位/势给一句实时定性（红涨绿跌配色）
    const verdict: [string, string?] = (() => {
      if (m.price == null || s.volRatio == null) return ['—']
      const upToday = (m.chg ?? 0) >= 0
      const volBig = (s.volRatio as number) > 1.2
      if (upToday && volBig) return ['放量上行', 'up']
      if (!upToday && volBig) return ['放量下挫', 'down']
      if (upToday && !volBig) return ['缩量企稳', 'up']
      if (!upToday && !volBig) return ['缩量回调', 'down']
      return ['—']
    })()
    const nearHi = pos != null && pos >= 80
    const vEl = $('ka-verdict')
    vEl.innerHTML = `<span class='qd-vtag ${verdict[1] ?? ''}'>${verdict[0]}</span>${pos != null ? `<span class='qd-vsub'>52周 ${pos.toFixed(0)}% 分位${nearHi ? '·近高' : ''}</span>` : ''}`
    $('pos-dot').style.left = `${pos ?? 50}%`
    $('pos-lo').textContent = `低 ${s.lo52 == null ? '--' : f2(s.lo52)}`
    $('pos-hi').textContent = `高 ${s.hi52 == null ? '--' : f2(s.hi52)}`
    $('pos-pct').textContent = pos == null ? '--' : `${pos.toFixed(0)}% 分位`
    $('ka-vol').innerHTML = kv([['量比(对5日均量)', s.volRatio == null ? '--' : f2(s.volRatio), s.volRatio != null && s.volRatio > 1.2 ? 'up' : ''], ['5日均量', volHand(s.avgVol5)]])
    $('ka-vola').innerHTML = kv([['20日年化波动', pct(s.vol20Ann, 1)], ['20日动量', pct(s.mom20, 1), (s.mom20 ?? 0) >= 0 ? 'up' : 'down'], ['距52周高点', pct(s.ddFromHi52, 1), 'down']])
    // 技术指标：RSI / ATR / 最大回撤 / 夏普 / 均线排列
    $('ka-tech').innerHTML = kv([
      ['RSI(14)', s.rsi == null ? '--' : s.rsi.toFixed(1), s.rsi == null ? '' : s.rsi >= 70 ? 'up' : s.rsi <= 30 ? 'down' : ''],
      ['ATR(14)/价格', s.atrPct == null ? '--' : `${s.atrPct.toFixed(2)}%`],
      ['250日最大回撤', s.mdd == null ? '--' : `${s.mdd.toFixed(1)}%`, 'down'],
      ['60日夏普', s.sharpe == null ? '--' : s.sharpe.toFixed(2), (s.sharpe ?? 0) >= 0 ? 'up' : 'down'],
      ['均线排列', s.maBull == null ? '--' : s.maBull ? '多头排列' : '空头排列', s.maBull ? 'up' : 'down']
    ])
    // RSI 量表指针
    const gauge = $('ka-rsi-gauge')
    if (s.rsi == null) { gauge.hidden = true }
    else {
      gauge.hidden = false
      ;($('ka-rsi-mark') as HTMLElement).style.left = `${Math.min(100, Math.max(0, s.rsi))}%`
      ;($('ka-rsi-val') as HTMLElement).textContent = s.rsi.toFixed(1)
    }
    $('ka-pe').innerHTML = kv([['PE-TTM', m.pe == null ? '--' : (m.pe as number).toFixed(2)], ['PB', m.pb == null ? '--' : (m.pb as number).toFixed(2)], ['PE历史分位', s.pePct == null ? '实时无' : pct(s.pePct, 1)]])
  }

  /* ---------- 图表 ---------- */
  function maLines(k: Bar[]) {
    const days = MA_OPTS[state.period] || []
    $('ma-chips').innerHTML = days.map((d) => {
      const on = state.ma.includes(d)
      const col = MA_COLS[days.indexOf(d)]
      return `<button class="qchip ${on ? 'on' : ''}" data-ma="${d}" style="${on ? `color:${col}` : ''}"><i style="background:${col}"></i>MA${d}</button>`
    }).join('')
    return days.filter((d) => state.ma.includes(d)).map((d) => {
      const arr = k.map((_, i) => (i < d - 1 ? null : +(k.slice(i - d + 1, i + 1).reduce((a, x) => a + x.c, 0) / d).toFixed(3)))
      return { name: `MA${d}`, type: 'line' as const, data: arr, showSymbol: false, smooth: true, emphasis: { disabled: true } as any,
        lineStyle: { width: 1.1, color: MA_COLS[days.indexOf(d)] }, z: 3 }
    })
  }

  function candleOption(k: Bar[]) {
    const c = C()
    return {
      animation: false, textStyle: { color: c.text, fontSize: 11 },
      tooltip: { trigger: 'axis', axisPointer: { type: 'cross' }, confine: true, backgroundColor: c.card, borderColor: c.border, textStyle: { color: cssv('--foreground') ? `hsl(${cssv('--foreground')})` : '#e6e8ec', fontSize: 12 },
        formatter(ps: any) {
          const p = (Array.isArray(ps) ? ps : []).find((x) => x.seriesType === 'candlestick')
          if (!p) return ''
          const d = k[p.dataIndex]; const prev = p.dataIndex > 0 ? k[p.dataIndex - 1].c : d.o
          const g = (d.c / prev - 1) * 100
          return `<b>${d.t}</b><br/>开 ${f2(d.o)}　高 <b style="color:${c.up}">${f2(d.h)}</b><br/>收 <b style="color:${g >= 0 ? c.up : c.down}">${f2(d.c)}</b>（${g >= 0 ? '+' : ''}${f2(g)}%）<br/>低 <b style="color:${c.down}">${f2(d.l)}</b>　量 ${f2(d.v / 1e4)} 万手`
        } },
      axisPointer: { link: [{ xAxisIndex: 'all' }] },
      grid: [{ left: 64, right: 14, top: 12, height: '60%' }, { left: 64, right: 14, top: '78%', height: '14%' }],
      dataZoom: [{ type: 'inside', xAxisIndex: [0, 1] }],
      xAxis: [
        { type: 'category', data: k.map((d) => d.t), boundaryGap: true, axisLabel: { color: c.text }, axisLine: { lineStyle: { color: c.border } }, axisTick: { show: false }, splitLine: { show: false } },
        { gridIndex: 1, type: 'category', data: k.map(() => ''), axisLabel: { show: false }, axisTick: { show: false }, axisLine: { lineStyle: { color: c.border } } }
      ],
      yAxis: [
        { scale: true, axisLabel: { color: c.text, formatter: (v: number) => v.toFixed(2) }, splitLine: { lineStyle: { color: c.border } }, axisLine: { show: false }, axisTick: { show: false } },
        { gridIndex: 1, axisLabel: { show: false }, splitLine: { show: false }, axisLine: { show: false }, axisTick: { show: false } }
      ],
      series: [
        { type: 'candlestick', data: k.map((d) => [d.o, d.c, d.l, d.h]), emphasis: { disabled: true } as any, itemStyle: { color: c.up, color0: c.down, borderColor: c.up, borderColor0: c.down } },
        ...maLines(k),
        { type: 'bar', xAxisIndex: 1, yAxisIndex: 1, data: k.map((d) => ({ value: d.v, itemStyle: { color: d.c >= d.o ? 'rgba(241,106,106,.5)' : 'rgba(63,186,133,.5)' } })) }
      ]
    }
  }

  function minuteOption(pts: { t: string; p: number; v: number }[], base: number) {
    const c = C()
    // 累计均价（VWAP）：分时为当日累计；五日按日重置，避免跨日累加失真
    const avg: (number | null)[] = []
    if (state.period === 'min1') {
      let pv = 0, vv = 0
      for (const q of pts) { pv += q.p * q.v; vv += q.v; avg.push(vv > 0 ? +(pv / vv).toFixed(3) : null) }
    } else {
      let pv = 0, vv = 0, day = ''
      for (const q of pts) {
        const d = q.t.slice(0, 5)
        if (d !== day) { day = d; pv = 0; vv = 0 }
        pv += q.p * q.v; vv += q.v
        avg.push(vv > 0 ? +(pv / vv).toFixed(3) : null)
      }
    }
    return {
      animation: false, textStyle: { color: c.text, fontSize: 11 },
      tooltip: { trigger: 'axis', confine: true, backgroundColor: c.card, borderColor: c.border, textStyle: { color: '#e6e8ec', fontSize: 12 },
        formatter(ps: any) {
          const arr = Array.isArray(ps) ? ps : []
          const p = arr.find((x) => x.seriesType === 'line' && x.seriesName === '价')
          const a = arr.find((x) => x.seriesType === 'line' && x.seriesName === '均价')
          if (!p) return ''
          const q = pts[p.dataIndex]
          const av = a && a.data != null ? a.data : null
          return `${state.period === 'min5' ? q.t : `09:30起 ${q.t}`}<br/>价格 <b>${f2(q.p)}</b>（${((q.p / base - 1) * 100).toFixed(2)}%）<br/>均价 ${av == null ? '--' : f2(av)}<br/>分钟量 ${f2(q.v / 100)} 手`
        } },
      axisPointer: { link: [{ xAxisIndex: 'all' }] },
      grid: [{ left: 64, right: 14, top: 12, height: '60%' }, { left: 64, right: 14, top: '78%', height: '14%' }],
      xAxis: [
        { type: 'category', data: pts.map((p) => p.t), boundaryGap: false, axisLabel: { color: c.text, interval: Math.max(1, Math.floor(pts.length / 7)) }, axisLine: { lineStyle: { color: c.border } }, axisTick: { show: false }, splitLine: { show: true, lineStyle: { color: c.border, type: 'dashed' } } },
        { gridIndex: 1, type: 'category', data: pts.map(() => ''), axisLabel: { show: false }, axisTick: { show: false }, axisLine: { lineStyle: { color: c.border } } }
      ],
      yAxis: [
        { min: (v: any) => Math.floor(Math.min(v.min, base) * 99.6) / 100, max: (v: any) => Math.ceil(Math.max(v.max, base) * 100.4) / 100,
          axisLabel: { color: c.text, formatter: (v: number) => v.toFixed(2) }, splitLine: { lineStyle: { color: c.border } }, axisLine: { show: false }, axisTick: { show: false } },
        { gridIndex: 1, axisLabel: { show: false }, splitLine: { show: false }, axisLine: { show: false }, axisTick: { show: false } }
      ],
      series: [
        { name: '价', type: 'line', data: pts.map((p) => p.p), showSymbol: false, emphasis: { disabled: true } as any, lineStyle: { width: 1.2, color: c.gold }, areaStyle: { color: 'hsla(45,70%,55%,.06)' } },
        { name: '均价', type: 'line', data: avg, showSymbol: false, emphasis: { disabled: true } as any, connectNulls: true, lineStyle: { width: 1, color: 'hsl(212 80% 62%)' } },
        { name: 'base', type: 'line', data: pts.map(() => base), showSymbol: false, emphasis: { disabled: true } as any, lineStyle: { width: 1, type: 'dashed', color: c.text } },
        { type: 'bar', xAxisIndex: 1, yAxisIndex: 1, data: pts.map((p) => ({ value: p.v, itemStyle: { color: p.p >= base ? 'rgba(241,106,106,.45)' : 'rgba(63,186,133,.45)' } })) }
      ]
    }
  }

  async function render() {
    const el = $('kchart')
    if (!chart) { el.innerHTML = ''; chart = echarts.init(el); new ResizeObserver(() => chart!.resize()).observe(el) }
    if (['min1', 'min5'].includes(state.period)) {
      $('seg-range').style.visibility = 'hidden'
      $('ma-chips').innerHTML = ''
      const key = `${state.code}:${state.period}`
      if (!minuteCache || minuteCache.key !== key || Date.now() - minuteCache.at > 60000) {
        try { minuteCache = { key, at: Date.now(), data: await fetchJSON(`/api/stock-minute?code=${state.code}&period=${state.period === 'min5' ? '5' : '1'}`) } }
        catch (e: any) { $('fn-r').innerHTML = `<span class="warn">⚠ 分钟数据获取失败：${e?.message}</span>`; $('h-badge').textContent = '实时·降级'; $('h-badge').className = 'qd-badge demo'; return }
      }
      const d = minuteCache.data
      if (!d.pts.length) { $('fn-r').innerHTML = `<span class="warn">⚠ ${d.error || '暂无分钟数据'}</span>`; chart.clear(); return }
      const base = d.prevClose ?? d.pts[0].p
      chart.setOption(minuteOption(d.pts, base), true)
      $('h-badge').textContent = '实时'; $('h-badge').className = 'qd-badge real'
      $('fn-r').innerHTML = `腾讯分钟行情 · ${d.date ?? ''}${new Date().getHours() >= 9 && new Date().getHours() <= 15 && new Date().getDay() <= 5 ? ' 盘中' : ' 收盘快照'}`
      return
    }
    $('seg-range').style.visibility = 'visible'
    if (!payload) return
    const per = periodsFor(payload)
    let k = per[state.period as 'd' | 'w' | 'm' | 'y'] || per.d
    if (state.range) k = k.slice(-state.range)
    chart.setOption(candleOption(k), true)
    $('h-badge').textContent = '未复权'; $('h-badge').className = 'qd-badge'
    $('h-badge').classList.add('real')
    $('fn-r').textContent = `${k.length} 根 · 滚轮缩放/拖拽平移`
  }

  async function select(code: string) {
    state.code = code
    $('fn-r').textContent = ''; $('fn-l').textContent = ''
    $('h-price').textContent = '--'; $('h-chg').textContent = ''
    $('h-badge').textContent = '实时'; $('h-badge').className = 'qd-badge real'
    // 实时缓存：sessionStorage 内 30s 内不重复打腾讯接口
    const cacheKey = `qk-stock:${code}`
    const cached = (() => { try { const s = sessionStorage.getItem(cacheKey); if (!s) return null; const o = JSON.parse(s); return Date.now() - o.at < 30000 ? o.data : null } catch { return null } })()
    try {
      let q: Quote
      if (cached) q = cached
      else {
        q = await fetchJSON(`/api/stock?code=${code}`) as Quote
        try { sessionStorage.setItem(cacheKey, JSON.stringify({ at: Date.now(), data: q })) } catch {}
      }
      payload = toPayload(q)
    } catch (e: any) {
      payload = null
      chart?.dispose(); chart = null
      $('kchart').innerHTML = `<div class='qd-loading'>${code} 实时行情获取失败 —— ${e?.message || '请检查代码或稍后重试'}<br/>（接口 /api/stock 代理腾讯行情，需可出网）</div>`
      return
    }
    state.period = 'd'; state.range = 250; state.ma = [...MA_DEF.d]
    document.querySelectorAll('#seg-period button').forEach((b) => b.classList.toggle('on', (b as HTMLElement).dataset.p === 'd'))
    document.querySelectorAll('#seg-range button').forEach((b) => b.classList.toggle('on', (b as HTMLElement).dataset.r === '250'))
    minuteCache = null
    renderHead(); renderSide(); render()
    const dt = payload.meta.price != null ? new Date().toLocaleString('zh-CN', { hour12: false }) : ''
    $('fn-l').textContent = `日线未复权 · 实时拉取 ${dt}`
  }

  /* ---------- 按需加载更深历史（3年 / 全部区间） ---------- */
  const DEEP_N = 1000
  let deepLoaded = false
  let deepLoading = false
  let deepCode = ''
  async function ensureDeepHistory() {
    if (deepLoading || !payload) return
    if (deepLoaded && deepCode === payload.code) return
    deepLoading = true
    const code = payload.code
    $('fn-r').innerHTML = `<span class="warn">正在加载更长历史…</span>`
    try {
      const j = await fetchJSON(`/api/stock-kline?code=${code}&n=${DEEP_N}`)
      const bars: Bar[] = (j.bars || []).filter((b: Bar) => Number.isFinite(b.c) && b.c > 0)
      if (bars.length > payload.kline.length) {
        payload = { ...payload, kline: bars }
        deepLoaded = true
        deepCode = code
      }
    } catch (e: any) {
      $('fn-r').innerHTML = `<span class="warn">⚠ 更长历史加载失败：${e?.message || '请稍后重试'}</span>`
    } finally {
      deepLoading = false
    }
  }

  /* ---------- 交互 ---------- */
  $('seg-period').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return
    state.period = (b as HTMLElement).dataset.p!
    state.ma = [...(MA_DEF[state.period] || [])]
    document.querySelectorAll('#seg-period button').forEach((x) => x.classList.toggle('on', x === b))
    render()
  })
  $('seg-range').addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return
    const r = +(b as HTMLElement).dataset.r!
    state.range = r
    document.querySelectorAll('#seg-range button').forEach((x) => x.classList.toggle('on', x === b))
    // 需要更长历史时按需拉取（默认 250 根 → 3年/全部 拉 1000 根）
    if (r === 0 || r > 250) await ensureDeepHistory()
    render()
  })
  $('ma-chips').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('.qchip'); if (!b) return
    const d = +(b as HTMLElement).dataset.ma!
    state.ma = state.ma.includes(d) ? state.ma.filter((x) => x !== d) : [...state.ma, d]
    render()
  })
  document.addEventListener('dash:select', (e) => {
    const code = (e as CustomEvent).detail?.code
    if (code && code !== state.code) select(code)
  })

  /* ---------- 键盘快捷键：1-6 切周期、←/→ 切股票、/ 聚焦搜索 ---------- */
  const PERIOD_KEYS = ['min1', 'min5', 'd', 'w', 'm', 'y']
  function isTyping(e: KeyboardEvent): boolean {
    const t = e.target as HTMLElement | null
    return !!t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)
  }
  document.addEventListener('keydown', (e) => {
    if (isTyping(e) || e.metaKey || e.ctrlKey || e.altKey) return
    // 数字键 1-6 切周期
    const idx = Number(e.key) - 1
    if (Number.isInteger(idx) && idx >= 0 && idx < PERIOD_KEYS.length) {
      const p = PERIOD_KEYS[idx]
      state.period = p
      state.ma = [...(MA_DEF[p] || [])]
      document.querySelectorAll('#seg-period button').forEach((x) => x.classList.toggle('on', (x as HTMLElement).dataset.p === p))
      render()
      e.preventDefault()
      return
    }
    // 左右方向键在自选之间切换
    if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
      const codes = (window as any).__qkWatchlist?.get?.() as string[] | undefined
      if (!codes?.length) return
      const i = codes.indexOf(state.code)
      const n = e.key === 'ArrowRight' ? (i + 1) % codes.length : (i - 1 + codes.length) % codes.length
      const next = codes[n]
      if (next && next !== state.code) {
        ;(window as any).__qkActive = next
        document.dispatchEvent(new CustomEvent('dash:select', { detail: { code: next } }))
      }
      e.preventDefault()
      return
    }
    // 斜杠聚焦搜索框
    if (e.key === '/') {
      const inp = document.getElementById('qk-search-input') as HTMLInputElement | null
      if (inp) { inp.focus(); e.preventDefault() }
    }
  })

  new MutationObserver(() => render()).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] })

  // 快捷键提示条：可隐藏并记忆
  const keysEl = document.querySelector('.qd-keys') as HTMLElement | null
  const keysToggle = document.getElementById('qk-keys-toggle') as HTMLButtonElement | null
  const KEYS_LS = 'qk-hide-keys'
  try { if (localStorage.getItem(KEYS_LS) === '1' && keysEl) keysEl.hidden = true } catch {}
  keysToggle?.addEventListener('click', () => {
    if (!keysEl) return
    keysEl.hidden = !keysEl.hidden
    try { localStorage.setItem(KEYS_LS, keysEl.hidden ? '1' : '0') } catch {}
  })

  select(state.code)
</script>

<script is:inline>
  // 看门狗：若打包后的 ChartPanel 模块未能执行（如 Vite optimize-deps 504），
  // 不把界面永久停在“加载 K线…”，12 秒后给出可操作的提示。
  setTimeout(function () {
    var el = document.getElementById('kchart')
    if (el && el.querySelector('.qd-loading')) {
      el.innerHTML = '<div class="qd-loading">K线脚本未能启动（图表模块加载失败）。<br/>本地开发时请重启 dev server；若仍失败，删除 <code>node_modules/.vite</code> 缓存后刷新。</div>'
    }
  }, 12000)
</script>

<style is:global>
  .qd-card { background: hsl(var(--card)); border: 1px solid hsl(var(--border)); border-radius: 12px; }
  .qd-panel { padding: 14px 16px 10px; min-width: 0; }
  .qd-phead { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; padding: 0 2px 12px; }
  .qd-phead .nm { font-size: 16px; font-weight: 700; color: hsl(var(--foreground)); }
  .qd-pico { color: var(--qk-gold); flex: none; align-self: center; }
  .qd-phead .cd { font-size: 12px; color: hsl(var(--muted-foreground)); }
  .qd-phead .bigpx { font-size: 30px; font-weight: 600; line-height: 1; }
  .qd-phead .bigchg { font-size: 14px; font-weight: 600; }
  .qd-pdate { margin-left: auto; font-size: 12px; color: color-mix(in srgb, hsl(var(--muted-foreground)) 42%, hsl(var(--foreground))); }
  .qd-badge { font-size: 12px; line-height: 1; padding: 3px 7px; border-radius: 5px; font-weight: 500; }
  .qd-badge.real { background: color-mix(in srgb, var(--qk-down) 14%, transparent); color: color-mix(in srgb, var(--qk-down) 62%, hsl(var(--foreground))); }
  .qd-badge.demo { background: color-mix(in srgb, var(--qk-gold) 16%, transparent); color: color-mix(in srgb, var(--qk-gold) 62%, hsl(var(--foreground))); }
  .qd-toolbar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 2px 2px 10px; border-bottom: 1px solid hsl(var(--border)); }
  .seg { display: inline-flex; background: hsl(var(--muted)); border-radius: 8px; padding: 3px; gap: 2px; }
  .seg button { border: none; background: transparent; color: color-mix(in srgb, hsl(var(--muted-foreground)) 42%, hsl(var(--foreground))); font-size: 12px; padding: 5px 12px; border-radius: 6px; cursor: pointer; transition: color .15s; }
  .seg button:hover { color: hsl(var(--foreground)); }
  .seg button.on { background: hsl(var(--card)); color: hsl(var(--foreground)); font-weight: 600; box-shadow: 0 1px 2px rgba(0, 0, 0, .25); }
  .qchip { display: inline-flex; align-items: center; gap: 5px; border: 1px solid hsl(var(--border)); border-radius: 6px; background: transparent; color: color-mix(in srgb, hsl(var(--muted-foreground)) 42%, hsl(var(--foreground))); font-size: 12px; padding: 4px 9px; cursor: pointer; margin-right: 5px; transition: background .15s; }
  .qchip:hover { background: hsl(var(--muted)); }
  .qchip.on { border-color: currentColor; }
  .qchip i { width: 11px; height: 2.5px; border-radius: 2px; display: inline-block; }
  .qd-range { margin-left: auto; }
  #kchart { width: 100%; height: clamp(420px, 58vh, 640px); }
  .qd-loading { display: flex; align-items: center; justify-content: center; height: 100%; min-height: 200px; font-size: 14px; color: hsl(var(--muted-foreground)); text-align: center; line-height: 2; padding: 0 20px; }
  .qd-loading code { background: hsl(var(--muted)); padding: 2px 6px; border-radius: 4px; font-size: 12px; }
  .qd-pfoot { display: flex; justify-content: space-between; font-size: 12px; color: color-mix(in srgb, hsl(var(--muted-foreground)) 42%, hsl(var(--foreground))); padding-top: 8px; gap: 12px; }
  .qd-pfoot .warn { color: var(--qk-gold); }
  .qd-pfoot span { white-space: nowrap; }
  .qd-pfoot span:first-child { overflow: hidden; text-overflow: ellipsis; }
  /* 快捷键提示条 */
  .qd-keys { display: flex; align-items: center; gap: 14px; margin-top: 6px; padding-top: 7px; border-top: 1px dashed hsl(var(--border)); font-size: 12px; color: color-mix(in srgb, hsl(var(--muted-foreground)) 42%, hsl(var(--foreground))); }
  .qd-keys[hidden] { display: none; }
  .qd-keys span { display: inline-flex; align-items: center; gap: 3px; white-space: nowrap; }
  .qd-keys kbd { display: inline-grid; place-items: center; min-width: 20px; height: 20px; padding: 0 4px; border: 1px solid hsl(var(--border)); border-bottom-width: 2px; border-radius: 4px; background: hsl(var(--muted)); color: hsl(var(--foreground)); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; line-height: 1; }
  .qd-keys-toggle { margin-left: auto; width: 24px; height: 24px; display: grid; place-items: center; border: none; background: transparent; color: color-mix(in srgb, hsl(var(--muted-foreground)) 42%, hsl(var(--foreground))); font-size: 14px; line-height: 1; border-radius: 6px; cursor: pointer; transition: background .15s, color .15s; }
  .qd-keys-toggle:hover { background: hsl(var(--muted)); color: hsl(var(--foreground)); }
  .up { color: var(--qk-up); } .down { color: var(--qk-down); } .flat { color: hsl(var(--muted-foreground)); }
  .num { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-variant-numeric: tabular-nums; }
  @media (max-width: 900px) { #kchart { height: 360px; } }
</style>
