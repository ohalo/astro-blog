---
/**
 * SidePanels —— ④右侧量化画像卡（实时版，零 Python / 零预生成）。
 * 首屏为占位，数据由 ChartPanel 客户端在切换/加载股票时按相同 id 实时写入
 * （数据源 /api/stock：价格/量能/波动率/52周为前端真实计算，PE/PB 实时，PE分位降级为"实时无"）。
 */
---

<div class='qd-side'>
  <div class='qd-card qd-side-card'>
    <h3>价格档案 <span class='qd-badge real'>实时</span></h3>
    <div class='qd-kv' id='ka-price'>
      <span class="k">—</span><span class="v num">加载中</span>
    </div>
    <div class='qd-verdict' id='ka-verdict'><span class='qd-vtag'>—</span></div>
  </div>

  <div class='qd-card qd-side-card'>
    <h3>52周位置 <span class='qd-badge real'>实时</span></h3>
    <div class='qd-posbar'><div class='dot' id='pos-dot' style='left:50%' /></div>
    <div class='qd-poslbl'>
      <span class='num' id='pos-lo'>低 --</span>
      <span class='num gold' id='pos-pct'>-- 分位</span>
      <span class='num' id='pos-hi'>高 --</span>
    </div>
  </div>

  <div class='qd-card qd-side-card'>
    <h3>量能 <span class='qd-badge real'>实时</span></h3>
    <div class='qd-kv' id='ka-vol'><span class="k">—</span><span class="v num">加载中</span></div>
  </div>

  <div class='qd-card qd-side-card'>
    <h3>波动率画像 <span class='qd-badge real'>实时</span></h3>
    <div class='qd-kv' id='ka-vola'><span class="k">—</span><span class="v num">加载中</span></div>
  </div>

  <div class='qd-card qd-side-card'>
    <h3>估值 <span class='qd-badge real'>实时</span></h3>
    <div class='qd-kv' id='ka-pe'><span class="k">—</span><span class="v num">加载中</span></div>
  </div>
</div>

<style is:global>
  .qd-side { display: flex; flex-direction: column; gap: 16px; }
  .qd-card { background: hsl(var(--card)); border: 1px solid hsl(var(--border)); border-radius: 12px; }
  .qd-side-card { padding: 14px 14px; }
  .qd-side-card h3 {
    font-size: 12px; font-weight: 600; color: color-mix(in srgb, hsl(var(--muted-foreground)) 42%, hsl(var(--foreground)));
    letter-spacing: .03em; margin: 0 0 9px;
  }
  .qd-badge { font-size: 12px; line-height: 1; padding: 3px 7px; border-radius: 5px; vertical-align: 1px; margin-left: 4px; font-weight: 500; }
  /* 徽章文字向 foreground 混合：深底提亮，保证 ≥4.5:1 */
  .qd-badge.real { background: color-mix(in srgb, var(--qk-down) 14%, transparent); color: color-mix(in srgb, var(--qk-down) 62%, hsl(var(--foreground))); }
  .qd-badge.demo { background: color-mix(in srgb, var(--qk-gold) 16%, transparent); color: color-mix(in srgb, var(--qk-gold) 62%, hsl(var(--foreground))); }
  .qd-kv { display: grid; grid-template-columns: 1fr auto; gap: 5px 10px; font-size: 12px; }
  .qd-kv :global(.k) { color: color-mix(in srgb, hsl(var(--muted-foreground)) 48%, hsl(var(--foreground))); }
  .qd-kv :global(.v) { text-align: right; font-weight: 500; color: hsl(var(--foreground)); }
  .qd-kv :global(.v.up), .qd-kv :global(.v.down), .up { color: var(--qk-up); }
  .qd-kv :global(.v.down) { color: var(--qk-down); }
  .qd-kv :global(.v.up) { color: var(--qk-up); }
  .qd-posbar {
    height: 6px; border-radius: 3px; position: relative; margin: 15px 4px 9px;
    background: linear-gradient(90deg, var(--qk-down), hsl(var(--muted-foreground)), var(--qk-up));
  }
  .qd-posbar .dot {
    position: absolute; top: 50%; width: 11px; height: 11px; border-radius: 50%;
    background: hsl(var(--card)); border: 2.5px solid var(--qk-gold); transform: translate(-50%, -50%);
    transition: left .25s ease;
  }
  .qd-poslbl { display: flex; justify-content: space-between; font-size: 12px; color: color-mix(in srgb, hsl(var(--muted-foreground)) 48%, hsl(var(--foreground))); }
  .qd-poslbl :global(.gold), .gold { color: var(--qk-gold); font-weight: 600; }
  .qd-verdict { display: flex; align-items: center; gap: 8px; margin-top: 10px; padding-top: 10px; border-top: 1px dashed hsl(var(--border)); }
  .qd-vtag { font-size: 12px; font-weight: 600; padding: 2px 8px; border-radius: 5px; background: hsl(var(--muted)); color: color-mix(in srgb, hsl(var(--muted-foreground)) 42%, hsl(var(--foreground))); }
  .qd-vtag.up { background: color-mix(in srgb, var(--qk-up) 16%, transparent); color: color-mix(in srgb, var(--qk-up) 62%, hsl(var(--foreground))); }
  .qd-vtag.down { background: color-mix(in srgb, var(--qk-down) 16%, transparent); color: color-mix(in srgb, var(--qk-down) 62%, hsl(var(--foreground))); }
  .qd-vsub { font-size: 12px; color: color-mix(in srgb, hsl(var(--muted-foreground)) 48%, hsl(var(--foreground))); }
  .num { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-variant-numeric: tabular-nums; }
  @media (max-width: 900px) {
    .qd-side { flex-direction: row; flex-wrap: wrap; }
    .qd-side-card { flex: 1 1 calc(50% - 6px); }
  }
</style>
