---
/**
 * /learn 量化学习路线图内容：路径卡片 + localStorage 学习进度
 * 中英共用，界面文案走 i18n 字典（d.learn.*），文章标题保持原文。
 */
import { getCollection } from 'astro:content'

import { learningPaths, readingMinutes } from '@/data/learning-paths'
import { dict, fill } from '@/i18n'
import type { Locale } from '@/i18n'

interface Props {
  locale?: Locale
}

const { locale = 'zh' } = Astro.props
const d = dict(locale)
const L = d.learn

const byId = new Map((await getCollection('blog')).map((p) => [p.id, p]))

const paths = learningPaths
  .map((path) => {
    const posts = path.posts
      .map((slug) => {
        const entry = byId.get(slug)
        if (!entry) {
          console.warn(`[learning-paths] 路径 ${path.id} 找不到文章：${slug}`)
          return null
        }
        return {
          slug,
          title: entry.data.title,
          difficulty: entry.data.difficulty,
          minutes: readingMinutes(entry.body)
        }
      })
      .filter((p): p is NonNullable<typeof p> => p !== null)
    return {
      ...path,
      name: locale === 'en' ? path.titleEn : path.title,
      desc: locale === 'en' ? path.blurbEn : path.blurb,
      posts
    }
  })
  .filter((p) => p.posts.length > 0)

const totalPosts = paths.reduce((n, p) => n + p.posts.length, 0)
const totalMinutes = paths.reduce((n, p) => n + p.posts.reduce((m, x) => m + x.minutes, 0), 0)
const totalDays = Math.max(1, Math.round(totalMinutes / 45))

// 今日复习卡的客户端文案（艾宾浩斯间隔见脚本 LADDER）
const reviewSafe = JSON.stringify({
  sub: L.reviewSub,
  meta: L.reviewMeta,
  btn: L.reviewBtn,
  more: L.reviewMore
}).replace(/</g, '\\u003c')
---

<p class='hg-learn-intro text-muted-foreground'>
  {fill(L.subtitle, {
    paths: paths.length,
    posts: totalPosts,
    minutes: totalMinutes.toLocaleString(),
    days: totalDays
  })}
</p>

{
  /* 今日复习：从已打勾的课里按遗忘曲线挑到期的（进度存本机，见脚本） */
  <section
    id='lp-review'
    class='lp-card lp-review mb-4 rounded-2xl border bg-background px-4 py-3 sm:mb-6 sm:px-6 sm:py-5'
    hidden
  >
    <header class='flex flex-wrap items-center gap-x-3 gap-y-2'>
      <h2>
        <span class='hg-path-no'>🔁</span>
        <span class='hg-path-name'>{L.reviewTitle}</span>
      </h2>
      <span class='lp-review-sub text-sm text-muted-foreground'></span>
    </header>
    <ul class='lp-review-list mt-3 flex list-none flex-col gap-1.5 p-0'></ul>
  </section>
}

<div class='mt-4 sm:mt-6 flex flex-col gap-4 sm:gap-6'>
  {paths.map((path, pi) => (
    <section
      id={path.id}
      class='lp-card rounded-2xl border bg-background px-4 py-3 sm:px-6 sm:py-5'
      data-path={path.id}
      data-all-done={L.allDone}
    >
      <header class='flex flex-wrap items-center gap-x-3 gap-y-2'>
        <h2>
          <span class='hg-path-no'>{String(pi + 1).padStart(2, '0')}</span>
          <span class='hg-path-name'>{path.name}</span>
        </h2>
        <span class='lp-count text-sm text-muted-foreground' aria-live='polite'></span>
        <div class='lp-bar-track order-last h-1.5 w-full overflow-hidden rounded-full sm:order-none sm:w-40'>
          <div class='lp-bar h-full w-0 rounded-full transition-[width] duration-300'></div>
        </div>
        <button
          type='button'
          class='lp-reset ml-auto cursor-pointer rounded-md px-2 py-0.5 text-xs text-muted-foreground opacity-60 transition hover:opacity-100'
          title={fill(L.resetTitle, { title: path.name })}
        >
          {L.reset}
        </button>
      </header>
      <p class='mt-1 text-sm text-muted-foreground'>{path.desc}</p>

      <ol class='mt-3 flex list-none flex-col gap-1.5 p-0'>
        {path.posts.map((post, i) => {
          const diffText = post.difficulty ? L[post.difficulty] : undefined
          return (
            <li
              class='lp-item group flex items-center gap-2.5 rounded-xl border border-transparent px-2.5 py-1.5 transition-colors hover:bg-muted sm:gap-3'
              data-slug={post.slug}
            >
              <button
                type='button'
                class='lp-check shrink-0 cursor-pointer rounded-full border transition'
                aria-label={fill(L.markDone, { title: post.title })}
                aria-pressed='false'
              >
                ✓
              </button>
              <span class='lp-no w-5 shrink-0 text-right text-xs text-muted-foreground tabular-nums'>
                {i + 1}
              </span>
              <a
                href={`/blog/${post.slug}`}
                class='lp-title min-w-0 flex-1 truncate text-sm leading-6 hover:text-primary sm:text-base'
                data-astro-prefetch
              >
                {post.title}
              </a>
              {diffText && (
                <span class='lp-badge hidden shrink-0 sm:inline'>
                  {diffText}
                </span>
              )}
              <span class='lp-min hidden shrink-0 text-xs text-muted-foreground sm:inline tabular-nums'>
                {fill(L.minutes, { n: post.minutes })}
              </span>
              <span class='lp-next hidden shrink-0 text-xs font-medium' aria-hidden='true'>
                {L.next}
              </span>
            </li>
          )
        })}
      </ol>
    </section>
  ))}
</div>

<script type='application/json' id='lp-review-i18n' is:inline set:html={reviewSafe}></script>

<style>
  .lp-bar-track {
    background: color-mix(in srgb, hsl(var(--muted)) 80%, transparent);
  }
  .lp-bar {
    background: hsl(var(--primary));
  }
  .lp-check {
    width: 1.35rem;
    height: 1.35rem;
    font-size: 0.7rem;
    line-height: 1;
    display: grid;
    place-items: center;
    color: transparent;
    border-color: color-mix(in srgb, hsl(var(--border)) 100%, transparent);
    background: transparent;
  }
  .lp-check:hover {
    border-color: hsl(var(--primary) / 0.6);
  }
  .lp-item[data-done='true'] .lp-check {
    color: hsl(var(--background));
    background: hsl(var(--primary));
    border-color: hsl(var(--primary));
  }
  .lp-item[data-done='true'] a {
    color: hsl(var(--muted-foreground) / 0.8);
  }
  .lp-badge {
    background: hsl(var(--muted));
    color: hsl(var(--muted-foreground));
  }
  .lp-next {
    color: hsl(var(--primary));
  }
  .lp-item[data-current='true'] {
    background: color-mix(in srgb, hsl(var(--primary)) 8%, transparent);
  }
  .lp-item[data-current='true'] .lp-next {
    display: inline;
  }
  .lp-reset:hover {
    background: hsl(var(--muted));
  }
</style>

<style is:global>
  /* 复习卡片段是脚本动态生成的，够不着 scoped 样式，这里走全局 */
  .lp-review {
    border-color: color-mix(in srgb, hsl(var(--primary)) 35%, hsl(var(--border)));
  }
  .lp-review .lp-review-item a {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.875rem;
    line-height: 1.5rem;
  }
  .lp-review .lp-review-item a:hover {
    color: hsl(var(--primary));
  }
  .lp-review-meta {
    flex-shrink: 0;
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }
  .lp-review-btn {
    flex-shrink: 0;
    cursor: pointer;
    border: 1px solid color-mix(in srgb, hsl(var(--primary)) 55%, transparent);
    background: transparent;
    color: hsl(var(--primary));
    border-radius: 0.5rem;
    padding: 0.15rem 0.65rem;
    font-size: 0.75rem;
    transition: background 0.18s ease;
  }
  .lp-review-btn:hover {
    background: color-mix(in srgb, hsl(var(--primary)) 12%, transparent);
  }
  .lp-review-more {
    font-size: 0.75rem;
    color: hsl(var(--muted-foreground));
    padding-left: 0.25rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .lp-review-btn {
      transition: none;
    }
  }
</style>

<script>
  /**
   * 学习进度 v2：
   * - 打勾值从 true 升级为 { doneAt, stage, lastAt }（旧 true 自动迁移，不丢进度）
   * - 「今日复习」按艾宾浩斯阶梯 LADDER 天，从已打勾的课里挑到期的，最多展示 3 篇
   */
  type Mark = { doneAt: number; stage: number; lastAt: number }
  type Bucket = Record<string, true | Mark>
  type Store = Record<string, Bucket>

  const KEY = 'hg-lear…s-v1'
  const LADDER = [1, 2, 4, 7, 15, 30, 60]
  const DAY = 86_400_000

  function load(): Store {
    try {
      return JSON.parse(localStorage.getItem(KEY) ?? '{}')
    } catch {
      return {}
    }
  }

  function save(data: Store) {
    try {
      localStorage.setItem(KEY, JSON.stringify(data))
    } catch {
      /* 隐私模式等场景静默失败 */
    }
  }

  const progress = load()

  // 旧格式 true → Mark（按“现在刚学完”起算，明天到期第一轮复习）
  {
    const now = Date.now()
    let touched = false
    for (const bucket of Object.values(progress)) {
      for (const [slug, v] of Object.entries(bucket)) {
        if (v === true) {
          bucket[slug] = { doneAt: now, stage: 0, lastAt: now }
          touched = true
        }
      }
    }
    if (touched) save(progress)
  }

  const isDone = (v: true | Mark | undefined): v is true | Mark => !!v

  function renderSection(section: HTMLElement) {
    const pathId = section.dataset.path as string
    const done = progress[pathId] ?? {}
    const items = Array.from(section.querySelectorAll<HTMLElement>('.lp-item'))
    const total = items.length
    let count = 0

    for (const item of items) {
      const isItemDone = isDone(done[item.dataset.slug as string])
      item.dataset.done = String(isItemDone)
      item.querySelector('.lp-check')?.setAttribute('aria-pressed', String(isItemDone))
      if (isItemDone) count++
    }

    // 第一条未完成的标 ▶（全部完成则不标）
    for (const item of items) delete item.dataset.current
    const next = items.find((it) => it.dataset.done !== 'true')
    if (next) next.setAttribute('data-current', 'true')

    const countEl = section.querySelector('.lp-count')
    if (countEl) {
      countEl.textContent =
        count === total && total > 0
          ? (section.dataset.allDone ?? '')
              .replace('{done}', String(count))
              .replace('{total}', String(total))
          : `${count}/${total}`
    }

    const bar = section.querySelector<HTMLElement>('.lp-bar')
    if (bar) bar.style.width = total ? `${Math.round((count / total) * 100)}%` : '0%'
  }

  // ───────────────── 今日复习 ─────────────────
  const reviewSec = document.getElementById('lp-review')
  const reviewUl = reviewSec?.querySelector<HTMLElement>('.lp-review-list')
  const reviewSub = reviewSec?.querySelector<HTMLElement>('.lp-review-sub')
  let rt = { sub: '', meta: '', btn: '', more: '' }
  try {
    const raw = JSON.parse(document.getElementById('lp-review-i18n')?.textContent || 'null')
    if (raw) rt = { ...rt, ...raw }
  } catch {
    /* 文案缺失时复习卡不渲染文本 */
  }
  const esc = (s: string) =>
    String(s).replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] || c
    )

  function slugTitles(): Map<string, string> {
    const m = new Map<string, string>()
    for (const item of document.querySelectorAll<HTMLElement>('section.lp-card .lp-item')) {
      const slug = item.dataset.slug
      if (!slug || m.has(slug)) continue
      m.set(slug, item.querySelector('.lp-title')?.textContent?.trim() || slug)
    }
    return m
  }

  function dueItems(now: number) {
    // 同一篇可能出现在多条路径：取最紧迫（lastAt 最早）的一份标记
    const bySlug = new Map<string, { slug: string; mark: Mark }>()
    for (const bucket of Object.values(progress)) {
      for (const [slug, v] of Object.entries(bucket)) {
        if (typeof v !== 'object' || v === null) continue
        const mark = v as Mark
        if (mark.stage >= LADDER.length) continue // 已出师
        const dueAt = mark.lastAt + LADDER[mark.stage] * DAY
        if (now < dueAt) continue
        const prev = bySlug.get(slug)
        if (!prev || mark.lastAt < prev.mark.lastAt) bySlug.set(slug, { slug, mark })
      }
    }
    return Array.from(bySlug.values()).sort((a, b) => a.mark.lastAt - b.mark.lastAt)
  }

  function renderReview() {
    if (!reviewSec || !reviewUl) return
    const now = Date.now()
    const due = dueItems(now)
    if (!due.length || !rt.sub) {
      reviewSec.hidden = true
      reviewUl.innerHTML = ''
      return
    }
    const titles = slugTitles()
    if (reviewSub) reviewSub.textContent = rt.sub.replace('{n}', String(due.length))
    reviewUl.innerHTML = due
      .slice(0, 3)
      .map(({ slug, mark }) => {
        const days = Math.max(0, Math.round((now - mark.lastAt) / DAY))
        const meta = rt.meta
          .replace('{d}', String(days))
          .replace('{s}', String(mark.stage + 1))
          .replace('{S}', String(LADDER.length))
        return `<li class="lp-review-item lp-item flex items-center gap-2.5 rounded-xl border border-transparent px-2.5 py-1.5">
            <a href="/blog/${esc(slug)}" data-astro-prefetch>${esc(titles.get(slug) || slug)}</a>
            <span class="lp-review-meta">${esc(meta)}</span>
            <button type="button" class="lp-review-btn" data-slug="${esc(slug)}">${esc(rt.btn)}</button>
          </li>`
      })
      .join('')
    if (due.length > 3) {
      const li = document.createElement('li')
      li.className = 'lp-review-more'
      li.textContent = rt.more.replace('{n}', String(due.length - 3))
      reviewUl.appendChild(li)
    }
    reviewSec.hidden = false
  }

  reviewUl?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.lp-review-btn')
    if (!btn) return
    const slug = btn.dataset.slug as string
    const now = Date.now()
    for (const bucket of Object.values(progress)) {
      const v = bucket[slug]
      if (typeof v === 'object' && v !== null) {
        v.stage += 1
        v.lastAt = now
      }
    }
    save(progress)
    renderReview()
  })

  for (const section of document.querySelectorAll<HTMLElement>('section.lp-card')) {
    renderSection(section)

    section.addEventListener('click', (e) => {
      const target = e.target as HTMLElement
      const sec = target.closest('section.lp-card')
      if (!sec) return
      const pathId = sec.dataset.path as string

      if (target.closest('.lp-reset')) {
        delete progress[pathId]
        save(progress)
        renderSection(sec)
        renderReview()
        return
      }

      const check = target.closest('.lp-check')
      if (check) {
        const item = check.closest<HTMLElement>('.lp-item')
        if (!item) return
        const slug = item.dataset.slug as string
        const bucket = (progress[pathId] ??= {})
        if (bucket[slug]) delete bucket[slug]
        else {
          const now = Date.now()
          bucket[slug] = { doneAt: now, stage: 0, lastAt: now }
        }
        save(progress)
        renderSection(sec)
        renderReview()
      }
    })
  }

  renderReview()
</script>
