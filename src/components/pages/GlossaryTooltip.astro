---
/**
 * 术语悬浮卡：扫描文章正文，把量化术语表（src/data/glossary.ts）里
 * 全文第一次出现的写法包成可悬停/可聚焦的词，弹出黑金定义卡。
 * - 代码块、链接、标题、KaTeX 公式内不生效
 * - 中英页面分别显示 zh / en 释义
 * - 无命中时零 DOM、零样式输出（脚本仍很小，且只在文章页打包）
 */
import { glossaryTerms } from '@/data/glossary'

const jsonSafe = JSON.stringify(glossaryTerms).replace(/</g, '\\u003c')
---

<script type='application/json' id='hg-glossary-data' is:inline set:html={jsonSafe}></script>

<style is:global>
  .hg-gloss {
    border-bottom: 1.5px dashed rgba(217, 184, 113, 0.55);
    cursor: help;
    text-underline-offset: 3px;
  }
  .hg-gloss:hover,
  .hg-gloss:focus-visible {
    color: #d9b871;
    outline: none;
  }
  .hg-gloss-card {
    position: fixed;
    z-index: 1200;
    max-width: min(360px, calc(100vw - 24px));
    background: #1b1812;
    border: 1px solid #4a4232;
    border-radius: 10px;
    padding: 12px 14px 13px;
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5);
    color: #e8e3d6;
    font-size: 13.5px;
    line-height: 1.7;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.16s ease,
      transform 0.16s ease;
    pointer-events: none;
  }
  .hg-gloss-card[data-open='true'] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .hg-gloss-card b {
    display: block;
    color: #d9b871;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: 5px;
  }
  .hg-gloss-card em {
    display: block;
    margin-top: 7px;
    font-style: normal;
    font-size: 11.5px;
    color: #8e8a80;
  }
  @media (prefers-reduced-motion: reduce) {
    .hg-gloss-card {
      transition: none;
    }
  }
</style>

<script>
  type Term = { id: string; terms: string[]; zh: string; en: string }

  const SKIP_SELECTOR =
    'code,pre,a,script,style,button,h1,h2,h3,h4,h5,h6,.katex,.katex-display,table,.hg-gloss'

  function escRe(s: string) {
    return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
  }
  const isWordChar = (ch: string | undefined) => !!ch && /[A-Za-z0-9_]/.test(ch)

  function init() {
    const root = document.getElementById('content')
    const dataEl = document.getElementById('hg-glossary-data')
    if (!root || !dataEl) return

    let terms: Term[] = []
    try {
      terms = JSON.parse(dataEl.textContent || '[]')
    } catch {
      return
    }
    if (!terms.length) return

    const en = location.pathname === '/en' || location.pathname.startsWith('/en/')
    const byId = new Map(terms.map((t) => [t.id, t]))

    // 别名 → 术语 id；长别名优先，避免「凯利公式」被「凯利」截胡
    const aliasList: { alias: string; id: string }[] = []
    for (const t of terms) for (const alias of t.terms) aliasList.push({ alias, id: t.id })
    aliasList.sort((a, b) => b.alias.length - a.alias.length)
    const regex = new RegExp(aliasList.map((a) => escRe(a.alias)).join('|'), 'gi')
    const aliasToId = new Map(aliasList.map((a) => [a.alias.toLowerCase(), a.id]))

    // 1) 扫描正文文本节点，按文档顺序为每个术语找第一次出现
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT)
    const seen = new Set<string>()
    const jobs: { node: Text; hits: { start: number; end: number; text: string; id: string }[] }[] =
      []

    let node: Text | null
    while ((node = walker.nextNode() as Text | null)) {
      const parent = node.parentElement
      if (!parent || parent.closest(SKIP_SELECTOR)) continue
      const text = node.data
      if (!text.trim()) continue
      regex.lastIndex = 0
      let m: RegExpExecArray | null
      const hits: { start: number; end: number; text: string; id: string }[] = []
      while ((m = regex.exec(text))) {
        const matched = m[0]
        const start = m.index
        const end = start + matched.length
        const id = aliasToId.get(matched.toLowerCase())
        if (!id || seen.has(id)) continue
        // 拉丁词边界：前后不能再接字母数字（防「value」误中「ALM」之类）
        const head = matched[0] ?? ''
        const tail = matched[matched.length - 1] ?? ''
        if (/[A-Za-z0-9]/.test(head) && isWordChar(text[start - 1])) continue
        if (/[A-Za-z0-9]/.test(tail) && isWordChar(text[end])) continue
        seen.add(id)
        hits.push({ start, end, text: matched, id })
      }
      if (hits.length) jobs.push({ node, hits })
    }

    // 2) 包裹：同一文本节点内从后往前处理。
    //    surroundContents 后原文本节点保留 start 之前的文本，
    //    因此先包靠后的命中，靠前命中的索引依然有效。
    for (const job of jobs) {
      for (const hit of [...job.hits].sort((a, b) => b.start - a.start)) {
        const range = document.createRange()
        range.setStart(job.node, hit.start)
        range.setEnd(job.node, hit.end)
        const span = document.createElement('span')
        span.className = 'hg-gloss'
        span.tabIndex = 0
        span.dataset.gid = hit.id
        span.textContent = hit.text
        range.surroundContents(span)
      }
    }
    if (!seen.size) return

    // 3) 单例定义卡 + 交互
    const card = document.createElement('div')
    card.className = 'hg-gloss-card'
    card.id = 'hg-gloss-card'
    card.setAttribute('role', 'tooltip')
    card.dataset.open = 'false'
    document.body.appendChild(card)

    let current: HTMLElement | null = null

    const position = () => {
      if (!current) return
      const r = current.getBoundingClientRect()
      const cw = card.offsetWidth
      const ch = card.offsetHeight
      const vw = document.documentElement.clientWidth
      const vh = document.documentElement.clientHeight
      let left = r.left + r.width / 2 - cw / 2
      left = Math.max(12, Math.min(left, vw - cw - 12))
      let top = r.bottom + 10
      if (top + ch > vh - 12) top = Math.max(12, r.top - ch - 10)
      card.style.left = `${left}px`
      card.style.top = `${top}px`
    }

    const open = (el: HTMLElement) => {
      const term = byId.get(el.dataset.gid || '')
      if (!term) return
      if (current === el) return
      // 定义卡是单例：换术语时先把旧术语的 aria-describedby 摘掉，避免读屏读到过期定义
      current?.removeAttribute('aria-describedby')
      current = el
      card.innerHTML = ''
      const b = document.createElement('b')
      b.textContent = el.textContent || term.terms[0]
      const p = document.createElement('span')
      p.textContent = en ? term.en : term.zh
      card.append(b, p)
      card.dataset.open = 'true'
      // 键盘 focusin 会弹卡，但读屏不会自动念 tooltip，必须显式关联
      el.setAttribute('aria-describedby', card.id)
      position()
    }

    const close = () => {
      current?.removeAttribute('aria-describedby')
      current = null
      card.dataset.open = 'false'
    }

    let hideTimer = 0
    root.addEventListener('pointerover', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('.hg-gloss')
      if (!el) return
      clearTimeout(hideTimer)
      open(el)
    })
    root.addEventListener('pointerout', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('.hg-gloss')
      if (!el) return
      hideTimer = window.setTimeout(close, 250)
    })
    card.addEventListener('pointerover', () => clearTimeout(hideTimer))
    card.addEventListener('pointerout', () => {
      hideTimer = window.setTimeout(close, 150)
    })

    // 键盘：Enter 展开 / Esc 收起；触屏：点击展开，点别处收起
    root.addEventListener('focusin', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('.hg-gloss')
      if (el) open(el)
    })
    root.addEventListener('focusout', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('.hg-gloss')
      if (el) hideTimer = window.setTimeout(close, 200)
    })
    root.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('.hg-gloss')
      if (!el) return
      e.preventDefault()
      e.stopPropagation()
      if (current === el) close()
      else open(el)
    })
    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement
      if (!t.closest('.hg-gloss') && !t.closest('.hg-gloss-card')) close()
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close()
    })

    // 定义卡贴着元素走：滚动/缩放时跟随
    let raf = 0
    const follow = () => {
      cancelAnimationFrame(raf)
      raf = requestAnimationFrame(() => {
        if (current && !document.body.contains(current)) return close()
        if (card.dataset.open === 'true') position()
      })
    }
    window.addEventListener('scroll', follow, { passive: true })
    window.addEventListener('resize', follow)
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init)
  } else {
    init()
  }
</script>
