---
/**
 * 量化专栏（黑金重构）
 * 从 1165 篇平铺项目符号改为检索式目录：搜索 + 难度切换 + 主题筛选 + 分页。
 * 所有条目、计数、主题分布均由 blog 集合的 frontmatter 实时计算。
 */
import type { CollectionEntry } from 'astro:content'

import { getCollection } from 'astro:content'
import { sortMDByDate } from 'astro-pure/server'

import { dict, localePath } from '@/i18n'
import type { Locale } from '@/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const en = locale === 'en'
const d = dict(locale)
const t = (zh: string, enText: string) => (en ? enText : zh)
const PER_PAGE = 15

const allPosts = await getCollection('blog')
const isQuant = (post: CollectionEntry<'blog'>) =>
  post.data.tags.some((tag) =>
    ['量化', 'quant', '交易', '投资'].some((k) => tag.toLowerCase().includes(k))
  )
const quantPosts = sortMDByDate(allPosts.filter(isQuant))

const levelLabel: Record<string, string> = {
  beginner: t('入门', 'Beginner'),
  intermediate: t('进阶', 'Intermediate'),
  advanced: t('高阶', 'Advanced'),
  none: t('未分级', 'Unleveled')
}

// 主题：按真实 tag / 标题关键词归类，计数为实际命中篇数
const topics = [
  { zh: '因子研究', en: 'Factor research', keys: ['因子', 'factor', 'alpha'] },
  {
    zh: '统计套利',
    en: 'Statistical arbitrage',
    keys: ['套利', 'arbitrage', '协整', 'cointegration', 'pairs']
  },
  {
    zh: '市场微观结构',
    en: 'Market microstructure',
    keys: ['微观', 'microstructure', '订单', 'orderbook', '限价', '高频', 'hawkes']
  },
  {
    zh: '期权定价',
    en: 'Option pricing',
    keys: ['期权', 'option', '定价', 'pricing', 'bsm', 'heston']
  },
  {
    zh: '机器学习选股',
    en: 'ML stock selection',
    keys: ['机器学习', 'machine', 'neural', '神经网络', '深度学习', '选股', 'xgboost']
  },
  { zh: '回测框架', en: 'Backtesting', keys: ['回测', 'backtest', '框架'] },
  { zh: '风险管理', en: 'Risk management', keys: ['风险', 'risk', '回撤', 'drawdown', 'var'] },
  {
    zh: '时间序列',
    en: 'Time series',
    keys: ['时间序列', 'time series', 'arima', 'garch', '波动率', 'volatility']
  },
  {
    zh: '组合优化',
    en: 'Portfolio optimization',
    keys: ['组合', 'portfolio', '优化', 'optimization', 'kelly', '凯利']
  },
  {
    zh: '随机过程',
    en: 'Stochastic processes',
    keys: ['随机', 'stochastic', '泊松', 'poisson', '布朗', 'brownian', '鞅']
  },
  {
    zh: '数值方法',
    en: 'Numerical methods',
    keys: ['数值', 'numerical', '蒙特卡洛', 'monte', '傅里叶', 'fourier', 'fft']
  }
].map((topic) => ({
  ...topic,
  name: en ? topic.en : topic.zh,
  count: 0
}))

// 匹配顺序按「主题特异性」排：先用期权/微观结构/机器学习等具体主题，
// 泛化的「因子」放到最后兜底，避免绝大多数文章被同一个主题吞掉。
const matchOrder = [3, 2, 4, 9, 10, 7, 8, 1, 6, 5, 0]
const matchTopic = (post: CollectionEntry<'blog'>) => {
  const hay = `${post.data.title} ${post.data.tags.join(' ')}`.toLowerCase()
  for (const idx of matchOrder) {
    const topic = topics[idx]
    if (topic?.keys.some((k) => hay.includes(k.toLowerCase()))) return topic
  }
  return null
}
quantPosts.forEach((p) => {
  const topic = matchTopic(p)
  if (topic) topic.count += 1
})
const activeTopics = topics.filter((topic) => topic.count > 0)
const shownTopics = activeTopics.slice(0, 6)
const restTopics = activeTopics.slice(6)

const fmtDate = (value: Date | string) => {
  const dt = new Date(value)
  return `${dt.getFullYear()}.${String(dt.getMonth() + 1).padStart(2, '0')}.${String(dt.getDate()).padStart(2, '0')}`
}
const clip = (text: string, n: number) => (text.length > n ? `${text.slice(0, n)}…` : text)

const items = quantPosts.map((p) => ({
  t: p.data.title,
  d: clip(p.data.description || '', 140),
  u: `/blog/${p.id}`,
  date: fmtDate(p.data.publishDate),
  level: p.data.difficulty || 'none',
  topic: matchTopic(p)?.name || t('其他主题', 'Other'),
  tags: p.data.tags.join(' ')
}))
const jsonSafe = JSON.stringify(items).replace(/</g, '\\u003c')

const counts = {
  all: quantPosts.length,
  beginner: quantPosts.filter((p) => p.data.difficulty === 'beginner').length,
  intermediate: quantPosts.filter((p) => p.data.difficulty === 'intermediate').length,
  advanced: quantPosts.filter((p) => p.data.difficulty === 'advanced').length
}
const pageCount = Math.max(1, Math.ceil(counts.all / PER_PAGE))
const firstPage = items.slice(0, PER_PAGE)
---

<main>
  <!-- ============================ 页头 ============================ -->
  <section class='hg-colhero'>
    <div class='hg-shell'>
      <div class='hg-crumb'>
        <a href={localePath(locale, '/')}>{d.nav.home}</a>
        <i>/</i>
        <b>{d.quant.title}</b>
      </div>
      <div class='hg-colhero__row'>
        <div class='hg-colhero__left'>
          <span class='hg-eyebrow'>COLUMN &nbsp;/&nbsp; QUANTITATIVE RESEARCH</span>
          <h1 class='hg-colhero__title'>{d.quant.title}</h1>
          <p class='hg-colhero__desc'>
            {t(
              `系统化的量化投资学习路径。${quantPosts.length.toLocaleString('en-US')} 篇文章按入门 / 进阶 / 高阶三级分类，覆盖股票基础、回测框架、因子研究、统计套利、高频微观结构与机器学习选股。`,
              `A systematic quant learning path. ${quantPosts.length.toLocaleString('en-US')} notes across three tiers, covering market basics, backtesting, factors, statistical arbitrage, microstructure and ML selection.`
            )}
          </p>
        </div>
        <div class='hg-colhero__stats'>
          <span class='hg-colhero__num'>{quantPosts.length.toLocaleString('en-US')}</span>
          <span>{t(`篇研究笔记 / 三级分类`, `notes / three tiers`)}</span>
          <i></i>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ 工具条 ============================ -->
  <div class='hg-toolbar'>
    <div class='hg-shell'>
      <label class='hg-search' for='hg-search-input'>
        <svg viewBox='0 0 16 16' fill='none' aria-hidden='true'>
          <circle cx='7' cy='7' r='4.8' stroke='#6e6a62' stroke-width='1.4'></circle>
          <path d='M10.8 10.8L14 14' stroke='#6e6a62' stroke-width='1.4' stroke-linecap='round'
          ></path>
        </svg>
        <input
          id='hg-search-input'
          type='search'
          placeholder={t('搜索标题、主题或方法…', 'Search titles, topics or methods…')}
          autocomplete='off'
        />
      </label>

      <div class='hg-tabs' id='hg-tabs' role='tablist'>
        <button class='hg-tab hg-tab--active' data-level='all' type='button'>
          {t('全部', 'All')} &nbsp;{counts.all.toLocaleString('en-US')}
        </button>
        <button class='hg-tab' data-level='beginner' type='button'>
          {t('入门', 'Beginner')} &nbsp;{counts.beginner}
        </button>
        <button class='hg-tab' data-level='intermediate' type='button'>
          {t('进阶', 'Intermediate')} &nbsp;{counts.intermediate}
        </button>
        <button class='hg-tab' data-level='advanced' type='button'>
          {t('高阶', 'Advanced')} &nbsp;{counts.advanced}
        </button>
      </div>

      <div class='hg-toolbar__spacer'></div>

      <div class='hg-toolbar__right'>
        <span class='hg-toolbar__count' id='hg-toolbar-count'>
          {counts.all.toLocaleString('en-US')} {t('篇', 'notes')}
        </span>
        <span class='hg-toolbar__divider'></span>
        <span class='hg-viewtoggle' aria-hidden='true'>
          <svg viewBox='0 0 16 16' fill='none'>
            <path
              d='M2 4H14M2 8H14M2 12H14'
              stroke='#d9b871'
              stroke-width='1.5'
              stroke-linecap='round'></path>
          </svg>
          <svg viewBox='0 0 16 16' fill='none'>
            <rect x='2' y='2' width='5' height='5' rx='1' stroke='#6e6a62' stroke-width='1.3'
            ></rect>
            <rect x='9' y='2' width='5' height='5' rx='1' stroke='#6e6a62' stroke-width='1.3'
            ></rect>
            <rect x='2' y='9' width='5' height='5' rx='1' stroke='#6e6a62' stroke-width='1.3'
            ></rect>
            <rect x='9' y='9' width='5' height='5' rx='1' stroke='#6e6a62' stroke-width='1.3'
            ></rect>
          </svg>
        </span>
        <span class='hg-toolbar__sort'>{t('最新优先', 'Newest first')}</span>
      </div>
    </div>
  </div>

  <!-- ============================ 主体 ============================ -->
  <div class='hg-shell hg-colbody'>
    <aside class='hg-filter'>
      <span class='hg-filter__title'>FILTER / {t('筛选', 'Filter')}</span>
      <div class='hg-filter__line'></div>

      <div class='hg-filter__group' id='hg-filter-levels'>
        <span class='hg-filter__grouptitle'>{t('难度', 'LEVEL')}</span>
        <button class='hg-filter__item hg-filter__item--active' data-level='all' type='button'>
          <span>{t('全部文章', 'All notes')}</span><em>{counts.all.toLocaleString('en-US')}</em>
        </button>
        <button class='hg-filter__item' data-level='beginner' type='button'>
          <span>{t('入门', 'Beginner')}</span><em>{counts.beginner}</em>
        </button>
        <button class='hg-filter__item' data-level='intermediate' type='button'>
          <span>{t('进阶', 'Intermediate')}</span><em>{counts.intermediate}</em>
        </button>
        <button class='hg-filter__item' data-level='advanced' type='button'>
          <span>{t('高阶', 'Advanced')}</span><em>{counts.advanced}</em>
        </button>
      </div>
      <div class='hg-filter__divider'></div>

      <div class='hg-filter__group' id='hg-filter-topics'>
        <span class='hg-filter__grouptitle'>{t('主题', 'TOPIC')}</span>
        <button class='hg-filter__item hg-filter__item--active' data-topic='all' type='button'>
          <span>{t('全部主题', 'All topics')}</span><em>{counts.all.toLocaleString('en-US')}</em>
        </button>
        {
          shownTopics.map((topic) => (
            <button class='hg-filter__item' data-topic={topic.name} type='button'>
              <span>{topic.name}</span>
              <em>{topic.count}</em>
            </button>
          ))
        }
        <span id='hg-topic-rest' hidden>
          {
            restTopics.map((topic) => (
              <button class='hg-filter__item' data-topic={topic.name} type='button'>
                <span>{topic.name}</span>
                <em>{topic.count}</em>
              </button>
            ))
          }
        </span>
        {
          restTopics.length > 0 && (
            <button class='hg-filter__item' id='hg-topic-more' type='button' style='color:#d9b871'>
              + {t(`展开全部 ${activeTopics.length} 个主题`, `Show all ${activeTopics.length} topics`)}
            </button>
          )
        }
      </div>

      <div class='hg-filter__tip'>
        <p class='hg-filter__tiptitle'>{t('阅读顺序建议', 'Suggested reading order')}</p>
        <p class='hg-filter__tipdesc'>
          {t(
            '每篇标注难度与前置知识，建议按 入门 → 进阶 → 高阶 顺序阅读。',
            'Each note is tagged by difficulty. Beginner → Intermediate → Advanced is the recommended order.'
          )}
        </p>
      </div>
    </aside>

    <div class='hg-collist'>
      <div class='hg-collist__head'>
        <span id='hg-result-text'>
          {t(`共 ${quantPosts.length.toLocaleString('en-US')} 篇 · 按发布日期倒序`, `${quantPosts.length.toLocaleString('en-US')} notes · newest first`)}
        </span>
        <b>{t('最新优先', 'Newest first')}</b>
      </div>

      <div id='hg-entries'>
        {
          firstPage.map((item) => (
            <article class='hg-entry'>
              <div class='hg-entry__meta'>
                <span class='hg-badge'>{levelLabel[item.level]}</span>
                <span class='hg-entry__date'>{item.date}</span>
                <span class='hg-entry__topic'>{item.topic}</span>
              </div>
              <h2 class='hg-entry__title'>
                <a href={item.u}>{item.t}</a>
              </h2>
              <p class='hg-entry__desc'>{item.d}</p>
            </article>
          ))
        }
      </div>

      <div class='hg-pager' id='hg-pager'>
        <button type='button' disabled>←</button>
        <button type='button' class='hg-pager__active'>1</button>
        {
          pageCount > 1 && <button type='button'>2</button>
        }
        {
          pageCount > 2 && <button type='button'>3</button>
        }
        {
          pageCount > 4 && <span class='hg-pager__dots'>…</span>
        }
        {
          pageCount > 3 && <button type='button'>{pageCount}</button>
        }
        <button type='button'>{t('下一页', 'Next')} →</button>
      </div>
    </div>
  </div>

  <script
    type='application/json'
    id='hg-quant-data'
    is:inline
    set:html={jsonSafe}
  ></script>

  <noscript>
    <p style='padding:0 6rem 3rem;color:#8e8a80;font-size:13px'>
      {t('启用 JavaScript 后可使用搜索、筛选与分页；当前显示最新 15 篇。', 'Enable JavaScript for search, filters and pagination. Showing the latest 15 notes.')}
    </p>
  </noscript>
</main>

<script>
  const PER = 15
  const dataEl = document.getElementById('hg-quant-data')
  const entriesEl = document.getElementById('hg-entries')
  const pagerEl = document.getElementById('hg-pager')
  const resultEl = document.getElementById('hg-result-text')
  const countEl = document.getElementById('hg-toolbar-count')
  const searchEl = document.getElementById('hg-search-input') as HTMLInputElement | null

  const labels: Record<string, string> = {
    beginner: '入门',
    intermediate: '进阶',
    advanced: '高阶',
    none: '未分级'
  }
  const noteWord = '篇'

  type Item = { t: string; d: string; u: string; date: string; level: string; topic: string; tags: string }
  let items: Item[] = []
  try {
    items = JSON.parse(dataEl?.textContent || '[]') as Item[]
  } catch {
    items = []
  }

  const state = { q: '', level: 'all', topic: 'all', page: 1 }
  const esc = (s: string) =>
    String(s).replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] || c
    )

  function filtered(): Item[] {
    const q = state.q.trim().toLowerCase()
    return items.filter((it) => {
      if (state.level !== 'all' && it.level !== state.level) return false
      if (state.topic !== 'all' && it.topic !== state.topic) return false
      if (q && !`${it.t} ${it.d} ${it.tags} ${it.topic}`.toLowerCase().includes(q)) return false
      return true
    })
  }

  function render() {
    if (!entriesEl || !pagerEl) return
    const list = filtered()
    const pages = Math.max(1, Math.ceil(list.length / PER))
    if (state.page > pages) state.page = pages
    const start = (state.page - 1) * PER
    const pageItems = list.slice(start, start + PER)

    entriesEl.innerHTML = pageItems.length
      ? pageItems
          .map(
            (it) => `<article class="hg-entry">
              <div class="hg-entry__meta">
                <span class="hg-badge">${esc(labels[it.level] || it.level)}</span>
                <span class="hg-entry__date">${esc(it.date)}</span>
                <span class="hg-entry__topic">${esc(it.topic)}</span>
              </div>
              <h2 class="hg-entry__title"><a href="${esc(it.u)}">${esc(it.t)}</a></h2>
              <p class="hg-entry__desc">${esc(it.d)}</p>
            </article>`
          )
          .join('')
      : '<p class="hg-empty">没有匹配的文章，换个关键词试试。</p>'

    const nums: (number | string)[] = []
    for (let p = 1; p <= pages; p++) {
      if (p === 1 || p === pages || Math.abs(p - state.page) <= 1) nums.push(p)
      else if (nums[nums.length - 1] !== '…') nums.push('…')
    }
    const numsHtml = nums
      .map((n) =>
        n === '…'
          ? '<span class="hg-pager__dots">…</span>'
          : `<button type="button" data-page="${n}" class="${n === state.page ? 'hg-pager__active' : ''}">${n}</button>`
      )
      .join('')
    pagerEl.innerHTML =
      `<button type="button" data-step="prev" ${state.page === 1 ? 'disabled' : ''}>←</button>` +
      numsHtml +
      `<button type="button" data-step="next" class="hg-pager__label" ${state.page === pages ? 'disabled' : ''}>下一页 →</button>`

    if (resultEl) {
      resultEl.textContent = `共 ${list.length.toLocaleString('en-US')} ${noteWord} · 按发布日期倒序`
    }
    if (countEl) countEl.textContent = `${list.length.toLocaleString('en-US')} ${noteWord}`
  }

  function syncActive(selector: string, attr: string, value: string) {
    document.querySelectorAll<HTMLElement>(selector).forEach((btn) => {
      btn.classList.toggle(
        btn.classList.contains('hg-tab') ? 'hg-tab--active' : 'hg-filter__item--active',
        btn.dataset[attr] === value
      )
    })
  }

  document.querySelectorAll<HTMLElement>('#hg-tabs .hg-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      state.level = btn.dataset.level || 'all'
      state.page = 1
      syncActive('#hg-tabs .hg-tab', 'level', state.level)
      syncActive('#hg-filter-levels .hg-filter__item', 'level', state.level)
      render()
    })
  })

  document.querySelectorAll<HTMLElement>('#hg-filter-levels .hg-filter__item').forEach((btn) => {
    btn.addEventListener('click', () => {
      state.level = btn.dataset.level || 'all'
      state.page = 1
      syncActive('#hg-tabs .hg-tab', 'level', state.level)
      syncActive('#hg-filter-levels .hg-filter__item', 'level', state.level)
      render()
    })
  })

  document.querySelectorAll<HTMLElement>('#hg-filter-topics .hg-filter__item[data-topic]').forEach((btn) => {
    btn.addEventListener('click', () => {
      state.topic = btn.dataset.topic || 'all'
      state.page = 1
      syncActive('#hg-filter-topics .hg-filter__item[data-topic]', 'topic', state.topic)
      render()
    })
  })

  const moreBtn = document.getElementById('hg-topic-more')
  const restEl = document.getElementById('hg-topic-rest')
  moreBtn?.addEventListener('click', () => {
    if (restEl) restEl.hidden = false
    moreBtn.remove()
  })

  searchEl?.addEventListener('input', () => {
    state.q = searchEl.value
    state.page = 1
    render()
  })

  pagerEl?.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest('button') as HTMLButtonElement | null
    if (!btn || btn.disabled) return
    if (btn.dataset.step === 'prev') state.page -= 1
    else if (btn.dataset.step === 'next') state.page += 1
    else if (btn.dataset.page) state.page = Number(btn.dataset.page)
    else return
    render()
    document.querySelector('.hg-toolbar')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
  })

  render()
</script>
