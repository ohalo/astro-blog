---
/**
 * 网址导航页内容（中文 / 英文共用）
 */
import {
  stockLinkCategories,
  stockLinkCategoriesEn,
  stockLinkStats,
  stockLinkStatsEn
} from '@/data/stock-links'
import { dict, fill } from '@/i18n'
import type { Locale } from '@/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const d = dict(locale)

const categories = locale === 'en' ? stockLinkCategoriesEn : stockLinkCategories
const statsData = locale === 'en' ? stockLinkStatsEn : stockLinkStats

const headings = categories.map((c) => ({
  depth: 2,
  slug: c.id,
  text: `${c.emoji} ${c.name}`
}))

const allLinks = categories.flatMap((c) => c.links)
const freeCount = allLinks.filter((l) => l.badge?.includes('免费') || l.badge?.includes('开源')).length
const gatedCount = allLinks.filter((l) => l.badge && /开户|付费|申请|积分|注册/.test(l.badge)).length

const stats = [
  { label: d.links.stats.total, value: statsData.total },
  { label: d.links.stats.categories, value: statsData.categories },
  { label: d.links.stats.free, value: freeCount },
  { label: d.links.stats.gated, value: gatedCount }
]

/** 从 URL 提取展示用域名 */
const hostOf = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '')
  } catch {
    return url
  }
}
---

<p class='text-muted-foreground'>
  {fill(d.links.intro, {
    total: statsData.total,
    unique: statsData.unique,
    cats: statsData.categories
  })}
</p>

<dl class='not-prose my-6 grid grid-cols-2 gap-3 sm:grid-cols-4'>
  {
    stats.map((s) => (
      <div class='rounded-2xl border bg-muted px-4 py-3'>
        <dt class='text-sm text-muted-foreground'>{s.label}</dt>
        <dd class='mt-0.5 text-2xl font-medium text-primary'>{s.value}</dd>
      </div>
    ))
  }
</dl>

<div class='not-prose mb-5 flex flex-wrap gap-2'>
  {
    categories.map((c) => (
      <a
        href={`#${c.id}`}
        class='inline-flex items-center gap-1.5 rounded-xl border bg-muted px-2.5 py-1 text-sm text-muted-foreground no-underline transition-colors hover:bg-card hover:text-primary'
      >
        <span>{c.emoji}</span>
        <span>{c.name}</span>
        <span class='text-xs opacity-70'>{c.links.length}</span>
      </a>
    ))
  }
</div>

<div class='not-prose mb-8'>
  <input
    id='link-search'
    type='search'
    placeholder={d.links.searchPlaceholder}
    autocomplete='off'
    class='w-full rounded-xl border bg-muted px-4 py-2.5 text-sm text-foreground outline-none transition-colors placeholder:text-muted-foreground focus:border-primary'
  />
  <p id='link-match-count' class='mt-1.5 text-xs text-muted-foreground'></p>
</div>

{
  categories.map((cat) => (
    <section class='mt-10 first:mt-8' id={`section-${cat.id}`} data-link-section>
      <h2 id={cat.id} class='flex items-center gap-2'>
        {cat.emoji} {cat.name}
        <span class='rounded-lg bg-muted px-2 py-0.5 text-sm font-normal text-muted-foreground'>
          {cat.links.length}
        </span>
      </h2>
      <p class='text-muted-foreground'>{cat.desc}</p>
      <div class='not-prose mt-4 grid gap-2.5 sm:grid-cols-2 lg:grid-cols-3'>
        {cat.links.map((l) => (
          <a
            href={l.url}
            target='_blank'
            rel='noopener noreferrer'
            data-link-card
            data-name={`${l.name} ${l.desc} ${hostOf(l.url)}`}
            class='group flex flex-col gap-0.5 rounded-2xl border bg-background px-4 py-3 no-underline transition-colors hover:bg-muted'
          >
            <div class='flex items-center justify-between gap-2'>
              <span class='font-medium text-foreground transition-colors group-hover:text-primary'>
                {l.name}
              </span>
              {l.badge && (
                <span class='shrink-0 rounded-md border bg-muted px-1.5 py-0.5 text-xs text-muted-foreground'>
                  {l.badge}
                </span>
              )}
            </div>
            <span class='truncate text-xs text-muted-foreground/70'>{hostOf(l.url)}</span>
            <span class='text-sm text-muted-foreground'>{l.desc}</span>
          </a>
        ))}
      </div>
    </section>
  ))
}

<p id='link-empty' class='hidden py-8 text-center text-muted-foreground'>
  {d.links.empty}
</p>

<script define:vars={{ countTemplate: d.links.matchCount }}>
  const input = document.getElementById('link-search') as HTMLInputElement | null
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-link-card]'))
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-link-section]'))
  const countEl = document.getElementById('link-match-count')
  const emptyEl = document.getElementById('link-empty')

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase()
    let visible = 0

    for (const card of cards) {
      const name = (card.dataset.name ?? '').toLowerCase()
      const hit = !q || name.includes(q)
      card.classList.toggle('hidden', !hit)
      if (hit) visible++
    }

    for (const section of sections) {
      const any = section.querySelectorAll('[data-link-card]:not(.hidden)').length > 0
      section.classList.toggle('hidden', !any)
    }

    if (countEl) countEl.textContent = q ? countTemplate.replace('{count}', String(visible)) : ''
    emptyEl?.classList.toggle('hidden', visible > 0)
  })
</script>
