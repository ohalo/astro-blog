---
/**
 * 黑金重构 Header
 * 顶部数据条 + 品牌锁组合 + 主导航 + 搜索/语言/主题/订阅。
 * 保留 header-component 自定义元素与其滚动、主题、菜单交互逻辑。
 */
import { getLocale, localePath, switchLocalePath, LOCALE_FULL, dict } from '@/i18n'
import { canSwitchLocale, getTranslatedPostIds } from '@/i18n/availability'
import type { Locale } from '@/i18n'
import config from '@/site-config'

interface Props {
  locale?: Locale
  pathname?: string
}

const { locale = getLocale(Astro.url.pathname), pathname = Astro.url.pathname } = Astro.props

const d = dict(locale)
const menu = [
  { title: d.nav.home, link: localePath(locale, '/') },
  { title: d.nav.quant, link: localePath(locale, '/quant-column') },
  { title: d.nav.blog, link: localePath(locale, '/blog') },
  { title: d.nav.learn, link: localePath(locale, '/learn') },
  { title: d.nav.links, link: localePath(locale, '/stock-links') },
  { title: d.nav.dash, link: localePath(locale, '/dash') },
  { title: d.nav.about, link: localePath(locale, '/about') }
]

const switcher = switchLocalePath(pathname)
// 只在目标语言确实有对应页时给可点链接；否则渲染禁用态，避免 404 / meta refresh 原地回弹
const switchable = canSwitchLocale(pathname, await getTranslatedPostIds())
const switchLabel = locale === 'en' ? 'Switch to Chinese' : 'Switch to English'
const homeLink = localePath(locale, '/')
const isCurrent = (link: string) => {
  const path = link.replace(/\/$/, '') || '/'
  return pathname === path || pathname.startsWith(`${path}/`) && path !== '/'
}
---

<header-component class='hg-header'>
  <div class='hg-ticker'>
    <div class='hg-shell hg-ticker__inner'>
      <div class='hg-ticker__left'>
        <i class='hg-dot'></i>
        <span class='hg-ticker__brand'>HALO / QUANT RESEARCH</span>
        <span class='hg-ticker__muted'>EST. 2019 &nbsp;·&nbsp; {d.common.location}</span>
      </div>
      <div class='hg-ticker__right'>
        <span class='hg-ticker__muted'>QUANT RESEARCH JOURNAL</span>
        <span class='hg-ticker__muted'>
          <a href='/rss.xml' style='color:inherit;text-decoration:none'>RSS &nbsp;↗</a>
        </span>
      </div>
    </div>
  </div>

  <div class='hg-navband'>
    <div class='hg-shell hg-nav'>
      <a class='hg-brand' href={homeLink} aria-label='Brand'>
        <span class='hg-brand__mark'>H</span>
        <span class='hg-brand__texts'>
          <span class='hg-brand__name'>{config.title}</span>
          <span class='hg-brand__sub'>QUANT RESEARCH JOURNAL</span>
        </span>
      </a>

      <nav class='hg-navlinks' id='headerExpandContent' aria-label='Main navigation'>
        {
          menu.map((item) => (
            <a
              href={item.link}
              class:list={['hg-navlink', isCurrent(item.link) && 'hg-navlink--active']}
              data-astro-prefetch
            >
              {item.title}
            </a>
          ))
        }
      </nav>

      <div class='hg-navactions'>
        <a
          class='hg-iconbtn'
          href={localePath(locale, '/search')}
          title={d.common.search}
          aria-label={d.common.search}
        >
          <svg viewBox='0 0 18 18' fill='none' aria-hidden='true'>
            <circle cx='8' cy='8' r='5.5' stroke='currentColor' stroke-width='1.5'></circle>
            <path
              d='M12.2 12.2L16 16'
              stroke='currentColor'
              stroke-width='1.5'
              stroke-linecap='round'></path>
          </svg>
        </a>

        {
          switchable ? (
            <a
              id='switchLocale'
              class='hg-langbtn'
              href={switcher.path}
              hreflang={switcher.locale}
              aria-label={switchLabel}
              title={switchLabel}
              data-astro-prefetch
            >
              {LOCALE_FULL[switcher.locale]}
            </a>
          ) : (
            <span
              class='hg-langbtn hg-langbtn--disabled'
              aria-disabled='true'
              title={locale === 'en' ? 'Chinese version only' : '暂无英文版'}
            >
              {LOCALE_FULL[switcher.locale]}
            </span>
          )
        }

        <button
          id='toggleDarkMode'
          class='hg-iconbtn'
          aria-label={d.common.darkMode}
          title={d.common.darkMode}
        >
          <svg class='hg-theme-system' viewBox='0 0 18 18' fill='none' aria-hidden='true'>
            <rect x='2' y='3' width='14' height='10' rx='1.5' stroke='currentColor' stroke-width='1.4'
            ></rect>
            <path d='M6 16H12M9 13V16' stroke='currentColor' stroke-width='1.4'></path>
          </svg>
          <svg class='hg-theme-light' viewBox='0 0 18 18' fill='none' aria-hidden='true'>
            <circle cx='9' cy='9' r='3.5' stroke='currentColor' stroke-width='1.4'></circle>
            <path
              d='M9 1.5V3M9 15V16.5M1.5 9H3M15 9H16.5M3.7 3.7L4.8 4.8M13.2 13.2L14.3 14.3M14.3 3.7L13.2 4.8M4.8 13.2L3.7 14.3'
              stroke='currentColor'
              stroke-width='1.4'
              stroke-linecap='round'></path>
          </svg>
          <svg class='hg-theme-dark' viewBox='0 0 18 18' fill='none' aria-hidden='true'>
            <path
              d='M15 11.2A6.5 6.5 0 0 1 6.8 3a6.5 6.5 0 1 0 8.2 8.2Z'
              stroke='currentColor'
              stroke-width='1.4'
              stroke-linejoin='round'></path>
          </svg>
        </button>

        <button
          id='toggleMenu'
          class='hg-iconbtn hg-menu-toggle'
          aria-label={d.common.menu}
          title={d.common.menu}
        >
          <svg viewBox='0 0 18 18' fill='none' aria-hidden='true'>
            <path
              d='M2 5H16M2 9H16M2 13H16'
              stroke='currentColor'
              stroke-width='1.5'
              stroke-linecap='round'></path>
          </svg>
        </button>

        <a class='hg-subbtn' href='/rss.xml'>
          {locale === 'en' ? 'Subscribe' : '订阅更新'}
        </a>
      </div>
    </div>
  </div>
</header-component>

{/* Use inline to load theme state quicker */}
<script is:inline>
  const toggleDarkModeElement = document.getElementById('toggleDarkMode')
  if (toggleDarkModeElement) {
    toggleDarkModeElement.dataset.theme = localStorage.getItem('theme') || 'system'
  }
</script>
<script>
  import { setTheme, showToast } from 'astro-pure/utils'

  class HeaderComponent extends HTMLElement {
    connectedCallback() {
      this.classList.toggle('not-top', window.scrollY > 20)
      window.addEventListener('scroll', () => {
        this.classList.toggle('not-top', window.scrollY > 20)
      })

      const darkModeBtn = this.querySelector('#toggleDarkMode') as HTMLElement | null
      darkModeBtn?.addEventListener('click', () => {
        const newTheme = setTheme(undefined, true)
        darkModeBtn.dataset.theme = newTheme
        showToast({ message: `已切换主题到 ${newTheme}` })
      })

      this.querySelector('#toggleMenu')?.addEventListener('click', () => {
        this.classList.toggle('expanded')
      })
    }
  }

  customElements.define('header-component', HeaderComponent)
</script>

<style>
  .hg-theme-light,
  .hg-theme-dark {
    display: none;
  }
  #toggleDarkMode[data-theme='dark'] .hg-theme-system,
  #toggleDarkMode[data-theme='light'] .hg-theme-system {
    display: none;
  }
  #toggleDarkMode[data-theme='dark'] .hg-theme-dark,
  #toggleDarkMode[data-theme='light'] .hg-theme-light {
    display: block;
  }
  /* 菜单折叠规则统一放在 blackgold.css，避免 scoped 样式的打包顺序问题 */
</style>
