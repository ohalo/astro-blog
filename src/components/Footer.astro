---
/**
 * 自建 Footer：在 astro-pure 主题 Footer 基础上增加 i18n 支持
 */
import { Icon } from 'astro-pure/user'

import { dict, getLocale, localePath } from '@/i18n'
import type { Locale } from '@/i18n'
import config from '@/site-config'

interface Props {
  locale?: Locale
}

const { locale = getLocale(Astro.url.pathname) } = Astro.props
const d = dict(locale)

const social = config.footer.social || []
---

<footer class='mx-auto mb-5 mt-16 w-full'>
  <div class='border-t pt-5'>
    <div class='flex items-start gap-y-4 max-sm:flex-col sm:justify-between sm:gap-y-0'>
      <div class='flex flex-col gap-y-1.5 text-muted-foreground'>
        {/* 版权与政策链接 */}
        <div class='flex flex-wrap items-center gap-x-2 gap-y-1'>
          <span>{config.footer.year} {d.footer.siteName}</span>
          <span aria-hidden='true'>·</span>
          <span>{d.footer.rightsReserved}</span>
          <span aria-hidden='true'>·</span>
          <a href={localePath(locale, '/terms')}>{d.footer.sitePolicy}</a>
        </div>

        {/* 本站含股票与量化内容，需明确非投资建议 */}
        <p class='text-sm'>{d.footer.disclaimer}</p>

        {
          config.footer.credits && (
            <span class='text-sm'>
              <a href='https://github.com/withastro/astro' target='_blank'>
                Astro
              </a>
              {d.footer.themeBy}
              <a href='https://github.com/cworld1/astro-theme-pure' target='_blank'>
                Pure
              </a>
              {d.footer.drivenBy}
            </span>
          )
        }
      </div>

      {/* Social Brands */}
      <div class='flex items-center gap-x-4'>
        {
          social.map(({ label, href, icon }) => (
            <a {href} rel='me' class='sl-flex'>
              <span class='sr-only'>{label}</span>
              <Icon name={icon} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    color: hsl(var(--foreground) / var(--un-text-opacity, 1));
    text-decoration: underline;
    font-weight: 500;
  }
</style>
