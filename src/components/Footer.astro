---
/**
 * 黑金重构 Footer
 * 大字品牌收尾 + 三列导航 + 版权/免责声明。
 */
import { Icon } from 'astro-pure/user'

import { dict, getLocale, localePath } from '@/i18n'
import type { Locale } from '@/i18n'
import config from '@/site-config'

interface Props {
  locale?: Locale
}

const { locale = getLocale(Astro.url.pathname) } = Astro.props
const d = dict(locale)
const social = config.footer.social || []
---

<footer class='hg-footer'>
  <div class='hg-shell'>
    <div class='hg-footer__top'>
      <div class='hg-footer__brand'>
        <div class='hg-footer__word'>halo.</div>
        <div class='hg-footer__tagline'>
          {locale === 'en'
            ? 'Turning market noise into reproducible conclusions.'
            : '把市场的噪声，写成可复现的结论。'}
        </div>
      </div>

      <div class='hg-footer__cols'>
        <div class='hg-fcol'>
          <h3>{locale === 'en' ? 'NAVIGATION' : '导航'}</h3>
          <a href={localePath(locale, '/')}>{d.nav.home}</a>
          <a href={localePath(locale, '/quant-column')}>{d.nav.quant}</a>
          <a href={localePath(locale, '/blog')}>{d.nav.blog}</a>
          <a href={localePath(locale, '/about')}>{d.nav.about}</a>
        </div>
        <div class='hg-fcol'>
          <h3>{locale === 'en' ? 'RESOURCES' : '资源'}</h3>
          <a href={localePath(locale, '/archives')}>{locale === 'en' ? 'Archive' : '文章归档'}</a>
          <a href={localePath(locale, '/stock-links')}>{d.nav.links}</a>
          <a href={localePath(locale, '/learn')}>{d.nav.learn}</a>
          <a href={localePath(locale, '/terms')}>{d.footer.sitePolicy}</a>
        </div>
        <div class='hg-fcol'>
          <h3>{locale === 'en' ? 'INFO' : '信息'}</h3>
          <span>{d.common.location}</span>
          <span>EST. 2019</span>
          {
            social.map(({ label, href, icon }) => (
              <a {href} rel='me' aria-label={label}>
                <Icon name={icon} class='size-4' />
                &nbsp;{label}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class='hg-footer__line'></div>

    <div class='hg-footer__bottom'>
      <span>{config.footer.year} {d.footer.siteName} · {d.footer.rightsReserved}</span>
      <p class='hg-footer__disclaimer'>{d.footer.disclaimer}</p>
      <span>BUILT WITH ASTRO &nbsp;/&nbsp; VERCEL</span>
    </div>
  </div>
</footer>

<style>
  .hg-footer :global(a) {
    text-decoration: none;
  }
  .hg-fcol a {
    display: inline-flex;
    align-items: center;
    min-height: 20px;
  }
</style>
