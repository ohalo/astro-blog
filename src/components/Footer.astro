---
/**
 * 自建 Footer：在 astro-pure 主题 Footer 基础上增加 i18n 支持
 */
import { Icon } from 'astro-pure/user'

import { dict, getLocale, localePath } from '@/i18n'
import type { Locale } from '@/i18n'
import config from '@/site-config'

interface Props {
  locale?: Locale
}

const { locale = getLocale(Astro.url.pathname) } = Astro.props
const d = dict(locale)

const social = config.footer.social || []
const icp = config.footer.links?.find(({ pos }) => pos !== 2)
---

<footer class='mx-auto mb-5 mt-16 w-full'>
  <div class='border-t pt-5'>
    <div class='flex items-center gap-y-3 max-sm:flex-col sm:justify-between sm:gap-y-0'>
      <div class='flex items-center gap-x-4 gap-y-2 text-muted-foreground max-sm:flex-col'>
        {
          icp && (
            <div>
              <a href={icp.link} target='_blank' class={icp.style}>
                {icp.title}
              </a>
            </div>
          )
        }
        <div>
          {config.footer.year}
          {config.author}
          <span>
            <a href={localePath(locale, '/terms')} target='_blank' class='text-sm'>
              {d.footer.sitePolicy}
            </a>
          </span>
        </div>
        {
          config.footer.credits && (
            <span>
              <a href='https://github.com/withastro/astro' target='_blank'>
                Astro
              </a>
              {d.footer.themeBy}
              <a href='https://github.com/cworld1/astro-theme-pure' target='_blank'>
                Pure
              </a>
              {d.footer.drivenBy}
            </span>
          )
        }
      </div>

      {/* Social Brands */}
      <div class='flex items-center gap-x-4'>
        {
          social.map(({ label, href, icon }) => (
            <a {href} rel='me' class='sl-flex'>
              <span class='sr-only'>{label}</span>
              <Icon name={icon} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    color: hsl(var(--foreground) / var(--un-text-opacity, 1));
    text-decoration: underline;
    font-weight: 500;
  }
</style>
